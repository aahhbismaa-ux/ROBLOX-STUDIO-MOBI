<Item class="ModuleScript" referent="RBX6A5AB5395EC24443840DD01535C34F7E">
<Properties>
<BinaryString name="AttributesSerialize"></BinaryString>
<Content name="LinkedSource"><null></null></Content>
<string name="Name">PetRegistry</string>
<string name="ScriptGuid">{26CAB37F-80B5-4B07-BE72-6C2F597CDDB4}</string>
<ProtectedString name="Source"><![CDATA[-- ModuleScript: ServerScriptService > PetRegistry
--
-- Daftar Pet yang lagi ada di dunia, dipakai bareng oleh PetServer (spawn & jalan-jalan)
-- dan PetStealServer (steal / drop / antar ke SaveZone), supaya dua script itu tetap terpisah.

local Registry = {}

Registry.ByModel = {} -- [model] = info
Registry.Areas = {}   -- [nomor area] = area

-- Posisi Pet SEKARANG (dihitung dari attribute gerak, sama kayak yang dipakai client)
function Registry.CurrentPos(info)
    local m = info.Model
    local from = m:GetAttribute("MoveFrom")
    local to = m:GetAttribute("MoveTo")
    if not from or not to then return info.Pos end
    
    local dur = m:GetAttribute("MoveDur") or 0
    if dur <= 0 then return to end
    
    local start = m:GetAttribute("MoveStart") or 0
    local a = math.clamp((workspace:GetServerTimeNow() - start) / dur, 0, 1)
    if m:GetAttribute("Fall") then
        a = a * a
    end
    return from:Lerp(to, a)
end

-- Pet diangkat player: berhenti jalan-jalan
function Registry.SetCarried(info, player)
    local m = info.Model
    local pos = Registry.CurrentPos(info)
    
    info.Pos = pos
    info.Carrier = player
    info.State = "Carried"
    
    m:SetAttribute("Fall", nil)
    m:SetAttribute("MoveFrom", pos)
    m:SetAttribute("MoveTo", pos)
    m:SetAttribute("MoveDur", 0)
    m:SetAttribute("CarrierId", player.UserId)
end

-- Pet dijatuhkan: jatuh dari fromPos ke dropPos, lalu jalan/diam lagi kayak biasa.
-- Kalau jatuhnya di luar Part Spawn, dia jalan-jalan di sekitar titik jatuh (radius roamRadius).
function Registry.Drop(info, fromPos, dropPos, roamRadius)
    local m = info.Model
    local height = math.max(fromPos.Y - dropPos.Y, 0)
    local duration = math.max(0.15, math.sqrt(2 * height / 196.2))
    
    info.Carrier = nil
    info.Pos = dropPos
    info.State = "Fall"
    info.NextAt = os.clock() + duration
    
    local area = info.Area
    if area and area.IsInside and area.IsInside(dropPos) then
        info.Home = nil
    else
        info.Home = { Center = dropPos, Radius = roamRadius }
    end
    
    m:SetAttribute("Fall", true)
    m:SetAttribute("MoveFrom", fromPos)
    m:SetAttribute("MoveTo", dropPos)
    m:SetAttribute("MoveDur", duration)
    m:SetAttribute("MoveStart", workspace:GetServerTimeNow())
    m:SetAttribute("CarrierId", nil)
end

-- Pet hilang dari dunia (misal sudah jadi Tool). PetServer otomatis ngurus respawn-nya.
function Registry.Remove(info)
    info.Removed = true
    info.Model:Destroy()
end

----------------------------------------------------------------
-- ZONA JALAN-JALAN (permukaan atas sebuah Part, misal Part "Place" di Base)
-- Bentuknya sama kayak "area" di PetServer, jadi PetServer ikut ngatur Pet di zona ini.
----------------------------------------------------------------
local function surfaceOf(part)
    local cf, size = part.CFrame, part.Size
    local axes = {
    { cf.RightVector, size.X },
    { cf.UpVector, size.Y },
    { cf.LookVector, size.Z },
    }
    
    local vertical = 1
    for i = 2, 3 do
        if math.abs(axes[i][1].Y) > math.abs(axes[vertical][1].Y) then
            vertical = i
        end
    end
    
    local topY = part.Position.Y
    + (math.abs(axes[1][1].Y) * size.X + math.abs(axes[2][1].Y) * size.Y + math.abs(axes[3][1].Y) * size.Z) / 2
    
    local flat = {}
    for i = 1, 3 do
        if i ~= vertical then
            table.insert(flat, axes[i])
        end
    end
    
    local a = Vector3.new(flat[1][1].X, 0, flat[1][1].Z)
    local b = Vector3.new(flat[2][1].X, 0, flat[2][1].Z)
    a = a.Magnitude > 0 and a.Unit or Vector3.xAxis
    b = b.Magnitude > 0 and b.Unit or Vector3.zAxis
    
    return topY, a, flat[1][2] / 2, b, flat[2][2] / 2
end

function Registry.MakeZone(part)
    local topY, a, ha, b, hb = surfaceOf(part)
    local zone = {
    Spawn = part,
    TopY = topY,
    AxisA = a, HalfA = ha,
    AxisB = b, HalfB = hb,
    Active = {},
    Count = 0,
    NextSpawn = 0,
    NoSpawn = true, -- PetServer cuma ngatur gerak Pet di zona ini, gak nge-spawn
    }
    
    function zone.IsInside(p)
        local d = p - part.Position
        return math.abs(d:Dot(a)) <= ha and math.abs(d:Dot(b)) <= hb
    end
    
    return zone
end

function Registry.RandomPoint(zone, margin)
    local ha = math.max(zone.HalfA - margin, 0)
    local hb = math.max(zone.HalfB - margin, 0)
    local p = zone.Spawn.Position
    + zone.AxisA * ((math.random() * 2 - 1) * ha)
    + zone.AxisB * ((math.random() * 2 - 1) * hb)
    return Vector3.new(p.X, zone.TopY, p.Z)
end

-- Ukuran template Pet: Radius (horizontal), Height & MinY dari pivot (efek partikel gak dihitung)
local sizeCache = {}

function Registry.Measure(template)
    local cached = sizeCache[template.Name]
    if cached then return cached.Radius, cached.Height, cached.MinY end
    
    local pivot = template:GetPivot()
    local radius, height, minY = 1, 1, math.huge
    
    for _, d in ipairs(template:GetDescendants()) do
        if d:IsA("BasePart") and d.Name:sub(1, 7) ~= "Effect_" then
            local rel = pivot:ToObjectSpace(d.CFrame).Position
            radius = math.max(radius, math.abs(rel.X) + d.Size.X / 2, math.abs(rel.Z) + d.Size.Z / 2)
            height = math.max(height, rel.Y + d.Size.Y / 2)
            minY = math.min(minY, rel.Y - d.Size.Y / 2)
        end
    end
    
    if minY == math.huge then minY = 0 end
    
    sizeCache[template.Name] = { Radius = radius, Height = height, MinY = minY }
    return radius, height, minY
end

return Registry

]]></ProtectedString>
