RobuxProductId = 0,
},
{
Name = "Sapphire Pickaxe",
Rarity = "Rare",
Power = 650,
Cost = 90000,
RobuxPrice = 299,
RobuxProductId = 0,
},
 
-- EPIC
{
Name = "Amethyst Pickaxe",
Rarity = "Epic",
Power = 1000,
Cost = 200000,
RobuxPrice = 399,
RobuxProductId = 0,
},
{
Name = "Obsidian Pickaxe",
Rarity = "Epic",
Power = 1600,
Cost = 450000,
RobuxPrice = 499,
