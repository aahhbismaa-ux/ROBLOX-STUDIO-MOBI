<Item class="ModuleScript" referent="RBX6A5AB5395EC24443840DD04001C34F7E">
<Properties>
<BinaryString name="AttributesSerialize"></BinaryString>
<Content name="LinkedSource"><null></null></Content>
<string name="Name">PetConfig</string>
<string name="ScriptGuid">{26CAB37F-80B5-4B07-BE72-6C2F597CDDB4}</string>
<ProtectedString name="Source"><![CDATA[-- ModuleScript: ReplicatedStorage > Configuration > Modules > Area > Pet > PetConfig
--
-- Daftar Pet yang bisa spawn di tiap Area (nomor = nama Folder di Workspace > Map > System > Area).
--
-- Name   = HARUS sama dengan nama Model di ServerStorage > Configuration > Area > Pet
-- Rarity = nama di ReplicatedStorage > Configuration > Colors > Rarity
--          & harus ada di ChanceConfig
-- Income = tampil di PetGui: "C$50/s"
--
-- Pet yang Model-nya belum ada di ServerStorage otomatis dilewati (ada warning di Output).
 
local Config = {}
 
Config.Settings = {
RespawnDelay = 3,          -- detik sebelum pet pengganti muncul kalau ada yang hilang
SpawnInterval = 0.5,       -- jeda antar spawn (biar gak muncul sekaligus)
WalkSpeed = { 3, 5 },      -- studs/detik (acak per pet)
IdleTime = { 2, 6 },       -- lama diam (detik)
WalkChance = 0.7,          -- peluang jalan lagi setelah diam
MinWalk = 5,               -- jarak minimal sekali jalan (studs)
 
-- Pet aktif di Base
MaxActive = 8,             -- maksimal Pet yang bisa di-Place di Base ("1/8 Active")
 
-- Offline Earn
OfflineRate = 1,           -- 1 = sama kayak Income online (0.5 = setengahnya)
OfflineMaxDays = 7,        -- batas offline (lebih dari ini tetap dihitung segini)
OfflineMinSeconds = 60,    -- offline kurang dari ini gak dapat apa-apa
OfflinePassId = 2092938662, -- Game Pass "x2 Offline Earn"
 
-- Steal / Carry
StealDistance = 12,        -- jarak maksimal ProximityPrompt "Steal" (studs)
CarryHeight = 3.6,         -- tinggi kaki Pet di atas HumanoidRootPart pas diangkat
ArmsUpAngle = 170,         -- sudut tangan ke atas pas bawa Pet (derajat)
DropRoamRadius = 12,       -- Pet yang di-drop di luar Spawn jalan-jalan di radius ini
}
 
Config.Areas = {
[1] = {
{ Name = "White Bunny",   Rarity = "Common",    Income = 5 },
{ Name = "Brown Bunny",   Rarity = "Common",    Income = 6 },
{ Name = "Hamster",       Rarity = "Common",    Income = 4 },
{ Name = "Corgi",         Rarity = "Uncommon",  Income = 15 },
--{ Name = "Shiba Inu",     Rarity = "Uncommon",  Income = 18 },
--{ Name = "Panda",         Rarity = "Rare",      Income = 45 },
--{ Name = "Red Fox",       Rarity = "Rare",      Income = 50 },
--{ Name = "Unicorn",       Rarity = "Epic",      Income = 160 },
--{ Name = "Golden Dragon", Rarity = "Legendary", Income = 600 },
--{ Name = "Phoenix",       Rarity = "Mythic",    Income = 2500 },
},
--[2] = { ... },
}
 
return Config

]]></ProtectedString>
<UniqueId name="UniqueId">7bdf20b295fbe64d0689404002004383</UniqueId>
</Properties>
</Item>
</Item>
<Item class="Folder" referent="RBXC7F38F5F49694AFF826B4040032EF763">
<Properties>
<BinaryString name="AttributesSerialize"></BinaryString>
<string name="Name">Chance</string>
<UniqueId name="UniqueId">7bdf20b295fbe64d068940400400430e</UniqueId>
</Properties>
<Item class="ModuleScript" referent="RBX6A5AB5395EC24443840DD04005C34F7E">
<Properties>
<BinaryString name="AttributesSerialize"></BinaryString>
<Content name="LinkedSource"><null></null></Content>
<string name="Name">ChanceConfig</string>
<string name="ScriptGuid">{26CAB37F-80B5-4B07-BE72-6C2F597CDDB4}</string>
<ProtectedString name="Source"><![CDATA[-- ModuleScript: ReplicatedStorage > Configuration > Modules > Area > Chance > ChanceConfig
--
-- Peluang spawn per Rarity (dalam persen, total gak harus 100).
-- Kalau di sebuah Area gak ada pet dengan rarity tertentu, rarity itu dilewati
-- dan peluang sisanya dihitung ulang otomatis.

local Config = {}

Config.Chances = {
Common    = 70,
Uncommon  = 18,
Rare      = 8,
Epic      = 3,
Legendary = 0.9,
Mythic    = 0.1,
}

return Config

]]></ProtectedString>
