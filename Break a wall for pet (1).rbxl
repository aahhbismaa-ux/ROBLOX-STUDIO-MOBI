<Item class="ModuleScript" referent="RBX6A5AB5395EC24443840DD01547C34F7E">
<Properties>
<BinaryString name="AttributesSerialize"></BinaryString>
<Content name="LinkedSource"><null></null></Content>
<string name="Name">DataService</string>
<string name="ScriptGuid">{26CAB37F-80B5-4B07-BE72-6C2F597CDDB4}</string>
<ProtectedString name="Source"><![CDATA[-- ModuleScript: ServerScriptService > DataService
--
-- Satu-satunya tempat DataStore. Dipakai bareng oleh TreadmillServer & PickaxeServer,
-- tapi dua sistem itu tetap terpisah (masing-masing cuma punya "section" sendiri).
--
-- Yang disimpan: leaderstats Speed, leaderstats Sheckles, dan section tiap sistem
-- (Section "Treadmill", Section "Pickaxe").
 
local Players = game:GetService("Players")
local DataStoreService = game:GetService("DataStoreService")
 
local Store = DataStoreService:GetDataStore("PlayerData_v1")
 
local DataService = {}
DataService.Data = {} -- [player] = { LoadFailed = bool, Sections = {} }
 
local callbacks = {}
 
local function getLeaderstats(plr)
    local ls = plr:WaitForChild("leaderstats", 3)
    if not ls then
        ls = Instance.new("Folder")
        ls.Name = "leaderstats"
        ls.Parent = plr
    end
    return ls
end
 
local function ensureValue(ls, name, waitTime)
    local v = ls:FindFirstChild(name)
    if not v and waitTime then
        v = ls:WaitForChild(name, waitTime)
    end
    if not v then
        v = Instance.new("NumberValue")
        v.Name = name
        v.Parent = ls
    end
    return v
end
 
local function loadRaw(plr)
    local key = "Player_" .. plr.UserId
    for _ = 1, 3 do
        local ok, result = pcall(function()
            return Store:GetAsync(key)
        end)
        if ok then
            return true, result
        end
        task.wait(2)
    end
    return false, nil
end
 
----------------------------------------------------------------
-- API
----------------------------------------------------------------
 
-- Dipanggil tiap kali data player selesai ke-load (juga untuk yang sudah ke-load)
function DataService.OnLoaded(callback)
    table.insert(callbacks, callback)
    for plr in pairs(DataService.Data) do
        task.spawn(callback, plr)
    end
end
 
function DataService.IsLoaded(plr)
    return DataService.Data[plr] ~= nil
end
 
-- Ambil section milik 1 sistem (tabel yang sama dipakai terus & ikut ke-save)
function DataService.Section(plr, name)
    local d = DataService.Data[plr]
    if not d then return nil end
    if type(d.Sections[name]) ~= "table" then
        d.Sections[name] = {}
    end
    return d.Sections[name]
end
 
function DataService.Save(plr)
    local d = DataService.Data[plr]
    if not d or d.LoadFailed then return false end
    
    local ls = plr:FindFirstChild("leaderstats")
    local speed = ls and ls:FindFirstChild("Speed")
    local sheckles = ls and ls:FindFirstChild("Sheckles")
    
    local payload = {
    Speed = speed and speed.Value or 0,
    Sheckles = sheckles and sheckles.Value or 0,
    Sections = d.Sections,
    }
    
    for _ = 1, 3 do
        local ok = pcall(function()
            Store:SetAsync("Player_" .. plr.UserId, payload)
        end)
        if ok then return true end
        task.wait(2)
    end
    
    warn("Gagal save data " .. plr.Name)
    return false
end
 
----------------------------------------------------------------
-- PLAYER
----------------------------------------------------------------
local function onPlayerAdded(plr)
    local ls = getLeaderstats(plr)
    local speed = ensureValue(ls, "Speed", nil)
    local sheckles = ensureValue(ls, "Sheckles", 3) -- tunggu punyamu dulu biar gak dobel
    
    local ok, raw = loadRaw(plr)
    if not plr.Parent then return end
    
    local d = { LoadFailed = not ok, Sections = {} }
    
    if ok and type(raw) == "table" then
        if type(raw.Sections) == "table" then
            d.Sections = raw.Sections
        end
        speed.Value = tonumber(raw.Speed) or 0
        if raw.Sheckles ~= nil then
            sheckles.Value = tonumber(raw.Sheckles) or sheckles.Value
        end
    end
    
    DataService.Data[plr] = d
    
    for _, callback in ipairs(callbacks) do
        task.spawn(callback, plr)
    end
end
 
Players.PlayerAdded:Connect(onPlayerAdded)
for _, plr in ipairs(Players:GetPlayers()) do
    task.spawn(onPlayerAdded, plr)
end
 
Players.PlayerRemoving:Connect(function(plr)
    DataService.Save(plr)
    DataService.Data[plr] = nil
end)
 
game:BindToClose(function()
    local pending = 0
    for _, plr in ipairs(Players:GetPlayers()) do
        pending += 1
        task.spawn(function()
            DataService.Save(plr)
            pending -= 1
        end)
    end
    while pending > 0 do
        task.wait()
    end
end)
 
-- Autosave tiap 2 menit
task.spawn(function()
    while true do
        task.wait(120)
        for _, plr in ipairs(Players:GetPlayers()) do
            task.spawn(DataService.Save, plr)
        end
    end
end)
 
return DataService

]]></ProtectedString>
<UniqueId name="UniqueId">7bdf20b295fbe64d0689401548004383</UniqueId>
</Properties>
</Item>
<Item class="Script" referent="RBX66C1625455D04AC580D8101549513A7E">
<Properties>
<BinaryString name="AttributesSerialize"></BinaryString>
<bool name="Disabled">false</bool>
<Content name="LinkedSource"><null></null></Content>
<string name="Name">TreadmillServer</string>
<token name="RunContext">0</token>
<string name="ScriptGuid">{FF361BB9-5B67-4864-AADE-7E5A85E36A3E}</string>
<ProtectedString name="Source"><![CDATA[-- Script: ServerScriptService > TreadmillServer
-- Khusus sistem Treadmill (Pickaxe Shop ada di script sendiri: PickaxeServer)
-- Jalan berdampingan dengan script Base kamu (baca Bases.BaseX.Owner)

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerStorage = game:GetService("ServerStorage")
local ServerScriptService = game:GetService("ServerScriptService")

local DataService = require(ServerScriptService:WaitForChild("DataService"))

local Bases = workspace:WaitForChild("Bases")
local ConfigFolder = ReplicatedStorage:WaitForChild("Configuration")
local Modules = ConfigFolder:WaitForChild("Modules")
local NumberFormatModule = require(Modules:WaitForChild("NumberFormat"))
local Config = require(Modules:WaitForChild("Treadmill"):WaitForChild("TreadmillConfig"))
local LevelModels = ServerStorage:WaitForChild("Configuration"):WaitForChild("Base"):WaitForChild("Treadmill")

local function fmt(n)
    if type(NumberFormatModule) == "function" then
        return NumberFormatModule(n)
    elseif type(NumberFormatModule) == "table" and NumberFormatModule.Format then
        return NumberFormatModule.Format(n)
    end
    return tostring(n)
end

----------------------------------------------------------------
-- REMOTES
----------------------------------------------------------------
local Remotes = Instance.new("Folder")
Remotes.Name = "TreadmillRemotes"
Remotes.Parent = ConfigFolder

local UIEvent = Instance.new("RemoteEvent")
UIEvent.Name = "TreadmillUI" -- server -> client ("Start" / "Stop" / "Gain")
UIEvent.Parent = Remotes

local ActionEvent = Instance.new("RemoteEvent")
ActionEvent.Name = "TreadmillAction" -- client -> server (Purchase / Upgrade)
ActionEvent.Parent = Remotes

local StopEvent = Instance.new("RemoteEvent")
StopEvent.Name = "TreadmillStop" -- client -> server
StopEvent.Parent = Remotes

-- Tempat nyimpen Treadmill / TreadmillPurchase yang belum dipakai
local Stash = Instance.new("Folder")
Stash.Name = "TreadmillStash"
Stash.Parent = ReplicatedStorage

----------------------------------------------------------------
-- STATE
----------------------------------------------------------------
local state = {}     -- [player] = section "Treadmill" {Owned, Level}
local sessions = {}  -- [player] = sesi lari di treadmill
local lastStop = {}  -- [player] = os.clock()
local baseInfo = {}  -- [baseModel] = info

local maxLevel = #Config.Levels

----------------------------------------------------------------
-- HELPERS
----------------------------------------------------------------
local function getLeaderValue(plr, name)
    local ls = plr:FindFirstChild("leaderstats")
    return ls and ls:FindFirstChild(name)
end

local function applyWalkSpeed(plr)
    if sessions[plr] then return end
    
    local char = plr.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if not hum then return end
    
    local speedVal = getLeaderValue(plr, "Speed")
    local speed = speedVal and speedVal.Value or 0
    local ws = Config.WalkSpeed
    hum.WalkSpeed = math.min(ws.Base + speed * ws.Multiplier, ws.Max)
end

----------------------------------------------------------------
-- TREADMILL SESSION (lari)
----------------------------------------------------------------
local function stopTreadmill(plr, teleportOut)
    local session = sessions[plr]
    if not session then return end
    
    sessions[plr] = nil
    session.Active = false
    lastStop[plr] = os.clock()
    
    if session.DiedConn then
        session.DiedConn:Disconnect()
    end
    if session.Track then
        session.Track:Stop()
        session.Track:Destroy()
    end
    
    local char = plr.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    local root = char and char:FindFirstChild("HumanoidRootPart")
    
    if root then
        root.Anchored = false
    end
    if hum then
        hum.AutoRotate = true
        hum:SetStateEnabled(Enum.HumanoidStateType.Jumping, true)
        applyWalkSpeed(plr)
    end
    
    if teleportOut and char and root then
        local info = baseInfo[session.Base]
        local out = info and info.Treadmill:FindFirstChild("Out")
        if out and out:IsA("BasePart") then
            char:PivotTo(out.CFrame + Vector3.new(0, out.Size.Y / 2 + 3, 0))
        end
    end
    
    if plr.Parent then
        plr:SetAttribute("OnTreadmill", false)
        UIEvent:FireClient(plr, "Stop")
    end
end

local function startTreadmill(plr, base)
    if sessions[plr] then return end
    if os.clock() - (lastStop[plr] or 0) < Config.TouchCooldown then return end
    if plr:GetAttribute("CarryingPet") then return end
    
    local info = baseInfo[base]
    local st = state[plr]
    if not info or not st or not st.Owned or not info.Hitbox then return end
    
    local char = plr.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not hum or not root or hum.Health <= 0 then return end
    
    local session = { Base = base, Active = true }
    sessions[plr] = session
    
    hum.WalkSpeed = 0
    hum.AutoRotate = false
    hum:SetStateEnabled(Enum.HumanoidStateType.Jumping, false)
    
    -- Teleport ke tengah Hitbox, bagian paling bawah
    local hb = info.Hitbox
    local bottomY = hb.Position.Y - hb.Size.Y / 2
    local offset
    if hum.RigType == Enum.HumanoidRigType.R6 then
        offset = 3
    else
        offset = hum.HipHeight + root.Size.Y / 2
    end
    local pos = Vector3.new(hb.Position.X, bottomY + offset + 0.05, hb.Position.Z)
    -- Arah hadap = arah LookVector Hitbox (putar Hitbox kalau arahnya salah)
    char:PivotTo(CFrame.new(pos) * hb.CFrame.Rotation)
    root.AssemblyLinearVelocity = Vector3.zero
    root.Anchored = true
    
    -- Animasi jalan (R15 & R6)
    local animator = hum:FindFirstChildOfClass("Animator")
    if not animator then
        animator = Instance.new("Animator")
        animator.Parent = hum
    end
    local anim = Instance.new("Animation")
    if hum.RigType == Enum.HumanoidRigType.R6 then
        anim.AnimationId = Config.Animations.R6
    else
        anim.AnimationId = Config.Animations.R15
    end
    local track = animator:LoadAnimation(anim)
    track.Priority = Enum.AnimationPriority.Action4
    track.Looped = true
    track:Play()
    track:AdjustSpeed(Config.AnimationSpeed)
    session.Track = track
    
    session.DiedConn = hum.Died:Connect(function()
        stopTreadmill(plr, false)
    end)
    
    -- Sinyal buat sistem lain (misal Pickaxe Shop nutup sendiri)
    plr:SetAttribute("OnTreadmill", true)
    UIEvent:FireClient(plr, "Start")
    
    -- Dapat Speed tiap detik
    task.spawn(function()
        while session.Active do
            task.wait(1)
            if not session.Active or not plr.Parent then break end
            
            local levelInfo = Config.Levels[st.Level]
            local speedVal = getLeaderValue(plr, "Speed")
            if not levelInfo or not speedVal then break end
            
            speedVal.Value += levelInfo.PerSecond
            UIEvent:FireClient(plr, "Gain", levelInfo.PerSecond)
        end
    end)
end

----------------------------------------------------------------
-- BASE VISUAL
----------------------------------------------------------------
local function setGuiTexts(gui, buttonName, costText, buttonText)
    if not gui then return end
    local cost = gui:FindFirstChild("Cost")
    if cost then cost.Text = costText end
    
    local button = gui:FindFirstChild(buttonName)
    local label = button and button:FindFirstChild("Text")
    if label then label.Text = buttonText end
end

local function updatePurchaseGui(info)
    local gui = info.Purchase:FindFirstChild("PurchaseGui")
    setGuiTexts(gui, "Purchase", "C$" .. fmt(Config.PurchaseCost), "Purchase")
end

local function updateUpgradeGui(info, level)
    local upgradePart = info.Treadmill:FindFirstChild("TreadmillUpgrade")
    local gui = upgradePart and upgradePart:FindFirstChild("UpgradeGui")
    
    if level >= maxLevel then
        setGuiTexts(gui, "Upgrade", "Max", "Max")
    else
        local cost = Config.Levels[level + 1].Cost
        setGuiTexts(gui, "Upgrade", "C$" .. fmt(cost), level .. " > " .. (level + 1))
    end
end

local function clearLevelModel(info)
    if info.TouchConn then
        info.TouchConn:Disconnect()
        info.TouchConn = nil
    end
    if info.LevelModel then
        info.LevelModel:Destroy()
        info.LevelModel = nil
    end
    info.Hitbox = nil
    info.CurrentLevel = nil
end

local function buildLevelModel(base, level)
    local info = baseInfo[base]
    clearLevelModel(info)
    
    -- Buang model sisa di dalam Model(Treadmill) supaya yang muncul
    -- HANYA model level yang sedang dipakai.
    for _, child in ipairs(info.Treadmill:GetChildren()) do
        if child:IsA("Model") then
            child:Destroy()
        end
    end
    
    local template = LevelModels:FindFirstChild(tostring(level))
    if not template then
        warn("Model level " .. level .. " tidak ada di ServerStorage.Configuration.Base.Treadmill")
        return
    end
    
    local clone = template:Clone()
    clone.Name = "Level"
    
    for _, d in ipairs(clone:GetDescendants()) do
        if d:IsA("BasePart") then
            d.Anchored = true
        end
    end
    
    clone.Parent = info.Treadmill
    
    -- Taruh di Part(Treadmill): tengah X/Z, paling bawah sejajar bawah Part
    local pad = info.Treadmill:FindFirstChild("Treadmill")
    if pad and pad:IsA("BasePart") then
        local cf, size = clone:GetBoundingBox()
        local padBottom = pad.Position.Y - pad.Size.Y / 2
        local delta = Vector3.new(
        pad.Position.X - cf.Position.X,
        (padBottom + size.Y / 2) - cf.Position.Y,
        pad.Position.Z - cf.Position.Z
        )
        clone:PivotTo(clone:GetPivot() + delta)
    end
    
    -- Text PerSecond: "+10 Speed" (Text & Color sama)
    local perSecond = Config.Levels[level].PerSecond
    local text = "+" .. fmt(perSecond) .. " Speed"
    local psPart = clone:FindFirstChild("PerSecond")
    if psPart then
        local t = psPart:FindFirstChild("Text", true)
        local c = psPart:FindFirstChild("Color", true)
        if t and t:IsA("TextLabel") then t.Text = text end
        if c and c:IsA("TextLabel") then c.Text = text end
    end
    
    info.LevelModel = clone
    info.CurrentLevel = level
    
    local hitbox = clone:FindFirstChild("Hitbox")
    if hitbox and hitbox:IsA("BasePart") then
        info.Hitbox = hitbox
        info.TouchConn = hitbox.Touched:Connect(function(hit)
            local char = hit:FindFirstAncestorOfClass("Model")
            local plr = char and Players:GetPlayerFromCharacter(char)
            if plr and plr == info.Player then
                startTreadmill(plr, base)
            end
        end)
    else
        warn("Part Hitbox tidak ada di model level " .. level)
    end
end

local function showTreadmill(base, level)
    local info = baseInfo[base]
    
    info.Purchase.Parent = info.Stash
    info.Treadmill.Parent = base
    
    if info.CurrentLevel ~= level or not info.LevelModel then
        buildLevelModel(base, level)
    end
    updateUpgradeGui(info, level)
end

local function showPurchase(base)
    local info = baseInfo[base]
    
    clearLevelModel(info)
    info.Treadmill.Parent = info.Stash
    info.Purchase.Parent = base
    updatePurchaseGui(info)
end

local function refreshBase(base)
    local info = baseInfo[base]
    if not info then return end
    
    local ownerId = info.Owner.Value
    local plr = nil
    if ownerId ~= 0 then
        plr = Players:GetPlayerByUserId(ownerId)
    end
    
    if info.Player and info.Player ~= plr then
        stopTreadmill(info.Player, false)
    end
    info.Player = plr
    
    if plr then
        local st = state[plr]
        if not st then return end -- data belum ke-load, nanti dipanggil lagi
            if st.Owned then
                showTreadmill(base, st.Level)
            else
                showPurchase(base)
            end
        else
            showPurchase(base)
        end
    end
    
    local function refreshBaseOfPlayer(plr)
        for base, info in pairs(baseInfo) do
            if info.Owner.Value == plr.UserId then
                refreshBase(base)
            end
        end
    end
    
    ----------------------------------------------------------------
    -- PURCHASE / UPGRADE
    ----------------------------------------------------------------
    local function handlePurchase(plr, base)
        local st = state[plr]
        if not st or st.Owned then return end
        
        local sheckles = getLeaderValue(plr, "Sheckles")
        if not sheckles or sheckles.Value < Config.PurchaseCost then return end
        
        sheckles.Value -= Config.PurchaseCost
        st.Owned = true
        st.Level = 1
        refreshBase(base)
    end
    
    local function handleUpgrade(plr, base)
        local st = state[plr]
        if not st or not st.Owned then return end
        if st.Level >= maxLevel then return end
        
        local cost = Config.Levels[st.Level + 1].Cost
        local sheckles = getLeaderValue(plr, "Sheckles")
        if not sheckles or sheckles.Value < cost then return end
        
        -- Kalau lagi lari, keluarkan dulu karena model mau diganti
        stopTreadmill(plr, true)
        
        sheckles.Value -= cost
        st.Level += 1
        refreshBase(base)
    end
    
    ActionEvent.OnServerEvent:Connect(function(plr, base, kind)
        if typeof(base) ~= "Instance" or base.Parent ~= Bases then return end
        
        local info = baseInfo[base]
        if not info or info.Owner.Value ~= plr.UserId then return end
        
        if kind == "Purchase" then
            handlePurchase(plr, base)
        elseif kind == "Upgrade" then
            handleUpgrade(plr, base)
        end
    end)
    
    StopEvent.OnServerEvent:Connect(function(plr)
        stopTreadmill(plr, true)
    end)
    
    ----------------------------------------------------------------
    -- BASE SETUP
    ----------------------------------------------------------------
    local function setupBase(base)
        if not base:IsA("Model") or baseInfo[base] then return end
        
        local owner = base:WaitForChild("Owner", 10)
        local treadmill = base:WaitForChild("Treadmill", 10)
        local purchase = base:WaitForChild("TreadmillPurchase", 10)
        
        if not owner or not treadmill or not purchase then
            warn(base.Name .. ": Owner / Treadmill / TreadmillPurchase tidak lengkap")
            return
        end
        
        local stash = Instance.new("Folder")
        stash.Name = base.Name
        stash.Parent = Stash
        
        baseInfo[base] = {
        Owner = owner,
        Treadmill = treadmill,
        Purchase = purchase,
        Stash = stash,
        }
        
        owner.Changed:Connect(function()
            refreshBase(base)
        end)
        
        refreshBase(base)
    end
    
    for _, base in ipairs(Bases:GetChildren()) do
        task.spawn(setupBase, base)
    end
    Bases.ChildAdded:Connect(function(base)
        task.spawn(setupBase, base)
    end)
    
    ----------------------------------------------------------------
    -- PLAYER
    ----------------------------------------------------------------
    local function onPlayerAdded(plr)
        plr:SetAttribute("OnTreadmill", false)
        
        plr.CharacterAdded:Connect(function()
            task.wait(0.1)
            applyWalkSpeed(plr)
        end)
    end
    
    Players.PlayerAdded:Connect(onPlayerAdded)
    for _, plr in ipairs(Players:GetPlayers()) do
        task.spawn(onPlayerAdded, plr)
    end
    
    -- Data sudah ke-load (dari DataService)
    DataService.OnLoaded(function(plr)
        local st = DataService.Section(plr, "Treadmill")
        if not st then return end
        
        st.Owned = st.Owned == true
        st.Level = math.clamp(tonumber(st.Level) or 1, 1, maxLevel)
        state[plr] = st
        
        local speedVal = getLeaderValue(plr, "Speed")
        if speedVal then
            speedVal.Changed:Connect(function()
                applyWalkSpeed(plr)
            end)
        end
        
        applyWalkSpeed(plr)
        refreshBaseOfPlayer(plr)
    end)
    
    Players.PlayerRemoving:Connect(function(plr)
        stopTreadmill(plr, false)
        state[plr] = nil
        lastStop[plr] = nil
    end)

]]></ProtectedString>
