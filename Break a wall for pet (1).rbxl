<ProtectedString name="Source"><![CDATA[--// InventoryClient  (LocalScript)
--// Taruh di: StarterPlayer > StarterPlayerScripts
--// Struktur GUI yang dipakai:
--// StarterGui.MainGui.GameHub.Frame.Frame.Inventory
--//   Backpack (Frame, hotbar) -> Template, Backpack (button)
--//   Frame (panel)            -> Top (Close, Search), Main (ScrollingFrame) -> Template

local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")
local StarterGui = game:GetService("StarterGui")
local GuiService = game:GetService("GuiService")

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

--==================================================
-- SETTINGS
--==================================================
local HOTBAR_SLOTS = 5           -- jumlah slot di hotbar (1-6)
local FIT_HOTBAR = false          -- false = pakai ukuran Template kamu apa adanya (true = lebar dikecilkan otomatis, bisa kelihatan gepeng)
local HOTBAR_PADDING = 0.015      -- jarak antar slot (scale)
local DRAG_THRESHOLD = 10         -- jarak (px) sebelum dianggap drag
local TOUCH_HOLD_TIME = 0.25      -- HP: tahan sebentar dulu baru bisa drag (biar tidak bentrok sama scroll)
local PANEL_START_SCALE = 0.05    -- ukuran awal panel saat buka / ukuran akhir saat tutup

local PANEL_OPEN = TweenInfo.new(0.5, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
local PANEL_CLOSE = TweenInfo.new(0.4, Enum.EasingStyle.Back, Enum.EasingDirection.In)
local SELECT_IN = TweenInfo.new(0.25, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
local SELECT_OUT = TweenInfo.new(0.15, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
local SELECT_FADE = TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)

--==================================================
-- MATIKAN BACKPACK BAWAAN ROBLOX
--==================================================
local function disableCoreBackpack()
    for _ = 1, 20 do
        local ok = pcall(function()
            StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.Backpack, false)
        end)
        if ok then break end
        task.wait(0.5)
    end
end
task.spawn(disableCoreBackpack)

--==================================================
-- REFERENSI GUI
--==================================================
local screenGui = playerGui:WaitForChild("MainGui")
local inventory = screenGui:WaitForChild("GameHub"):WaitForChild("Frame"):WaitForChild("Frame"):WaitForChild("Inventory")

local hotbar = inventory:WaitForChild("Backpack")
local hotbarTemplate = hotbar:WaitForChild("Template")
local backpackButton = hotbar:WaitForChild("Backpack")

local panel = inventory:WaitForChild("Frame")
local main = panel:WaitForChild("Main")
local gridTemplate = main:WaitForChild("Template")
local top = panel:WaitForChild("Top")
local closeButton = top:WaitForChild("Close")
local searchBox = top:WaitForChild("Search")

hotbarTemplate.Visible = false
gridTemplate.Visible = false
panel.Visible = false

--==================================================
-- DATA
--==================================================
local inventoryHidden = false -- true = inventory custom disembunyikan (lihat HideInv_ di bawah)
local order = {}        -- urutan Tool (index = nomor slot)
local toolData = {}     -- [tool] = {conns = {...}}
local gridSlots = {}    -- [tool] = slot di panel
local hotbarSlots = {}  -- [1..HOTBAR_SLOTS] = slot di hotbar
local slotData = {}     -- [slot] = data referensi + status select
local slotInfo = {}     -- [slot] = {kind="hotbar", index=i} / {kind="grid", tool=tool}

local refresh -- forward declaration

--==================================================
-- SELECT EFFECT (smooth)
--==================================================
local function setupSlot(slot)
    local d = { selected = false }
    d.number = slot:FindFirstChild("Number")
    d.nameLabel = slot:FindFirstChild("Name") -- NOTE: bukan slot.Name (itu nama Instance)
    d.view = slot:FindFirstChild("View")
    d.select = slot:FindFirstChild("Select")
    d.stroke = d.select and d.select:FindFirstChildWhichIsA("UIStroke")
    if d.select then
        d.selectSize = d.select.Size
        d.select.Visible = false
    end
    if d.stroke then
        d.strokeTransparency = d.stroke.Transparency
        d.stroke.Transparency = 1
    end
    slotData[slot] = d
    return d
end

local function scaledSize(size, factor)
    return UDim2.new(size.X.Scale * factor, size.X.Offset * factor, size.Y.Scale * factor, size.Y.Offset * factor)
end

local function setSelected(slot, on)
    local d = slotData[slot]
    if not d or not d.select or d.selected == on then return end
    d.selected = on
    
    if d.tweenA then d.tweenA:Cancel() end
    if d.tweenB then d.tweenB:Cancel() end
    
    local sel, stroke = d.select, d.stroke
    if on then
        sel.Visible = true
        sel.Size = scaledSize(d.selectSize, 0.8)
        d.tweenA = TweenService:Create(sel, SELECT_IN, { Size = d.selectSize })
        d.tweenA:Play()
        if stroke then
            d.tweenB = TweenService:Create(stroke, SELECT_FADE, { Transparency = d.strokeTransparency })
            d.tweenB:Play()
        end
    else
        local tw = TweenService:Create(sel, SELECT_OUT, { Size = scaledSize(d.selectSize, 0.85) })
        d.tweenA = tw
        tw:Play()
        tw.Completed:Once(function(state)
            if state == Enum.PlaybackState.Completed and not d.selected then
                sel.Visible = false
            end
        end)
        if stroke then
            d.tweenB = TweenService:Create(stroke, SELECT_FADE, { Transparency = 1 })
            d.tweenB:Play()
        end
    end
end

--==================================================
-- VIEWPORT (tampilkan model Tool)
--==================================================
local function partHalfExtents(p)
    local cf = p.CFrame
    local s = p.Size * 0.5
    local r, u, l = cf.RightVector, cf.UpVector, cf.LookVector
    return Vector3.new(
    math.abs(r.X) * s.X + math.abs(u.X) * s.Y + math.abs(l.X) * s.Z,
    math.abs(r.Y) * s.X + math.abs(u.Y) * s.Y + math.abs(l.Y) * s.Z,
    math.abs(r.Z) * s.X + math.abs(u.Z) * s.Y + math.abs(l.Z) * s.Z
    )
end

local function renderTool(viewport, tool)
    for _, childName in ipairs({ "ToolWorld", "ToolCamera", "ToolIcon" }) do
        local old = viewport:FindFirstChild(childName)
        if old then old:Destroy() end
    end
    
    local world = Instance.new("WorldModel")
    world.Name = "ToolWorld"
    
    local allParts, visibleParts = {}, {}
    for _, d in ipairs(tool:GetDescendants()) do
        if d:IsA("BasePart") then
            local c = d:Clone()
            if c then
                for _, x in ipairs(c:GetDescendants()) do
                    if x:IsA("LuaSourceContainer") or x:IsA("Sound") or x:IsA("JointInstance")
                        or x:IsA("WeldConstraint") or x:IsA("Constraint") then
                        x:Destroy()
                    end
                end
                c.Anchored = true
                c.CanCollide = false
                c.CanTouch = false
                c.Parent = world
                table.insert(allParts, c)
                if d.Transparency < 0.95 then
                    table.insert(visibleParts, c)
                end
            end
        end
    end
    
    if #allParts == 0 then
        world:Destroy()
        -- fallback: pakai icon TextureId kalau Tool tidak punya part
        if tool.TextureId ~= "" then
            local icon = Instance.new("ImageLabel")
            icon.Name = "ToolIcon"
            icon.BackgroundTransparency = 1
            icon.Size = UDim2.fromScale(0.8, 0.8)
            icon.Position = UDim2.fromScale(0.5, 0.45)
            icon.AnchorPoint = Vector2.new(0.5, 0.5)
            icon.ScaleType = Enum.ScaleType.Fit
            icon.Image = tool.TextureId
            icon.Parent = viewport
        end
        return
    end
    
    local measure = (#visibleParts > 0) and visibleParts or allParts
    local minV, maxV
    for _, p in ipairs(measure) do
        local ext = partHalfExtents(p)
        local lo, hi = p.Position - ext, p.Position + ext
        minV = minV and minV:Min(lo) or lo
        maxV = maxV and maxV:Max(hi) or hi
    end
    
    local center = (minV + maxV) / 2
    local radius = math.max((maxV - minV).Magnitude / 2, 0.25)
    
    local cam = Instance.new("Camera")
    cam.Name = "ToolCamera"
    cam.FieldOfView = 30
    
    local aspect = 0.75
    if viewport.AbsoluteSize.X > 0 and viewport.AbsoluteSize.Y > 0 then
        aspect = viewport.AbsoluteSize.X / viewport.AbsoluteSize.Y
    end
    local halfTan = math.tan(math.rad(cam.FieldOfView / 2)) * math.min(1, aspect)
    local dist = radius / halfTan * 1.05
    
    local dir = Vector3.new(1, 0.55, 1.2).Unit
    cam.CFrame = CFrame.lookAt(center + dir * dist, center)
    
    world.Parent = viewport
    cam.Parent = viewport
    viewport.CurrentCamera = cam
end

--==================================================
-- SLOT
--==================================================
local function assign(slot, tool, index)
    local d = slotData[slot]
    if d.number then d.number.Text = tostring(index) .. "." end
    if d.nameLabel then d.nameLabel.Text = tool.Name end
    if d.tool ~= tool then
        d.tool = tool
        if d.view then renderTool(d.view, tool) end
    end
end

local function makeSlot(template, parent)
    local slot = template:Clone()
    slot.Name = "Slot"
    local inner = slot:FindFirstChild("Inner")
    if inner then inner:Destroy() end
    slot.Visible = false
    slot.Parent = parent
    setupSlot(slot)
    return slot
end

local function infoIndex(info)
    if info.kind == "hotbar" then
        return info.index
    end
    return table.find(order, info.tool)
end

--==================================================
-- EQUIP
--==================================================
local function toggleEquip(tool)
    local char = player.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if not hum or hum.Health <= 0 then return end
    if tool.Parent == char then
        hum:UnequipTools()
    else
        hum:EquipTool(tool)
    end
end

local function updateSelected()
    local char = player.Character
    for i = 1, HOTBAR_SLOTS do
        local tool = order[i]
        setSelected(hotbarSlots[i], tool ~= nil and char ~= nil and tool.Parent == char)
    end
    for tool, slot in pairs(gridSlots) do
        setSelected(slot, char ~= nil and tool.Parent == char)
    end
end

--==================================================
-- SEARCH
--==================================================
local function applySearch()
    local q = string.lower(searchBox.Text)
    q = q:gsub("^%s+", "")
    q = q:gsub("%s+$", "")
    for tool, slot in pairs(gridSlots) do
        slot.Visible = (q == "") or (string.find(string.lower(tool.Name), q, 1, true) ~= nil)
    end
end
searchBox:GetPropertyChangedSignal("Text"):Connect(applySearch)

--==================================================
-- REFRESH
--==================================================
function refresh()
    for i = 1, HOTBAR_SLOTS do
        local slot = hotbarSlots[i]
        local tool = order[i]
        if tool then
            assign(slot, tool, i)
            slot.Visible = true
        else
            slot.Visible = false
            slotData[slot].tool = nil
        end
    end
    for i, tool in ipairs(order) do
        local slot = gridSlots[tool]
        if slot then
            assign(slot, tool, i)
            slot.LayoutOrder = i
        end
    end
    applySearch()
    updateSelected()
end

--==================================================
-- DRAG & DROP
--==================================================
local drag = nil

local function findSlotAt(pos)
    local objects = playerGui:GetGuiObjectsAtPosition(pos.X, pos.Y)
    for _, obj in ipairs(objects) do
        local cur = obj
        while cur and cur ~= playerGui do
            local info = slotInfo[cur]
            if info then
                return cur, info
            end
            cur = cur.Parent
        end
    end
    return nil, nil
end

local function createGhost(slot)
    local ghost = slot:Clone()
    for _, d in ipairs(ghost:GetDescendants()) do
        if d:IsA("LuaSourceContainer") or d:IsA("Sound") then
            d:Destroy()
        end
    end
    ghost.Name = "DragGhost"
    ghost.AnchorPoint = Vector2.new(0.5, 0.5)
    ghost.Size = UDim2.fromOffset(slot.AbsoluteSize.X, slot.AbsoluteSize.Y)
    ghost.Interactable = false
    ghost.Visible = true
    ghost.ZIndex = 200
    
    local hs = ghost:FindFirstChild("HoverScale")
    if hs then hs.Scale = 1 end
    local sel = ghost:FindFirstChild("Select")
    if sel then sel.Visible = false end
    
    if screenGui.ZIndexBehavior == Enum.ZIndexBehavior.Global then
        for _, d in ipairs(ghost:GetDescendants()) do
            if d:IsA("GuiObject") then d.ZIndex += 200 end
        end
    end
    
    ghost.Parent = screenGui
    return ghost
end

local function moveGhost(ghost, pos)
    local inset = screenGui.IgnoreGuiInset and GuiService:GetGuiInset() or Vector2.zero
    ghost.Position = UDim2.fromOffset(pos.X + inset.X, pos.Y + inset.Y)
end

local function bindSlotInput(slot)
    slot.InputBegan:Connect(function(input)
        if input.UserInputType ~= Enum.UserInputType.MouseButton1
            and input.UserInputType ~= Enum.UserInputType.Touch then
            return
        end
        if drag then return end
        local info = slotInfo[slot]
        if not info then return end
        local idx = infoIndex(info)
        if not idx or not order[idx] then return end
        drag = {
        slot = slot,
        info = info,
        input = input,
        start = Vector2.new(input.Position.X, input.Position.Y),
        t0 = os.clock(),
        active = false,
        dead = false,
        ghost = nil,
        }
    end)
end

UserInputService.InputChanged:Connect(function(input)
    if not drag or drag.dead then return end
    local isMouse = input.UserInputType == Enum.UserInputType.MouseMovement
    local isTouch = input.UserInputType == Enum.UserInputType.Touch and input == drag.input
    if not (isMouse or isTouch) then return end
    
    local pos = Vector2.new(input.Position.X, input.Position.Y)
    if not drag.active then
        if (pos - drag.start).Magnitude < DRAG_THRESHOLD then return end
        if isTouch and os.clock() - drag.t0 < TOUCH_HOLD_TIME then
            drag.dead = true
            return
        end
        if not drag.slot.Parent then
            drag = nil
            return
        end
        drag.active = true
        drag.ghost = createGhost(drag.slot)
    end
    moveGhost(drag.ghost, pos)
end)

UserInputService.InputEnded:Connect(function(input)
    if not drag then return end
    local isMouse = input.UserInputType == Enum.UserInputType.MouseButton1
    local isTouch = input.UserInputType == Enum.UserInputType.Touch and input == drag.input
    if not (isMouse or isTouch) then return end
    
    local d = drag
    drag = nil
    if d.ghost then d.ghost:Destroy() end
    if d.dead then return end
    
    if d.active then
        local pos = Vector2.new(input.Position.X, input.Position.Y)
        local targetSlot, targetInfo = findSlotAt(pos)
        if targetSlot and targetSlot ~= d.slot then
            local a, b = infoIndex(d.info), infoIndex(targetInfo)
            if a and b and a ~= b and order[a] and order[b] then
                order[a], order[b] = order[b], order[a]
                refresh()
            end
        end
    else
        local idx = infoIndex(d.info)
        local tool = idx and order[idx]
        if tool then toggleEquip(tool) end
    end
end)

--==================================================
-- BUAT SLOT HOTBAR
--==================================================
local hotbarList = hotbar:FindFirstChildOfClass("UIListLayout")
if hotbarList then
    hotbarList.SortOrder = Enum.SortOrder.LayoutOrder
end

for i = 1, HOTBAR_SLOTS do
    local slot = makeSlot(hotbarTemplate, hotbar)
    slot.Name = "Slot" .. i
    slot.LayoutOrder = i + 1
    slotInfo[slot] = { kind = "hotbar", index = i }
    bindSlotInput(slot)
    hotbarSlots[i] = slot
end

backpackButton.LayoutOrder = 1
setupSlot(backpackButton)

if FIT_HOTBAR then
    local count = HOTBAR_SLOTS + 1
    local w = (1 - HOTBAR_PADDING * (count - 1)) / count
    if hotbarList then
        hotbarList.Padding = UDim.new(HOTBAR_PADDING, 0)
    end
    local function fit(gui)
        gui.Size = UDim2.new(w, 0, gui.Size.Y.Scale, gui.Size.Y.Offset)
    end
    for _, slot in ipairs(hotbarSlots) do fit(slot) end
    fit(backpackButton)
end

--==================================================
-- BUKA / TUTUP PANEL
--==================================================
local panelScale = panel:FindFirstChild("OpenScale")
if not panelScale then
    panelScale = Instance.new("UIScale")
    panelScale.Name = "OpenScale"
    panelScale.Parent = panel
end
panelScale.Scale = 1

local isOpen = false
local panelTween
local panelToken = 0

local function setOpen(state)
    if state == isOpen then return end
    isOpen = state
    panelToken += 1
    local token = panelToken
    if panelTween then panelTween:Cancel() end
    
    if state then
        if not panel.Visible then
            panelScale.Scale = PANEL_START_SCALE
            panel.Visible = true
        end
        panelTween = TweenService:Create(panelScale, PANEL_OPEN, { Scale = 1 })
        panelTween:Play()
    else
        local tw = TweenService:Create(panelScale, PANEL_CLOSE, { Scale = PANEL_START_SCALE })
        panelTween = tw
        tw:Play()
        task.delay(PANEL_CLOSE.Time + 0.05, function()
            if token == panelToken and not isOpen then
                panel.Visible = false
            end
        end)
    end
    setSelected(backpackButton, isOpen)
end

backpackButton.MouseButton1Click:Connect(function()
    setOpen(not isOpen)
end)
closeButton.MouseButton1Click:Connect(function()
    setOpen(false)
end)

--==================================================
-- SEMBUNYIKAN / MUNCULKAN INVENTORY CUSTOM
--==================================================
local HIDE_PREFIX = "HideInv_"

local function updateHidden()
    local hide = false
    for attrName, value in pairs(player:GetAttributes()) do
        if string.sub(attrName, 1, #HIDE_PREFIX) == HIDE_PREFIX and value == true then
            hide = true
            break
        end
    end
    if hide == inventoryHidden then return end
    inventoryHidden = hide
    
    if hide then
        isOpen = false
        panelToken += 1
        if panelTween then panelTween:Cancel() end
        panel.Visible = false
        panelScale.Scale = 1
        setSelected(backpackButton, false)
        hotbar.Visible = false
    else
        hotbar.Visible = true
    end
end

player.AttributeChanged:Connect(function(attrName)
    if string.sub(attrName, 1, #HIDE_PREFIX) == HIDE_PREFIX then
        updateHidden()
    end
end)
updateHidden()

--==================================================
-- KEYBIND 1-6
--==================================================
local NUMBER_KEYS = {
Enum.KeyCode.One, Enum.KeyCode.Two, Enum.KeyCode.Three,
Enum.KeyCode.Four, Enum.KeyCode.Five, Enum.KeyCode.Six,
Enum.KeyCode.Seven, Enum.KeyCode.Eight, Enum.KeyCode.Nine,
}

UserInputService.InputBegan:Connect(function(input, processed)
    if processed or inventoryHidden or UserInputService:GetFocusedTextBox() then return end
    if input.UserInputType ~= Enum.UserInputType.Keyboard then return end
    for i = 1, math.min(HOTBAR_SLOTS, #NUMBER_KEYS) do
        if input.KeyCode == NUMBER_KEYS[i] then
            local tool = order[i]
            if tool then toggleEquip(tool) end
            break
        end
    end
end)

--==================================================
-- TRACK TOOL (Backpack + Character)
--==================================================
local function isOwned(tool)
    local bp = player:FindFirstChildOfClass("Backpack")
    local char = player.Character
    return (bp ~= nil and tool:IsDescendantOf(bp)) or (char ~= nil and tool:IsDescendantOf(char))
end

local function removeTool(tool)
    local data = toolData[tool]
    if not data then return end
    for _, c in ipairs(data.conns) do c:Disconnect() end
    toolData[tool] = nil
    
    local i = table.find(order, tool)
    if i then table.remove(order, i) end
    
    local slot = gridSlots[tool]
    if slot then
        gridSlots[tool] = nil
        slotInfo[slot] = nil
        slotData[slot] = nil
        slot:Destroy()
    end
    refresh()
end

local function addTool(tool)
    if not tool:IsA("Tool") or toolData[tool] then return end
    
    local data = { conns = {} }
    toolData[tool] = data
    table.insert(order, tool)
    
    local slot = makeSlot(gridTemplate, main)
    slot.Visible = true
    slotInfo[slot] = { kind = "grid", tool = tool }
    bindSlotInput(slot)
    gridSlots[tool] = slot
    
    table.insert(data.conns, tool:GetPropertyChangedSignal("Name"):Connect(refresh))
    table.insert(data.conns, tool.AncestryChanged:Connect(function()
        task.defer(function()
            if not toolData[tool] then return end
            if isOwned(tool) then
                updateSelected()
            else
                removeTool(tool)
            end
        end)
    end))
    
    refresh()
end

local backpackConn
local function bindBackpack(bp)
    if backpackConn then backpackConn:Disconnect() end
    backpackConn = bp.ChildAdded:Connect(addTool)
    for _, c in ipairs(bp:GetChildren()) do addTool(c) end
end

local characterConn
local function bindCharacter(char)
    if characterConn then characterConn:Disconnect() end
    characterConn = char.ChildAdded:Connect(addTool)
    for _, c in ipairs(char:GetChildren()) do addTool(c) end
    updateSelected()
end

player.ChildAdded:Connect(function(child)
    if child:IsA("Backpack") then bindBackpack(child) end
end)
player.CharacterAdded:Connect(bindCharacter)

bindBackpack(player:WaitForChild("Backpack"))
if player.Character then bindCharacter(player.Character) end

refresh()

]]></ProtectedString>
