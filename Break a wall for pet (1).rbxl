<Item class="LocalScript" referent="RBXCE0869D075DF4A55B454100909AE4BA1">
<Properties>
<BinaryString name="AttributesSerialize"></BinaryString>
<bool name="Disabled">false</bool>
<Content name="LinkedSource"><null></null></Content>
<string name="Name">MainClient</string>
<token name="RunContext">0</token>
<string name="ScriptGuid">{A7A2C6D1-8936-4D8F-A45D-9A2AE9525164}</string>
<ProtectedString name="Source"><![CDATA[--// Universal Hover & Click Animation + Sounds
--// Button, Frame, ImageLabel
--// PC + Mobile
--// Compatible with UIPadding + UIListLayout

local gui = script.Parent
local TS = game:GetService("TweenService")

local hoverSound = gui:WaitForChild("Hover")
local clickSound = gui:WaitForChild("ClickSound")

--==================================================
-- UISCALE
--==================================================

local uiScale = gui:FindFirstChild("HoverScale")

if not uiScale then
    uiScale = Instance.new("UIScale")
    uiScale.Name = "HoverScale"
    uiScale.Scale = 1
    uiScale.Parent = gui
end

--==================================================
-- SETTINGS
--==================================================

local hoverScale = 1.1
local clickScale = 0.9

local tweenInfo = TweenInfo.new(
0.15,
Enum.EasingStyle.Quad,
Enum.EasingDirection.Out
)

local isHovering = false
local activeTween

-- Mencegah Hover Sound saat sedang klik
local isClicking = false

--==================================================
-- TWEEN SCALE
--==================================================

local function tweenScale(scale)
    if activeTween then
        activeTween:Cancel()
    end
    
    activeTween = TS:Create(
    uiScale,
    tweenInfo,
    {
    Scale = scale
    }
    )
    
    activeTween:Play()
    
    return activeTween
end

--==================================================
-- HOVER MASUK
--==================================================

gui.MouseEnter:Connect(function()
    isHovering = true
    
    -- Jangan play Hover Sound kalau sedang klik
    if not isClicking then
        hoverSound:Play()
    end
    
    tweenScale(hoverScale)
end)

--==================================================
-- HOVER KELUAR
--==================================================

gui.MouseLeave:Connect(function()
    isHovering = false
    
    tweenScale(1)
end)

--==================================================
-- CLICK EFFECT
--==================================================

local function playClickEffect()
    -- Tandai sedang klik
    isClicking = true
    
    -- Hentikan hover sound kalau sedang berbunyi
    hoverSound:Stop()
    
    -- Play click sound
    clickSound:Play()
    
    -- Mengecil
    local shrink = tweenScale(clickScale)
    
    shrink.Completed:Once(function()
        
        -- Kembali ke ukuran normal/hover
        if isHovering then
            tweenScale(hoverScale)
        else
            tweenScale(1)
        end
        
        -- Tunggu sedikit supaya MouseEnter dari touch tidak
        -- langsung memainkan Hover Sound
        task.delay(0.05, function()
            isClicking = false
        end)
    end)
end

--==================================================
-- GUI BUTTON
--==================================================

if gui:IsA("GuiButton") then
    
    gui.MouseButton1Click:Connect(playClickEffect)
    
    --==================================================
    -- FRAME / IMAGELABEL
    --==================================================
    
else
    
    gui.InputBegan:Connect(function(input)
        
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            
            playClickEffect()
            
        end
        
    end)
    
end

]]></ProtectedString>
<UniqueId name="UniqueId">7bdf20b295fbe64d068940091000437f</UniqueId>
