<Item class="LocalScript" referent="RBXCE0869D075DF4A55B454100605AE4BA1">
<Properties>
<BinaryString name="AttributesSerialize"></BinaryString>
<bool name="Disabled">false</bool>
<Content name="LinkedSource"><null></null></Content>
<string name="Name">AutoSwingClient</string>
<token name="RunContext">0</token>
<string name="ScriptGuid">{A7A2C6D1-8936-4D8F-A45D-9A2AE9525164}</string>
<ProtectedString name="Source"><![CDATA[-- LocalScript: StarterPlayer > StarterPlayerScripts > AutoSwingClient
--
-- Struktur GUI (di StarterGui):
-- MainGui > GameHub > Frame > MechanicFrame > AreaMechanic > Pickaxe > AutoSwing (ImageButton) > Text
--
-- Swing (server) ada di PickaxeServer, jadi Tool pickaxe gak butuh Script lagi.
-- Warna: ReplicatedStorage > Configuration > Colors > Pickaxe > AutoSwing > Off / On (UIGradient)
 
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local RunService = game:GetService("RunService")
 
local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")
 
local SwingRemote = ReplicatedStorage:WaitForChild("Configuration"):WaitForChild("PickaxeRemotes")
:WaitForChild("PickaxeSwing")
 
local Colors = ReplicatedStorage:WaitForChild("Configuration"):WaitForChild("Colors")
:WaitForChild("Pickaxe"):WaitForChild("AutoSwing")
local OffGradient = Colors:WaitForChild("Off")
local OnGradient = Colors:WaitForChild("On")
 
-- Jarak antar swing otomatis (animasi swing ~0.89 dtk, cooldown server 0.85)
local AUTO_INTERVAL = 0.95
local COLOR_TIME = 0.3
 
----------------------------------------------------------------
-- STATE
----------------------------------------------------------------
local refs = nil
local autoOn = false
local currentTool = nil
 
----------------------------------------------------------------
-- WARNA SMOOTH (lerp antar 2 UIGradient)
----------------------------------------------------------------
local function sampleSequence(seq, t)
    local kps = seq.Keypoints
    for i = 1, #kps - 1 do
        local a, b = kps[i], kps[i + 1]
        if t >= a.Time and t <= b.Time then
            local alpha = (t - a.Time) / math.max(b.Time - a.Time, 1e-6)
            return a.Value:Lerp(b.Value, alpha)
        end
    end
    return kps[#kps].Value
end
 
local function lerpSequences(a, b, alpha)
    local points = {}
    local steps = 8
    for i = 0, steps do
        local t = i / steps
        local color = sampleSequence(a, t):Lerp(sampleSequence(b, t), alpha)
        table.insert(points, ColorSequenceKeypoint.new(t, color))
    end
    return ColorSequence.new(points)
end
 
local colorToken = 0
 
local function applyVisual(instant)
    if not refs then return end
 
    local target = autoOn and OnGradient or OffGradient
    local live = refs.Gradient
 
    refs.Text.Text = "Auto Swing: " .. (autoOn and "On" or "Off")
 
    colorToken += 1
    local token = colorToken
 
    if instant then
        live.Color = target.Color
        live.Rotation = target.Rotation
        live.Transparency = target.Transparency
        live.Offset = target.Offset
        return
    end
 
    local fromColor = live.Color
    local fromRotation = live.Rotation
 
    task.spawn(function()
        local start = os.clock()
        while true do
            if token ~= colorToken then return end
 
            local t = math.clamp((os.clock() - start) / COLOR_TIME, 0, 1)
            local a = TweenService:GetValue(t, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
 
            live.Color = lerpSequences(fromColor, target.Color, a)
            live.Rotation = fromRotation + (target.Rotation - fromRotation) * a
 
            if t >= 1 then break end
            RunService.RenderStepped:Wait()
        end
        live.Transparency = target.Transparency
        live.Offset = target.Offset
    end)
end
 
----------------------------------------------------------------
-- TOMBOL (muncul / hilang dengan animasi)
----------------------------------------------------------------
local function showButton()
    if not refs then return end
 
    refs.Area.Visible = true
    refs.PickaxeFrame.Visible = true
    refs.Button.Visible = true
 
    refs.Scale.Scale = 0
    TweenService:Create(
    refs.Scale,
    TweenInfo.new(0.35, Enum.EasingStyle.Back, Enum.EasingDirection.Out),
    { Scale = 1 }
    ):Play()
end
 
local function hideButton()
    local r = refs
    if not r then return end
 
    TweenService:Create(
    r.Scale,
    TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.In),
    { Scale = 0 }
    ):Play()
 
    task.delay(0.22, function()
        if not currentTool then
            r.Button.Visible = false
            r.PickaxeFrame.Visible = false
        end
    end)
end
 
local function bindGui(mainGui)
    local gameHub = mainGui:WaitForChild("GameHub")
    local area = gameHub:WaitForChild("Frame"):WaitForChild("MechanicFrame"):WaitForChild("AreaMechanic")
    local pickaxeFrame = area:WaitForChild("Pickaxe")
    local button = pickaxeFrame:WaitForChild("AutoSwing")
    local text = button:WaitForChild("Text")
 
    local scale = button:FindFirstChildOfClass("UIScale")
    if not scale then
        scale = Instance.new("UIScale")
        scale.Parent = button
    end
 
    local gradient = OffGradient:Clone()
    gradient.Name = "AutoSwingGradient"
    gradient.Parent = button
 
    button.Visible = false
    pickaxeFrame.Visible = false
 
    refs = {
    Area = area,
    PickaxeFrame = pickaxeFrame,
    Button = button,
    Text = text,
    Scale = scale,
    Gradient = gradient,
    }
 
    button.Activated:Connect(function()
        autoOn = not autoOn
        applyVisual(false)
    end)
 
    applyVisual(true)
    if currentTool then
        showButton()
    end
end
 
local existing = playerGui:FindFirstChild("MainGui")
if existing then
    task.spawn(bindGui, existing)
end
playerGui.ChildAdded:Connect(function(child)
    if child.Name == "MainGui" then
        task.spawn(bindGui, child)
    end
end)
 
----------------------------------------------------------------
-- PICKAXE YANG DIPEGANG (Tool dengan attribute ShopPickaxe dari PickaxeServer)
-- Ketuk layar / klik = swing, Auto Swing = swing terus, + camera shake pas pukulan mendarat
----------------------------------------------------------------
local SHAKE_POWER = 0.35
local MANUAL_COOLDOWN = 0.85
 
local lastFire = 0
local activatedConn = nil
 
local function swingNow(interval)
    if os.clock() - lastFire < interval then return end
    lastFire = os.clock()
    SwingRemote:FireServer("Swing")
end
 
local function cameraShake()
    local character = player.Character
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    if not humanoid then return end
 
    task.spawn(function()
        local duration = 0.22
        local start = os.clock()
 
        while true do
            local t = (os.clock() - start) / duration
            if t >= 1 or not humanoid.Parent then
                break
            end
 
            local fade = 1 - t
            humanoid.CameraOffset = Vector3.new(
            (math.random() - 0.5) * SHAKE_POWER * fade,
            (math.random() - 0.5) * SHAKE_POWER * fade,
            0
            )
 
            RunService.RenderStepped:Wait()
        end
 
        if humanoid.Parent then
            humanoid.CameraOffset = Vector3.zero
        end
    end)
end
 
SwingRemote.OnClientEvent:Connect(function(action)
    if action == "CameraShake" then
        cameraShake()
    end
end)
 
local function setTool(tool)
    if tool == currentTool then return end
 
    currentTool = tool
 
    if activatedConn then
        activatedConn:Disconnect()
        activatedConn = nil
    end
 
    if tool then
        activatedConn = tool.Activated:Connect(function()
            swingNow(MANUAL_COOLDOWN)
        end)
        showButton()
    else
        local character = player.Character
        local humanoid = character and character:FindFirstChildOfClass("Humanoid")
        if humanoid then
            humanoid.CameraOffset = Vector3.zero
        end
        hideButton()
    end
end
 
local function findHeldPickaxe(char)
    for _, child in ipairs(char:GetChildren()) do
        if child:IsA("Tool") and child:GetAttribute("ShopPickaxe") then
            return child
        end
    end
    return nil
end
 
local function onCharacter(char)
    local function update()
        setTool(findHeldPickaxe(char))
    end
 
    char.ChildAdded:Connect(update)
    char.ChildRemoved:Connect(update)
    update()
end
 
if player.Character then
    onCharacter(player.Character)
end
player.CharacterAdded:Connect(onCharacter)
 
----------------------------------------------------------------
-- AUTO SWING LOOP
----------------------------------------------------------------
RunService.Heartbeat:Connect(function()
    if not autoOn or not currentTool then return end
    if player:GetAttribute("OnTreadmill") then return end
 
    local char = player.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if not hum or hum.Health <= 0 or currentTool.Parent ~= char then return end
 
    swingNow(AUTO_INTERVAL)
end)

]]></ProtectedString>
<UniqueId name="UniqueId">7bdf20b295fbe64d068940060600437f</UniqueId>
</Properties>
