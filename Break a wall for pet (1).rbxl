<Item class="LocalScript" referent="RBXCE0869D075DF4A55B454100617AE4BA1">
<Properties>
<BinaryString name="AttributesSerialize"></BinaryString>
<bool name="Disabled">false</bool>
<Content name="LinkedSource"><null></null></Content>
<string name="Name">AreaClient</string>
<token name="RunContext">0</token>
<string name="ScriptGuid">{A7A2C6D1-8936-4D8F-A45D-9A2AE9525164}</string>
<ProtectedString name="Source"><![CDATA[-- LocalScript: StarterPlayer > StarterPlayerScripts > AreaClient
--
-- Wall HP, kena pukul, hancur, & muncul lagi = SEMUANYA CLIENT (sendiri-sendiri).
-- Pas pukulan Pickaxe mendarat, PickaxeServer ngirim "CameraShake" ke client;
-- sinyal itu dipakai sebagai momen "impact" (ngurangin HP Wall di depan kita).
--
-- Isi file ini: Wall (HP/hancur/muncul lagi) + Wall HUD di layar (MainGui) + warna nama Area.
 
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
 
local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")
 
local Modules = ReplicatedStorage:WaitForChild("Configuration"):WaitForChild("Modules")
local NumberFormatModule = require(Modules:WaitForChild("NumberFormat"))
local PickaxeConfig = require(Modules:WaitForChild("Pickaxe"):WaitForChild("PickaxeConfig"))
local WallConfig = require(Modules:WaitForChild("Area"):WaitForChild("Wall"):WaitForChild("WallConfig"))
local AreaDisplay = require(Modules:WaitForChild("Area"):WaitForChild("AreaDisplay"):WaitForChild("AreaDisplayConfig"))
 
-- ReplicatedStorage > Configuration > Colors > Area > AreaDisplay > <nomor Area>
local AreaColors = ReplicatedStorage:WaitForChild("Configuration"):WaitForChild("Colors", 10)
AreaColors = AreaColors and AreaColors:WaitForChild("Area", 10)
AreaColors = AreaColors and AreaColors:WaitForChild("AreaDisplay", 10)
if not AreaColors then
    warn("Colors > Area > AreaDisplay tidak ditemukan, teks Wall tanpa warna")
end
 
local System = workspace:WaitForChild("Map"):WaitForChild("System")
local AreaFolder = System:WaitForChild("Area")
local SaveZone = System:WaitForChild("SaveZone")
 
local function fmt(n)
    if type(NumberFormatModule) == "function" then
        return NumberFormatModule(n)
    elseif type(NumberFormatModule) == "table" and NumberFormatModule.Format then
        return NumberFormatModule.Format(n)
    end
    return tostring(n)
end
 
-- Pasang warna Area (UIGradient / folder isi UIGradient + script-nya) ke sebuah teks.
-- Warna lama dari Area sebelumnya dibuang dulu.
local function applyAreaColor(target, areaIndex)
    if not target or not AreaColors then return end
    
    for _, child in ipairs(target:GetChildren()) do
        if child:GetAttribute("AreaColor") then
            child:Destroy()
        end
    end
    
    local source = AreaColors:FindFirstChild(tostring(areaIndex))
    if not source then
        warn("Warna Area " .. tostring(areaIndex) .. " tidak ada di Colors > Area > AreaDisplay")
        return
    end
    
    local function attach(gradient)
        local copy = gradient:Clone()
        copy:SetAttribute("AreaColor", true)
        copy.Parent = target
    end
    
    if source:IsA("UIGradient") then
        attach(source)
    else
        for _, child in ipairs(source:GetChildren()) do
            if child:IsA("UIGradient") then
                attach(child)
            end
        end
    end
end
 
----------------------------------------------------------------
-- WALL STATE
----------------------------------------------------------------
local walls = {}
 
local function updateGui(w, animate)
    if w.HpText then
        w.HpText.Text = fmt(math.ceil(w.HP)) .. "/" .. fmt(w.MaxHP) .. " Hp"
    end
    
    if w.Fill then
        local size = UDim2.new(w.HP / w.MaxHP, 0, 1, 0)
        if animate then
            TweenService:Create(
            w.Fill,
            TweenInfo.new(0.15, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
            { Size = size }
            ):Play()
        else
            w.Fill.Size = size
        end
    end
end
 
local function setupWall(model, areaIndex)
    local settings = WallConfig.Walls[areaIndex]
    if not settings then
        warn("Area " .. tostring(areaIndex) .. " belum ada di WallConfig")
        return
    end
    
    local gui = model:WaitForChild("WallGui", 10)
    if not gui then
        warn(model:GetFullName() .. ": WallGui tidak ada (AreaServer jalan?)")
        return
    end
    
    local hpFrame = gui:FindFirstChild("Hp")
    
    -- Warna nama Area di WallGui (Background > Text)
    local background = gui:FindFirstChild("Background")
    local nameLabel = (background and background:FindFirstChild("Text")) or gui:FindFirstChild("Text")
    applyAreaColor(nameLabel, areaIndex)
    
    -- Pindah ke PlayerGui (Adornee tetap ke Wall) biar LocalScript warna ikut jalan
    gui.Parent = playerGui
    
    local entries = {}
    for _, d in ipairs(model:GetDescendants()) do
        if d:IsA("BasePart") then
            table.insert(entries, {
            Inst = d,
            Transparency = d.Transparency,
            CanCollide = d.CanCollide,
            CanQuery = d.CanQuery,
            CanTouch = d.CanTouch,
            })
        elseif d:IsA("Decal") or d:IsA("Texture") then
            table.insert(entries, { Inst = d, Transparency = d.Transparency })
        end
    end
    
    local cf, size = model:GetBoundingBox()
    
    local w = {
    Model = model,
    Gui = gui,
    HpText = hpFrame and hpFrame:FindFirstChild("Text"),
    Fill = hpFrame and hpFrame:FindFirstChild("Fill"),
    AreaIndex = areaIndex,
    DisplayName = AreaDisplay[areaIndex] and AreaDisplay[areaIndex].Name or tostring(areaIndex),
    MaxHP = settings.HP,
    HP = settings.HP,
    Alive = true,
    Token = 0,
    Entries = entries,
    CF = cf,
    Size = size,
    }
    
    updateGui(w, false)
    table.insert(walls, w)
end
 
for _, area in ipairs(AreaFolder:GetChildren()) do
    local index = tonumber(area.Name)
    if index then
        for _, wall in ipairs(area:GetChildren()) do
            if wall:IsA("Model") and wall.Name ~= "Guard" then
                task.spawn(setupWall, wall, index)
            end
        end
    end
end
 
----------------------------------------------------------------
-- HANCUR & MUNCUL LAGI
----------------------------------------------------------------
local function destroyWall(w)
    w.Alive = false
    w.Token += 1
    local token = w.Token
    
    w.Gui.Enabled = false
    
    local info = TweenInfo.new(WallConfig.DestroyTime, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
    for _, e in ipairs(w.Entries) do
        TweenService:Create(e.Inst, info, { Transparency = 1 }):Play()
    end
    
    task.delay(WallConfig.DestroyTime, function()
        if w.Token ~= token then return end
        for _, e in ipairs(w.Entries) do
            if e.CanCollide ~= nil then
                e.Inst.CanCollide = false
                e.Inst.CanQuery = false
                e.Inst.CanTouch = false
            end
        end
    end)
end
 
local function respawnWall(w)
    w.Alive = true
    w.Token += 1
    w.HP = w.MaxHP
    updateGui(w, false)
    
    local info = TweenInfo.new(WallConfig.RespawnTime, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
    for _, e in ipairs(w.Entries) do
        if e.CanCollide ~= nil then
            e.Inst.CanCollide = e.CanCollide
            e.Inst.CanQuery = e.CanQuery
            e.Inst.CanTouch = e.CanTouch
        end
        TweenService:Create(e.Inst, info, { Transparency = e.Transparency }):Play()
    end
    
    w.Gui.Enabled = true
end
 
-- Kena Hitbox SaveZone -> semua Wall yang SUDAH hancur muncul lagi
-- (Wall yang masih ada tetap seperti biasa, HP-nya gak di-reset)
local saveCooldown = 0
SaveZone:WaitForChild("Hitbox").Touched:Connect(function(hit)
    local char = player.Character
    if not char or not hit:IsDescendantOf(char) then return end
    if os.clock() < saveCooldown then return end
    saveCooldown = os.clock() + 1
    
    for _, w in ipairs(walls) do
        if not w.Alive then
            respawnWall(w)
        end
    end
end)
 
----------------------------------------------------------------
-- WALL HUD  (MainGui > GameHub > Frame > MechanicFrame > AreaMechanic > Wall)
-- Muncul dari atas pas kita hit Wall, hilang lagi ke atas kalau 8 detik gak hit.
----------------------------------------------------------------
local HUD_HIDE_AFTER = 8
 
local hud = nil
local hudShown = false
local hudToken = 0
local hudArea = nil
 
local function hudHiddenPosition(pos)
    -- satu tinggi layar ke atas + 400px, jadi pasti di luar layar
    return UDim2.new(pos.X.Scale, pos.X.Offset, pos.Y.Scale - 1, pos.Y.Offset - 400)
end
 
local function bindHud(mainGui)
    local area = mainGui:WaitForChild("GameHub"):WaitForChild("Frame")
    :WaitForChild("MechanicFrame"):WaitForChild("AreaMechanic")
    local frame = area:WaitForChild("Wall")
    local hp = frame:WaitForChild("Hp")
    local background = frame:WaitForChild("Background")
    
    hud = {
    Area = area,
    Frame = frame,
    HpText = hp:FindFirstChild("Text"),
    Fill = hp:FindFirstChild("Fill"),
    NameText = background:FindFirstChild("Text"),
    Position = frame.Position,
    }
    
    frame.Visible = false
    hudShown = false
    hudArea = nil
end
 
local existingGui = playerGui:FindFirstChild("MainGui")
if existingGui then
    task.spawn(bindHud, existingGui)
end
playerGui.ChildAdded:Connect(function(child)
    if child.Name == "MainGui" then
        task.spawn(bindHud, child)
    end
end)
 
local function hideHud()
    local h = hud
    if not h or not hudShown then return end
    hudShown = false
    
    TweenService:Create(
    h.Frame,
    TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.In),
    { Position = hudHiddenPosition(h.Position) }
    ):Play()
    
    task.delay(0.32, function()
        if not hudShown then
            h.Frame.Visible = false
        end
    end)
end
 
local function showHud(w)
    local h = hud
    if not h then return end
    
    local wasShown = hudShown
    
    -- Nama Area + warna
    if h.NameText then
        h.NameText.Text = '["' .. w.DisplayName .. ' Wall"]'
        if hudArea ~= w.AreaIndex then
            applyAreaColor(h.NameText, w.AreaIndex)
            hudArea = w.AreaIndex
        end
    end
    
    -- HP
    if h.HpText then
        h.HpText.Text = fmt(math.ceil(w.HP)) .. "/" .. fmt(w.MaxHP) .. " Hp"
    end
    if h.Fill then
        local size = UDim2.new(w.HP / w.MaxHP, 0, 1, 0)
        if wasShown then
            TweenService:Create(
            h.Fill,
            TweenInfo.new(0.15, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
            { Size = size }
            ):Play()
        else
            h.Fill.Size = size
        end
    end
    
    -- Slide dari atas ke posisi awal
    if not wasShown then
        hudShown = true
        h.Area.Visible = true
        
        if not h.Frame.Visible then
            h.Frame.Position = hudHiddenPosition(h.Position)
            h.Frame.Visible = true
        end
        
        TweenService:Create(
        h.Frame,
        TweenInfo.new(0.4, Enum.EasingStyle.Back, Enum.EasingDirection.Out),
        { Position = h.Position }
        ):Play()
    end
    
    -- 8 detik gak hit -> hilang
    hudToken += 1
    local token = hudToken
    task.delay(HUD_HIDE_AFTER, function()
        if token == hudToken then
            hideHud()
        end
    end)
end
 
----------------------------------------------------------------
-- PUKULAN
----------------------------------------------------------------
local function findHitWall(root)
    local flatLook = Vector3.new(root.CFrame.LookVector.X, 0, root.CFrame.LookVector.Z)
    if flatLook.Magnitude > 0 then
        flatLook = flatLook.Unit
    end
    
    local best, bestDist = nil, math.huge
    
    for _, w in ipairs(walls) do
        if w.Alive then
            -- titik terdekat dari Wall (bounding box) ke player
            local rel = w.CF:PointToObjectSpace(root.Position)
            local half = w.Size / 2
            local clamped = Vector3.new(
            math.clamp(rel.X, -half.X, half.X),
            math.clamp(rel.Y, -half.Y, half.Y),
            math.clamp(rel.Z, -half.Z, half.Z)
            )
            local nearest = w.CF:PointToWorldSpace(clamped)
            local delta = nearest - root.Position
            local dist = delta.Magnitude
            
            if dist <= WallConfig.HitRange and dist < bestDist then
                local flat = Vector3.new(delta.X, 0, delta.Z)
                local inFront = flat.Magnitude < 1 or flat.Unit:Dot(flatLook) > 0.3
                if inFront then
                    best, bestDist = w, dist
                end
            end
        end
    end
    
    return best
end
 
local function onImpact(tool)
    local char = player.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not root then return end
    
    local def = PickaxeConfig.ByName[tool.Name]
    local power = def and def.Power or 1
    
    local w = findHitWall(root)
    if not w then return end
    
    w.HP = math.max(0, w.HP - power)
    updateGui(w, true)
    showHud(w)
    
    if w.HP <= 0 then
        destroyWall(w)
    end
end
 
-- Server kirim "CameraShake" tiap pukulan mendarat (satu remote buat semua pickaxe)
local SwingRemote = ReplicatedStorage:WaitForChild("Configuration"):WaitForChild("PickaxeRemotes")
:WaitForChild("PickaxeSwing")
 
local function heldPickaxe()
    local char = player.Character
    if not char then return nil end
    
    for _, child in ipairs(char:GetChildren()) do
        if child:IsA("Tool") and child:GetAttribute("ShopPickaxe") then
            return child
        end
    end
    return nil
end
 
SwingRemote.OnClientEvent:Connect(function(action)
    if action == "CameraShake" then
        local tool = heldPickaxe()
        if tool then
            onImpact(tool)
        end
    end
end)

]]></ProtectedString>
