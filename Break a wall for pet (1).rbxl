<Item class="LocalScript" referent="RBXCE0869D075DF4A55B454100613AE4BA1">
<Properties>
<BinaryString name="AttributesSerialize"></BinaryString>
<bool name="Disabled">false</bool>
<Content name="LinkedSource"><null></null></Content>
<string name="Name">IndexClient</string>
<token name="RunContext">0</token>
<string name="ScriptGuid">{A7A2C6D1-8936-4D8F-A45D-9A2AE9525164}</string>
<ProtectedString name="Source"><![CDATA[-- LocalScript: StarterPlayer > StarterPlayerScripts > IndexClient
--
-- Tampilan Index (koleksi Pet).
--   IndexBTN        -> buka IndexFrame (animasi pop), Close -> tutup (animasi kebalikan)
--   Template (Main) -> diduplikat 1x per Area yang punya Pet di PetConfig
--   Icon            -> gambar Area dari IndexConfig, Icon > Text = nama Area (AreaDisplayConfig)
--   Pet > Template  -> diduplikat 1x per Pet di Area itu (warna sesuai Rarity)
--                      belum didapat: Name "???" & View hitam (siluet)
--   Bar             -> Text "1/4", Fill = progres, Reward = "Complete = x1.1 Sheckles Boost"
--                      kalau 4/4: Text "Complete Forest Area!"
--
-- GUI (di StarterGui):
-- MainGui > ... > IndexFrame
--   Main > Template (ImageLabel)
--            Bar (ImageLabel)  > Reward, Fill, Text
--            Icon (ImageLabel) > Text
--            Pet (Frame)       > Template (ImageLabel) > View (ViewportFrame), Name, Rarity
--   Top > Close
-- MainGui > ... > IndexBTN
--
-- Semua elemen dicari berdasarkan nama (di mana pun letaknya di MainGui),
-- jadi aman kalau susunan Frame di atas beda sedikit.
 
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local RunService = game:GetService("RunService")
 
local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")
 
local Configuration = ReplicatedStorage:WaitForChild("Configuration")
local Modules = Configuration:WaitForChild("Modules")
local IndexConfig = require(Modules:WaitForChild("Index"):WaitForChild("IndexConfig"))
local PetConfig = require(Modules:WaitForChild("Area"):WaitForChild("Pet"):WaitForChild("PetConfig"))
local AreaDisplayConfig = require(Modules:WaitForChild("Area"):WaitForChild("AreaDisplay"):WaitForChild("AreaDisplayConfig"))
local Remotes = Configuration:WaitForChild("IndexRemotes")
local UIEvent = Remotes:WaitForChild("IndexUI")
local ActionEvent = Remotes:WaitForChild("IndexAction")
local RarityFolder = Configuration:WaitForChild("Colors"):WaitForChild("Rarity")
local PetDisplay = ReplicatedStorage:WaitForChild("PetDisplay")
 
local Settings = IndexConfig.Settings
 
----------------------------------------------------------------
-- STATE
----------------------------------------------------------------
local discovered = {} -- [nama Pet] = true
local boost = 1
local ui = nil        -- GUI yang sedang ke-bind
local isOpen = false
local openToken = 0
local fills = {}      -- { Fill, Full (UDim2), Ratio }
local spinners = {}
 
local TILT = CFrame.Angles(math.rad(10), 0, 0)
 
----------------------------------------------------------------
-- HELPER
----------------------------------------------------------------
-- Tunggu elemen (cari di semua turunan) sampai ada
local function waitDeep(root, name, timeout)
    local obj = root:FindFirstChild(name, true)
    local waited = 0
    while not obj and waited < (timeout or 30) do
        task.wait(0.25)
        waited += 0.25
        obj = root:FindFirstChild(name, true)
    end
    if not obj then
        warn("IndexClient: '" .. name .. "' tidak ditemukan di " .. root:GetFullName())
    end
    return obj
end
 
-- Warna Rarity (UIGradient dari Colors > Rarity) ke sebuah GUI
local function applyRarity(target, rarityName)
    if not target or not rarityName then return end
 
    local source = RarityFolder:FindFirstChild(rarityName)
    if not source then
        warn("Rarity '" .. tostring(rarityName) .. "' tidak ada di Colors > Rarity")
        return
    end
 
    if source:IsA("UIGradient") then
        source:Clone().Parent = target
    else
        for _, child in ipairs(source:GetChildren()) do
            if child:IsA("UIGradient") then
                child:Clone().Parent = target
            end
        end
    end
end
 
-- Lebar Fill = progres langsung (0..1 dari lebar Bar), jadi Complete = {1, 0}, {Y template}
-- (Size Fill di Template TIDAK dipakai buat lebar; cuma tingginya yang diambil)
local function fillSize(full, ratio)
    return UDim2.new(ratio, 0, full.Y.Scale, full.Y.Offset)
end
 
local function fmtBoost(n)
    return string.format("%g", n)
end
 
local function fillText(template, values)
    return (template:gsub("{(%w+)}", function(key)
        return values[key] and tostring(values[key]) or ("{" .. key .. "}")
    end))
end
 
----------------------------------------------------------------
-- VIEWPORT (Pet 3D)
----------------------------------------------------------------
local function setupViewport(viewport, petName, known)
    if not viewport or not viewport:IsA("ViewportFrame") then return end
 
    local source = PetDisplay:FindFirstChild(petName)
    if not source then
        warn("IndexClient: model Pet '" .. petName .. "' tidak ada di ReplicatedStorage > PetDisplay")
        return
    end
 
    local model = source:Clone()
    for _, d in ipairs(model:GetDescendants()) do
        if d:IsA("BasePart") then
            d.Anchored = true
        end
    end
    model.Parent = viewport
 
    local cf, size = model:GetBoundingBox()
    model.WorldPivot = cf
    model:PivotTo(CFrame.new())
 
    local camera = Instance.new("Camera")
    camera.FieldOfView = 40
    local radius = size.Magnitude / 2
    local distance = radius / math.sin(math.rad(camera.FieldOfView / 2))
    camera.CFrame = CFrame.lookAt(Vector3.new(0, 0, distance), Vector3.zero)
    camera.Parent = viewport
    viewport.CurrentCamera = camera
 
    if known then
        viewport.ImageColor3 = Color3.new(1, 1, 1)
        viewport.Ambient = Color3.fromRGB(190, 190, 190)
        viewport.LightColor = Color3.fromRGB(255, 255, 255)
    else
        -- belum didapat: siluet hitam
        viewport.ImageColor3 = Color3.new(0, 0, 0)
        viewport.Ambient = Color3.new(0, 0, 0)
        viewport.LightColor = Color3.new(0, 0, 0)
    end
    viewport.LightDirection = Vector3.new(-1, -1, -1)
 
    table.insert(spinners, { Model = model, Viewport = viewport })
end
 
local angle = 0
RunService.RenderStepped:Connect(function(dt)
    if not ui or not ui.Frame.Visible then return end
 
    angle = (angle + dt * 1.5) % (math.pi * 2)
 
    for i = #spinners, 1, -1 do
        local s = spinners[i]
        if not s.Model.Parent or not s.Viewport:IsDescendantOf(playerGui) then
            table.remove(spinners, i)
        else
            s.Model:PivotTo(TILT * CFrame.Angles(0, angle, 0))
        end
    end
end)
 
----------------------------------------------------------------
-- BANGUN ISI INDEX
----------------------------------------------------------------
local function sortedAreas()
    local list = {}
    for areaIndex, pets in pairs(PetConfig.Areas) do
        if type(areaIndex) == "number" and type(pets) == "table" and #pets > 0 then
            table.insert(list, areaIndex)
        end
    end
    table.sort(list)
    return list
end
 
local function rebuild()
    local u = ui
    if not u then return end
 
    for _, child in ipairs(u.Main:GetChildren()) do
        if child:GetAttribute("IndexEntry") then
            child:Destroy()
        end
    end
    table.clear(spinners)
    table.clear(fills)
 
    u.Template.Visible = false
 
    for _, areaIndex in ipairs(sortedAreas()) do
        local pets = PetConfig.Areas[areaIndex]
        local areaCfg = IndexConfig.Areas[areaIndex]
        local display = AreaDisplayConfig[areaIndex]
        local areaName = display and display.Name or ("Area " .. areaIndex)
 
        if not areaCfg then
            warn("IndexConfig.Areas[" .. areaIndex .. "] belum ada (Icon & Boost Area ini kosong)")
        end
 
        local entry = u.Template:Clone()
        entry.Name = "Area" .. areaIndex
        entry.Visible = true
        entry.LayoutOrder = areaIndex
        entry:SetAttribute("IndexEntry", true)
 
        local bar = entry:FindFirstChild("Bar")
        local icon = entry:FindFirstChild("Icon")
        local petFrame = entry:FindFirstChild("Pet")
 
        -- Icon + nama Area
        if icon and areaCfg and areaCfg.Icon then
            icon.Image = areaCfg.Icon
        end
        local iconText = icon and icon:FindFirstChild("Text")
        if iconText then
            iconText.Text = areaName
        end
 
        -- Pet di Area ini
        local have, total = 0, #pets
        local petTemplate = petFrame and petFrame:FindFirstChild("Template")
 
        if petTemplate then
            petTemplate.Visible = false
 
            for i, def in ipairs(pets) do
                local known = discovered[def.Name] == true
                if known then
                    have += 1
                end
 
                local petEntry = petTemplate:Clone()
                petEntry.Name = def.Name
                petEntry.Visible = true
                petEntry.LayoutOrder = i
 
                local nameLabel = petEntry:FindFirstChild("Name")
                local rarityLabel = petEntry:FindFirstChild("Rarity")
                local view = petEntry:FindFirstChild("View")
 
                if nameLabel then
                    nameLabel.Text = known and def.Name or Settings.UnknownName
                end
                if rarityLabel then
                    rarityLabel.Text = def.Rarity
                end
 
                -- Background, Name & Rarity pakai warna Rarity
                applyRarity(petEntry, def.Rarity)
                applyRarity(nameLabel, def.Rarity)
                applyRarity(rarityLabel, def.Rarity)
 
                setupViewport(view, def.Name, known)
 
                petEntry.Parent = petFrame
            end
        else
            warn("IndexClient: Template Pet (Pet > Template) tidak ditemukan di Template Index")
            for _, def in ipairs(pets) do
                if discovered[def.Name] then
                    have += 1
                end
            end
        end
 
        -- Bar: progres & reward
        local complete = have >= total
        local ratio = total > 0 and math.clamp(have / total, 0, 1) or 0
 
        if bar then
            local barText = bar:FindFirstChild("Text")
            local reward = bar:FindFirstChild("Reward")
            local fill = bar:FindFirstChild("Fill")
 
            if barText then
                barText.Text = complete and fillText(Settings.CompleteText, { area = areaName })
                or (have .. "/" .. total)
            end
            if reward then
                reward.Text = fillText(Settings.RewardText, {
                boost = fmtBoost(areaCfg and areaCfg.Boost or 1),
                area = areaName,
                })
            end
            if fill then
                -- Fill mulai dari kiri Bar & membesar ke kanan
                fill.AnchorPoint = Vector2.new(0, fill.AnchorPoint.Y)
                fill.Position = UDim2.new(0, 0, fill.Position.Y.Scale, fill.Position.Y.Offset)
 
                local full = fill.Size
                fill.Size = fillSize(full, ratio)
                table.insert(fills, { Fill = fill, Full = full, Ratio = ratio })
            end
        end
 
        entry.Parent = u.Main
    end
end
 
----------------------------------------------------------------
-- BUKA / TUTUP (animasi)
----------------------------------------------------------------
local function playFills()
    for _, f in ipairs(fills) do
        if f.Fill.Parent then
            f.Fill.Size = fillSize(f.Full, 0)
            TweenService:Create(
            f.Fill,
            TweenInfo.new(0.6, Enum.EasingStyle.Quint, Enum.EasingDirection.Out),
            { Size = fillSize(f.Full, f.Ratio) }
            ):Play()
        end
    end
end
 
local function openIndex()
    local u = ui
    if not u or isOpen then return end
    isOpen = true
    openToken += 1
 
    u.Scale.Scale = 0
    u.Frame.Visible = true
    TweenService:Create(
    u.Scale,
    TweenInfo.new(0.4, Enum.EasingStyle.Back, Enum.EasingDirection.Out),
    { Scale = u.RestScale }
    ):Play()
 
    -- Bar terisi setelah frame hampir selesai muncul
    local token = openToken
    task.delay(0.2, function()
        if isOpen and openToken == token then
            playFills()
        end
    end)
end
 
local function closeIndex()
    local u = ui
    if not u or not isOpen then return end
    isOpen = false
    openToken += 1
 
    local token = openToken
    TweenService:Create(
    u.Scale,
    TweenInfo.new(0.25, Enum.EasingStyle.Back, Enum.EasingDirection.In),
    { Scale = 0 }
    ):Play()
 
    task.delay(0.27, function()
        if not isOpen and openToken == token then
            u.Frame.Visible = false
        end
    end)
end
 
----------------------------------------------------------------
-- BIND GUI
----------------------------------------------------------------
local function bindUI(mainGui)
    local frame = waitDeep(mainGui, "IndexFrame")
    local button = waitDeep(mainGui, "IndexBTN")
    if not frame or not button then return end
 
    local main = waitDeep(frame, "Main")
    local top = waitDeep(frame, "Top")
    local closeButton = top and top:FindFirstChild("Close") or waitDeep(frame, "Close")
    local template = main and main:FindFirstChild("Template")
    if not main or not template or not closeButton then
        warn("IndexClient: Main / Template / Close di IndexFrame belum lengkap")
        return
    end
 
    if main:IsA("ScrollingFrame") then
        main.AutomaticCanvasSize = Enum.AutomaticSize.Y
        main.CanvasSize = UDim2.new(0, 0, 0, 0)
    end
 
    local scale = frame:FindFirstChildOfClass("UIScale")
    local rest = 1
    if scale then
        rest = scale.Scale > 0 and scale.Scale or 1
    else
        scale = Instance.new("UIScale")
        scale.Parent = frame
    end
 
    template.Visible = false
    frame.Visible = false
    isOpen = false
 
    ui = {
    Frame = frame,
    Main = main,
    Template = template,
    Scale = scale,
    RestScale = rest,
    }
 
    button.Activated:Connect(function()
        if isOpen then
            closeIndex()
        else
            openIndex()
        end
    end)
    closeButton.Activated:Connect(closeIndex)
 
    rebuild()
    ActionEvent:FireServer("Sync")
end
 
----------------------------------------------------------------
-- EVENT DARI SERVER
----------------------------------------------------------------
UIEvent.OnClientEvent:Connect(function(action, data, newBoost)
    if action == "Sync" then
        discovered = type(data) == "table" and data or {}
        boost = tonumber(newBoost) or 1
        rebuild()
    end
end)
 
local existing = playerGui:FindFirstChild("MainGui")
if existing then
    task.spawn(bindUI, existing)
end
playerGui.ChildAdded:Connect(function(child)
    if child.Name == "MainGui" then
        task.spawn(bindUI, child)
    end
end)

]]></ProtectedString>
