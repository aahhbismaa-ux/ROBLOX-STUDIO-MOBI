<Item class="LocalScript" referent="RBXCE0869D075DF4A55B454100603AE4BA1">
<Properties>
<BinaryString name="AttributesSerialize"></BinaryString>
<bool name="Disabled">false</bool>
<Content name="LinkedSource"><null></null></Content>
<string name="Name">PetClient</string>
<token name="RunContext">0</token>
<string name="ScriptGuid">{A7A2C6D1-8936-4D8F-A45D-9A2AE9525164}</string>
<ProtectedString name="Source"><![CDATA[-- LocalScript: StarterPlayer > StarterPlayerScripts > PetClient
--
-- 1) Animasi Pet (JALAN + IDLE) untuk Pet dari script "PETS 150".
--    Semua Part Pet itu Anchored tanpa Motor6D, jadi animasinya procedural:
--    script ini mengenali bagian badan dari NAMA Part (Head, FrontLeftLeg, Tail, LeftEar, dst),
--    lalu menggerakkannya tiap frame di client. Server cuma ngirim "mau jalan ke mana & kapan"
--    lewat attribute, jadi ringan & semua player lihat gerakan yang sama.
-- 2) PetGui: warna Rarity diambil dari Colors > Rarity.
-- 4) Guard (Model "Guard" di tiap Area, tag "AreaGuard"): animasi Sleep / Run / Hit + goyang GuardGui.
-- 3) Pet yang lagi dibawa player (attribute CarrierId): diposisikan di atas kepala pembawa,
--    dengan animasi idle. Dihitung lokal di tiap client, jadi semua player lihat Pet-nya nempel.
 
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local CollectionService = game:GetService("CollectionService")
 
local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")
 
local Configuration = ReplicatedStorage:WaitForChild("Configuration")
local RarityFolder = Configuration:WaitForChild("Colors"):WaitForChild("Rarity")
 
local PetConfig = require(Configuration:WaitForChild("Modules"):WaitForChild("Area")
:WaitForChild("Pet"):WaitForChild("PetConfig"))
 
local TAG = "AreaPet"
local CARRY_Y = PetConfig.Settings.CarryHeight
local ANIM_RANGE = 130  -- di luar jarak ini pet gak dianimasiin
local NEAR_RANGE = 60   -- di dalam jarak ini update tiap frame, di luarnya tiap 3 frame
 
local CFnew, Ang, V3 = CFrame.new, CFrame.Angles, Vector3.new
local IDENT = CFrame.identity
local noise = math.noise
local pi = math.pi
 
local function rotAbout(p, rx, ry, rz)
    return CFnew(p) * Ang(rx, ry, rz) * CFnew(-p)
end
 
local function lerp(a, b, t)
    return a + (b - a) * t
end
 
----------------------------------------------------------------
-- WARNA RARITY (Colors > Rarity > <NamaRarity>)
----------------------------------------------------------------
local function applyRarity(target, rarityName)
    if not target or not rarityName then return end
 
    local source = RarityFolder:FindFirstChild(rarityName)
    if not source then
        warn("Rarity '" .. tostring(rarityName) .. "' tidak ada di Colors > Rarity")
        return
    end
 
    if source:IsA("UIGradient") then
        source:Clone().Parent = target
    else
        for _, child in ipairs(source:GetChildren()) do
            if child:IsA("UIGradient") then
                child:Clone().Parent = target
            end
        end
    end
end
 
----------------------------------------------------------------
-- DETEKSI JENIS BADAN (dari nama Part)
----------------------------------------------------------------
-- Q=4 kaki  H=2 kaki  B=burung  S=slime  I=serangga  K=ular  G=roh  R=robot
local function detectPlan(has)
    if has.FrontLeftLeg then return "Q" end
    if has.BodyLower and has.BodyMiddle then return "S" end
    if has.Abdomen then return "I" end
    if has.Body1 and has.Underside1 then return "K" end
    if has.WispUpper then return "G" end
    if has.ChestPanel then return "R" end
    if has.Breast then return "B" end
    if has.LeftArm and has.LeftLeg then return "H" end
    return "X"
end
 
local function estimateScale(plan, byName)
    local function ratio(name, axis, base)
        local e = byName[name]
        return e and (e.Size0[axis] / base) or 1
    end
    if plan == "Q" then return ratio("Body", "Y", 2.6)
    elseif plan == "H" then return ratio("Body", "Y", 3.2)
    elseif plan == "B" then return ratio("Body", "Y", 2.8)
    elseif plan == "S" then return ratio("BodyLower", "X", 4)
    elseif plan == "I" then return ratio("Abdomen", "Y", 2.0)
    elseif plan == "K" then return ratio("Head", "Y", 1.7)
    elseif plan == "G" then return ratio("Core", "X", 2.8)
    elseif plan == "R" then return ratio("Body", "X", 3)
    end
        return 1
    end
 
    local GAIT = { Q = 1, H = 1, B = 1.5, S = 0.8, I = 1.8, K = 0.9, G = 0.5, R = 1.1, X = 1 }
    local LEG = {
    Q = { amp = 0.55, lift = 0.2 },
    H = { amp = 0.55, lift = 0.22 },
    R = { amp = 0.42, lift = 0.18 },
    B = { amp = 0.6, lift = 0.18 },
    }
    local ARM = { H = 0.5, R = 0.38 }
 
    ----------------------------------------------------------------
    -- KLASIFIKASI PART -> LIMB (anggota badan)
    ----------------------------------------------------------------
    local function set(list)
        local s = {}
        for _, v in ipairs(list) do s[v] = true end
        return s
    end
 
    local HEAD_EXACT = set({
    "Head", "Snout", "Nose", "Mouth", "Beak", "BeakStripe", "UpperBeak", "LowerBeak", "Visor",
    "MouthGrille", "ForeheadGem", "Comb", "Wattle", "Frill", "FrillKnob", "CrownBase", "CrownPoint",
    "CrownGem", "NoseHorn", "UnicornHornA", "UnicornHornB", "UnicornHornC", "Hood", "HoodMark",
    "HoodEdgeLeft", "HoodEdgeRight", "ManeBack", "ManeTop", "WoolHead", "Helmet", "HelmetBand",
    "HelmetCrest", "BowKnot", "BowLeft", "BowRight", "HeadStripe", "CrestCenter", "PartyHatBase",
    "PartyHatMid", "PartyHatUpper", "PartyPom", "CapBrim", "CapTop", "CapKnob", "TrunkBase",
    "TrunkMid", "TrunkTip",
    })
    local HEAD_CONTAINS = {
    "Eye", "Horn", "Antler", "Tusk", "Fang", "Cheek", "ManeSide", "HeadLeaf", "CapDot",
    "CrestFeather", "EarTuft", "EarBolt",
    }
 
    local function isHeadName(n)
        if HEAD_EXACT[n] then return true end
        if n:sub(1, 3) == "Fan" then return false end -- mata bulu merak bukan bagian kepala
            for _, s in ipairs(HEAD_CONTAINS) do
                if n:find(s, 1, true) then return true end
            end
            return false
        end
 
        -- return kind, key, info
        local function classify(plan, e, model)
            local n = e.Name
            local part = e.Part
 
            if n:sub(1, 7) == "Effect_" or n == "GuiAnchor" or n == "PromptAnchor" then
                return "root", "root"
            end
 
            -- Sub-model beranimasi dari script PETS 150 (sayap / halo / orbit)
            if part.Parent ~= model then
                local anim = part.Parent:GetAttribute("Anim")
                if anim then
                    return anim, part.Parent, {
                    side = part.Parent:GetAttribute("Side") or 1,
                    pivot = part.Parent,
                    }
                end
                return "body", "body"
            end
 
            local side = (n:sub(1, 4) == "Left" and -1) or (n:sub(1, 5) == "Right" and 1) or 0
 
            if plan == "Q" then
                local pfx, sd, role = n:match("^(%u%l+)(%u%l+)(%u%l+)$")
                if (pfx == "Front" or pfx == "Back") and (sd == "Left" or sd == "Right") and (role == "Leg" or role == "Paw") then
                    local s = (sd == "Left") and -1 or 1
                    local odd = ((pfx == "Front" and 1 or 0) + (s == -1 and 1 or 0)) % 2
                    return "leg", pfx .. sd, { def = (role == "Leg"), side = s, off = (odd == 0) and 0 or pi, front = (pfx == "Front") }
                end
 
            elseif plan == "H" or plan == "R" or plan == "B" then
                if n == "LeftLeg" or n == "RightLeg" or n == "LeftFoot" or n == "RightFoot" then
                    return "leg", "leg" .. side, { def = n:sub(-3) == "Leg", side = side, off = (side == -1) and 0 or pi }
                end
                if plan ~= "B" and (n == "LeftArm" or n == "RightArm" or n == "LeftHand" or n == "RightHand"
                    or n == "LeftShoulder" or n == "RightShoulder") then
                    return "arm", "arm" .. side, { def = n:find("Arm") ~= nil, side = side, off = (side == -1) and pi or 0 }
                end
                if plan == "B" and (n == "LeftWing" or n == "RightWing" or n == "LeftWingTip" or n == "RightWingTip") then
                    return "swing", "wing" .. side, { def = n:find("Tip") == nil, side = side }
                end
                if plan == "R" and (n == "Antenna" or n == "AntennaBall") then
                    return "antennaR", "antenna", { def = n == "Antenna" }
                end
 
            elseif plan == "S" then
                if n == "LeftFoot" or n == "RightFoot" or n == "LeftNub" or n == "RightNub" then
                    return "slimeSide", "side"
                end
                if n == "BodyLower" or n == "BodyMiddle" or n == "BodyTop" or n == "Gloss" or n == "GlossSmall" then
                    e.Resize = true
                end
                return "slimeBody", "slimeBody"
 
            elseif plan == "I" then
                local sd, role, idx = n:match("^(%u%l+)Leg(%u%l+)(%d)$")
                if sd and (role == "Upper" or role == "Lower") then
                    local s = (sd == "Left") and -1 or 1
                    local i = tonumber(idx)
                    return "iLeg", sd .. idx, { def = role == "Upper", side = s, off = ((((s == -1) and 1 or 0) + i) % 2 == 0) and 0 or pi }
                end
                if n:find("Antenna", 1, true) then
                    return "antenna", "ant" .. side, { def = n:find("Tip") == nil, side = side }
                end
 
            elseif plan == "K" then
                local i = n:match("^Body(%d+)$") or n:match("^Underside(%d+)$") or n:match("^Spot(%d+)$")
                if i then
                    return "seg", tonumber(i), { idx = tonumber(i), def = n:find("^Body") ~= nil }
                end
                if n == "Tongue" or n == "TongueFork" then
                    return "tongue", "tongue"
                end
 
            elseif plan == "G" then
                if n == "WispUpper" then return "wisp", n, { idx = 1 } end
                if n == "WispMiddle" then return "wisp", n, { idx = 2 } end
                if n == "WispTip" then return "wisp", n, { idx = 3 } end
                if n == "CoreCrystal" then return "crystal", "crystal" end
            end
 
            -- Ekor
            if n:find("^ExtraTail") then
                local idx = tonumber(n:match("(%-?%d+)$")) or 0
                return "etail", "etail" .. idx, { def = n:find("^ExtraTailTip") == nil, idx = idx }
            end
            if n:find("^Tail") then
                return "tail", e, {}
            end
 
            -- Kepala & telinga (slime/roh gak punya kepala)
            if plan ~= "S" and plan ~= "G" then
                if isHeadName(n) then
                    return "head", "head"
                end
                if n:find("Ear", 1, true) then
                    return "ear", n:gsub("Inner", ""), { def = n:find("Inner") == nil, side = side }
                end
            end
 
            return "body", "body"
        end
 
        ----------------------------------------------------------------
        -- BUILD RIG
        ----------------------------------------------------------------
        local function buildRig(model)
            local base = model:GetPivot()
 
            local entries, byName = {}, {}
            for _, d in ipairs(model:GetDescendants()) do
                if d:IsA("BasePart") then
                    local rel = base:ToObjectSpace(d.CFrame)
                    if d.Name == "PromptAnchor" then
                        -- Server menggeser PromptAnchor ngikutin Pet jalan, jadi posisinya sekarang BUKAN
                        -- posisi awal. Posisi relatif yang bener selalu: tengah badan Pet.
                        rel = CFnew(0, (model:GetAttribute("PetHeight") or 4) / 2, 0)
                    end
                    local e = { Part = d, Name = d.Name, Rel = rel, Size0 = d.Size }
                    table.insert(entries, e)
                    if not byName[d.Name] then
                        byName[d.Name] = e
                    end
                end
            end
            if #entries == 0 then return nil end
 
            local plan = detectPlan(byName)
            local sc = math.max(0.3, estimateScale(plan, byName))
 
            local rig = {
            Model = model,
            Plan = plan,
            sc = sc,
            seed = math.random() * 90 + 3.3,
            w = 0, ph = 0, fp = 0,
            yaw = model:GetAttribute("Yaw") or 0,
            acc = 0, tick = 0,
            ctx = {},
            nextBlink = os.clock() + 2 + math.random() * 4,
            sleepBlend = 0,  -- 0 = bangun, 1 = tidur (Guard)
            intensity = 1,   -- 1 = jalan biasa, ~1.6 = lari kencang (Guard)
            cr = 0,
            }
 
            local headE = byName.Head
            rig.headPos = headE and headE.Rel.Position or V3()
            rig.headPivot = headE and (headE.Rel.Position + V3(0, -headE.Size0.Y * 0.35, headE.Size0.Z * 0.4)) or V3()
 
            local bodyE = byName.Body or byName.BodyLower or byName.Core or byName.Thorax or byName.Body1
            rig.bodyPivot = bodyE and bodyE.Rel.Position or V3(0, 3 * sc, 0)
 
            local tailE = byName.Tail or byName.TailFeather
            rig.tailPivot = tailE and (tailE.Rel.Position + V3(0, 0, -tailE.Size0.Z / 2)) or nil
 
            -- kelompokkan Part -> limb
            local limbs, limbMap = {}, {}
            local function getLimb(kind, key)
                limbMap[kind] = limbMap[kind] or {}
                local l = limbMap[kind][key]
                if not l then
                    l = { kind = kind, key = key, parts = {} }
                    limbMap[kind][key] = l
                    table.insert(limbs, l)
                end
                return l
            end
 
            for _, e in ipairs(entries) do
                local kind, key, info = classify(plan, e, model)
                local l = getLimb(kind, key)
                table.insert(l.parts, e)
 
                if info then
                    for k, v in pairs(info) do
                        if k == "def" then
                            if v then l.pivotPart = e end
                        elseif k == "pivot" then
                            l.pivot = base:ToObjectSpace(v:GetPivot()).Position
                        else
                            l[k] = v
                        end
                    end
                end
            end
 
            -- pivot & parameter tiap limb
            for _, l in ipairs(limbs) do
                local k = l.kind
                local pp = l.pivotPart or l.parts[1]
                local pos, sz = pp.Rel.Position, pp.Size0
 
                if k == "leg" then
                    l.pivot = pos + V3(0, sz.Y / 2, 0)
                    l.amp, l.lift = LEG[plan].amp, LEG[plan].lift
                elseif k == "arm" then
                    l.pivot = pos + V3(0, sz.Y / 2, 0)
                    l.amp = ARM[plan] or 0.4
                elseif k == "swing" then
                    l.pivot = pos + V3(0, sz.Y / 2, 0)
                elseif k == "ear" then
                    l.hang = (pos.Y - rig.headPos.Y) < 0.6 * sc
                    l.pivot = l.hang and (pos + V3(0, sz.Y / 2, 0)) or (pos - V3(0, sz.Y / 2, 0))
                elseif k == "tail" then
                    l.pivot = rig.tailPivot or pos
                    l.lag = math.abs(pos.Z - l.pivot.Z) / sc
                elseif k == "etail" then
                    l.pivot = pos - V3(0, sz.Y / 2, 0)
                elseif k == "iLeg" then
                    l.pivot = V3(pos.X - l.side * sz.X / 2, pos.Y, pos.Z)
                elseif k == "antenna" or k == "antennaR" then
                    l.pivot = pos - V3(0, sz.Y / 2, 0)
                elseif k == "seg" or k == "wisp" or k == "crystal" then
                    l.pivot = pos
                end
            end
 
            -- ratakan ke array (untuk BulkMoveTo)
            local parts, rels, slimeParts = {}, {}, {}
            for _, l in ipairs(limbs) do
                if l.kind == "slimeBody" then
                    for _, e in ipairs(l.parts) do
                        e.Rot = e.Rel.Rotation
                        table.insert(slimeParts, e)
                    end
                else
                    l.first = #parts + 1
                    for _, e in ipairs(l.parts) do
                        table.insert(parts, e.Part)
                        table.insert(rels, e.Rel)
                    end
                    l.last = #parts
                end
                if l.kind == "tongue" then
                    rig.tongue = l
                end
            end
 
            rig.limbs, rig.parts, rig.rels, rig.slimeParts = limbs, parts, rels, slimeParts
            rig.cfs = table.create(#parts, CFrame.identity)
 
            -- mata (kedip)
            rig.eyes = {}
            for _, e in ipairs(entries) do
                if e.Name == "LeftEye" or e.Name == "RightEye" then
                    local shine = byName[e.Name .. "Shine"]
                    table.insert(rig.eyes, {
                    Part = e.Part,
                    Size0 = e.Size0,
                    Shine = shine and shine.Part or nil,
                    ShineT = shine and shine.Part.Transparency or 0,
                    })
                end
            end
 
            return rig
        end
 
        ----------------------------------------------------------------
        -- DRIVER: gerak badan utama per jenis (jalan + idle)
        ----------------------------------------------------------------
        local function drive(rig, t, dt)
            local c = rig.ctx
            local plan, w, ph, sc, seed = rig.Plan, rig.w, rig.ph, rig.sc, rig.seed
            local idle = 1 - w
            local sl = rig.sleepBlend or 0              -- tidur (Guard)
            local inten = rig.intensity or 1            -- lari kencang (Guard)
            local runAmt = math.clamp((inten - 1) / 0.6, 0, 1)
            local bob, pitch, roll, twist, headFwd, headDrop, neckDrop = 0, 0, 0, 0, 0, 0, 0
 
            -- progres Hit (Guard): rear = mundur/angkat badan, lunge = menerjang
            local rear, lunge = 0, 0
            if rig.hitU then
                local u = rig.hitU
                local windup = math.clamp(u / 0.35, 0, 1)
                local strike = math.clamp((u - 0.35) / 0.15, 0, 1)
                local recover = math.clamp((u - 0.5) / 0.5, 0, 1)
                rear = windup * (1 - strike)
                lunge = strike * (1 - recover)
            end
            c.rear, c.lunge, c.sl = rear, lunge, sl
 
            -- gerak sayap (kepak) ikut kecepatan
            rig.fp += dt * (3 + 5 * w)
            rig.cr = (rig.cr or 0) + dt * (1 - 0.8 * sl)
            c.flap = math.max(0, noise(t * 0.45, seed + 11, 0.3) - 0.2) * 3 + w * 0.15
 
            -- kepala: lihat-lihat waktu idle, nunduk kecil pas jalan
            local hy = noise(t * 0.35, seed, 0.5) * 1.2 * (1 - 0.7 * w)
            local hp = noise(t * 0.5, seed + 7, 0.5) * 0.4 + math.sin(2 * ph) * 0.06 * w
            local hr = noise(t * 0.4, seed + 13, 0.5) * 0.15
 
            if plan == "Q" then
                bob = math.abs(math.sin(ph)) * 0.16 * sc * w * inten + math.sin(t * 2.2) * 0.035 * sc * idle
                roll = math.sin(ph) * 0.05 * w
                pitch = math.cos(2 * ph) * 0.025 * w + math.sin(t * 1.1) * 0.012 * idle - 0.16 * runAmt
                -- tidur: badan turun, kaki dilipat
                bob = bob * (1 - sl) - 1.55 * sc * sl + math.sin(t * 1.6) * 0.05 * sc * sl
                -- hit: badan terangkat lalu menerjang
                pitch += 0.4 * rear - 0.3 * lunge
            elseif plan == "H" then
                bob = math.abs(math.sin(ph)) * 0.2 * sc * w * inten + math.sin(t * 2) * 0.04 * sc * idle
                roll = math.sin(ph) * 0.06 * w + math.sin(t * 0.8 + seed) * 0.02 * idle
                twist = math.sin(ph) * 0.08 * w
                pitch = -0.12 * runAmt
                bob = bob * (1 - sl) - 1.9 * sc * sl + math.sin(t * 1.6) * 0.05 * sc * sl
                pitch += -0.3 * sl + 0.3 * rear - 0.4 * lunge
            elseif plan == "B" then
                bob = math.abs(math.sin(ph)) * 0.3 * sc * w * inten + math.sin(t * 2.6) * 0.03 * sc * idle
                pitch = -0.05 * w - 0.15 * runAmt
                headFwd = -math.sin(ph) * 0.25 * sc * w
                hp -= (math.max(0, math.sin(t * 0.9 + seed * 7)) ^ 10) * 0.7 * (1 - sl) -- matuk
                bob = bob * (1 - sl) - 1.3 * sc * sl + math.sin(t * 1.8) * 0.04 * sc * sl
                headFwd = headFwd * (1 - sl) + 0.5 * sc * sl - lunge * sc
                pitch += 0.25 * rear - 0.3 * lunge
            elseif plan == "R" then
                bob = math.abs(math.sin(ph)) * 0.12 * sc * w * inten + math.sin(t * 5) * 0.01 * sc * idle
                twist = math.sin(ph) * 0.07 * w
                roll = math.sin(ph) * 0.03 * w
                pitch = -0.1 * runAmt
                hy = math.sin(t * 0.7 + seed) * 0.6 * idle
                hp *= 0.4
                bob = bob * (1 - sl) - 1.6 * sc * sl
                pitch += -0.25 * sl + 0.3 * rear - 0.4 * lunge
            elseif plan == "I" then
                bob = math.abs(math.sin(ph * 2)) * 0.06 * sc * w * inten + math.sin(t * 3) * 0.03 * sc * (1 - sl)
                roll = math.sin(ph * 2) * 0.04 * w
                pitch = -0.1 * runAmt
                bob += -0.8 * sc * sl + math.sin(t * 1.4) * 0.03 * sc * sl
                pitch += 0.5 * rear - 0.4 * lunge
            elseif plan == "G" then
                bob = (0.3 * (1 - sl) + 0.05 * sl) * sc + math.sin(t * 2.1) * 0.3 * sc * (1 - 0.7 * sl)
                pitch = -0.12 * w - 0.1 * runAmt + 0.3 * rear - 0.5 * lunge
                roll = math.sin(t * 1.3) * 0.04
            elseif plan == "S" then
                local h = math.abs(math.sin(ph * 0.5))
                local g = 1 - h
                local sy = 1 + 0.12 * h * w - 0.2 * (g ^ 3) * w + math.sin(t * 2.4) * 0.04 * idle
                sy = sy * (1 - sl) + (0.78 + math.sin(t * 1.5) * 0.04) * sl -- tidur: gepeng + napas
                sy = sy - 0.3 * rear + 0.3 * lunge                          -- hit: jongkok lalu melompat
                c.sy = sy
                c.sxz = 1 + (1 - sy) * 0.6
                c.lift = h * 1.2 * sc * w * inten * (1 - sl) + lunge * 1.6 * sc
            elseif plan == "K" then
                c.k = ph * 0.8 + t * 1.1
                c.amp = (0.18 + 0.4 * w * inten) * sc * (1 - 0.7 * sl)
                local show = (t % 2.6) < 0.4
                c.tongueShow = show
                c.tongueExt = show and 0.5 * sc or 0
                hy = math.sin(c.k + 0.8) * 0.35
                hp = math.sin(t * 1.3) * 0.12
                neckDrop = 1.4 * sc * sl          -- tidur: leher turun, kepala di tanah
                headDrop = 0.9 * sc * sl
                headFwd = -lunge * 1.4 * sc       -- hit: patukan
                pitch += 0.3 * rear - 0.2 * lunge
            else
                bob = math.sin(t * 2) * 0.03 * sc
            end
 
            -- kepala: tertunduk saat tidur, terangkat lalu menunduk menggigit saat hit
            hy = hy * (1 - sl)
            hr = hr * (1 - sl)
            hp = hp * (1 - sl) - 0.75 * sl + 0.45 * rear - 0.5 * lunge
 
            c.bobT = CFnew(0, bob, 0)
            c.bodyT = c.bobT * CFnew(0, -neckDrop, 0) * rotAbout(rig.bodyPivot, pitch, twist, roll)
            c.headT = c.bodyT * CFnew(0, -headDrop, headFwd) * rotAbout(rig.headPivot, hp, hy - twist * 0.5, hr)
        end
 
        local function evalLimb(rig, l, c, t)
            local k = l.kind
            local w, ph, sc, seed = rig.w, rig.ph, rig.sc, rig.seed
            local sl, rear, lunge = c.sl or 0, c.rear or 0, c.lunge or 0
            local inten = rig.intensity or 1
 
            if k == "root" then
                return IDENT
            elseif k == "body" then
                return c.bodyT
            elseif k == "head" then
                return c.headT
 
            elseif k == "leg" then
                local ang = l.amp * inten * math.sin(ph + l.off) * w
                local lift = math.max(0, math.cos(ph + l.off)) * l.lift * sc * w
                if l.front ~= nil then
                    -- 4 kaki: tidur = kaki dilipat di tanah, hit = kaki depan terangkat
                    ang = ang * (1 - sl) + (l.front and 1.45 or -1.45) * sl + (l.front and rear or 0)
                else
                    -- 2 kaki: tidur = duduk (kaki ke depan)
                    ang = ang * (1 - sl) + (rig.Plan == "B" and 1.1 or 1.4) * sl
                end
                lift = lift * (1 - sl)
                return c.bobT * CFnew(0, lift, 0) * rotAbout(l.pivot, ang, 0, 0)
 
            elseif k == "arm" then
                local base = l.amp * inten * math.sin(ph + l.off) * w + math.sin(t * 1.6 + l.side) * 0.05 * (1 - w)
                -- tidur: tangan lemas ke depan, hit: diangkat tinggi lalu dihantam
                local ang = base * (1 - sl) + 0.35 * sl + 2.6 * rear + 0.7 * lunge
                return c.bodyT * rotAbout(l.pivot, ang, 0, 0)
 
            elseif k == "swing" then
                local ang = 0.06 + math.sin(t * 1.7 + seed) * 0.03 + c.flap * math.sin(t * 24) * 0.7
                ang = ang * (1 - 0.85 * sl) + (rear + lunge) * 0.8
                return c.bodyT * rotAbout(l.pivot, 0, 0, l.side * ang)
 
            elseif k == "ear" then
                local twitch = math.max(0, noise(t * 1.2 + seed, l.side * 3.1, 0.2) - 0.18) * 3
                local out = 0.04 + math.sin(t * 1.3 + seed + l.side) * 0.04
                + w * 0.12 * math.sin(2 * ph + l.side) + twitch * math.sin(t * 38) * 0.18 + sl * 0.3
                local roll = (l.hang and l.side or -l.side) * out
                local flop = l.hang and (w * 0.1 * math.sin(2 * ph + 0.6 * l.side) + runAmtFlop(rig)) or 0
                return c.headT * rotAbout(l.pivot, flop, 0, roll)
 
            elseif k == "tail" then
                local amp = (0.2 + 0.12 * w + 0.1 * (inten - 1)) * (0.5 + 0.2 * l.lag) * (1 - 0.7 * sl) + lunge * 0.3
                local ang = math.sin(t * (2.4 + 2 * w) - l.lag * 0.2) * amp
                return c.bodyT * rotAbout(l.pivot, 0, ang, 0)
 
            elseif k == "etail" then
                local roll = (math.sin(t * 2.2 + l.idx) * 0.12 + w * 0.1 * math.sin(ph + l.idx)) * (1 - 0.7 * sl)
                return c.bodyT * rotAbout(l.pivot, 0, 0, roll)
 
            elseif k == "flap" then
                local amp = lerp(0.10, 0.32, w) * inten * (1 - 0.7 * sl)
                local ang = l.side * (math.sin(rig.fp) * amp - 0.9 * sl + 0.6 * rear)
                return c.bodyT * rotAbout(l.pivot, 0, 0, ang)
 
            elseif k == "spin" then -- halo
                return c.headT * CFnew(0, math.sin(t * 2.5) * 0.12 * sc, 0) * rotAbout(l.pivot, 0, t * 1.2, 0)
 
            elseif k == "spinr" then -- orbit
                return c.bodyT * rotAbout(l.pivot, 0, -t * 1.6, 0)
 
            elseif k == "iLeg" then
                local ang = 0.5 * inten * math.sin(ph + l.off) * w
                local lift = math.max(0, math.cos(ph + l.off)) * 0.25 * sc * w + 0.8 * sc * sl
                return c.bobT * CFnew(0, lift, 0) * rotAbout(l.pivot, 0, ang, 0)
 
            elseif k == "antenna" then
                return c.headT * rotAbout(l.pivot,
                math.sin(t * 2.3 + l.side) * 0.1 + 0.6 * sl,
                0,
                math.sin(t * 1.7 + l.side * 2) * 0.15 + w * 0.1 * math.sin(ph * 2))
 
            elseif k == "antennaR" then
                return c.headT * rotAbout(l.pivot,
                math.sin(t * 3.1) * 0.08 + w * 0.12 * math.sin(2 * ph) + 0.7 * sl,
                0,
                math.sin(t * 2.2) * 0.12)
 
            elseif k == "seg" then
                local i = l.idx
                local f = 0.2 + i * 0.1
                local dx = c.amp * f * math.sin(c.k - i * 0.8)
                local yaw = c.amp * 0.25 * f * math.cos(c.k - i * 0.8)
                return c.bobT * CFnew(dx, 0, 0) * rotAbout(l.pivot, 0, yaw, 0)
 
            elseif k == "tongue" then
                return c.headT * CFnew(0, 0, -c.tongueExt)
 
            elseif k == "wisp" then
                return c.bodyT * CFnew(
                math.sin(t * 2.6 - l.idx * 0.9) * 0.3 * l.idx * sc * (1 - 0.6 * sl),
                math.sin(t * 3.1 - l.idx) * 0.08 * sc,
                (0.15 + 0.5 * w + 0.4 * lunge) * l.idx * sc)
 
            elseif k == "crystal" then
                return c.bodyT * rotAbout(l.pivot, 0, rig.cr, 0)
 
            elseif k == "slimeSide" then
                return CFnew(0, c.lift, 0)
            end
 
            return c.bodyT
        end
 
        -- telinga terkulai sedikit pas lari kencang
        function runAmtFlop(rig)
            return math.clamp(((rig.intensity or 1) - 1) / 0.6, 0, 1) * 0.3
        end
 
        local function setEyes(rig, closed)
            if rig.eyesClosed == closed then return end
            rig.eyesClosed = closed
 
            for _, eye in ipairs(rig.eyes) do
                if closed then
                    eye.Part.Size = V3(eye.Size0.X, eye.Size0.Y * 0.15, eye.Size0.Z)
                    if eye.Shine then eye.Shine.Transparency = 1 end
                else
                    eye.Part.Size = eye.Size0
                    if eye.Shine then eye.Shine.Transparency = eye.ShineT end
                end
            end
        end
 
        local function updateBlink(rig, now)
            if #rig.eyes == 0 then return end
 
            -- lagi tidur: mata tertutup terus
            if (rig.sleepBlend or 0) > 0.6 then
                rig.blinkEnd = nil
                setEyes(rig, true)
                return
            end
 
            if rig.blinkEnd then
                if now >= rig.blinkEnd then
                    rig.blinkEnd = nil
                    rig.nextBlink = now + 2.5 + math.random() * 3.5
                    setEyes(rig, false)
                end
            elseif now >= rig.nextBlink then
                rig.blinkEnd = now + 0.14
                setEyes(rig, true)
            elseif rig.eyesClosed then
                setEyes(rig, false)
            end
        end
 
        local function applyPose(rig, poseCF, t, now)
            local c = rig.ctx
            local rels, cfs = rig.rels, rig.cfs
 
            for _, l in ipairs(rig.limbs) do
                if l.kind ~= "slimeBody" then
                    local T = poseCF * evalLimb(rig, l, c, t)
                    for i = l.first, l.last do
                        cfs[i] = T * rels[i]
                    end
                end
            end
 
            if #rig.parts > 0 then
                workspace:BulkMoveTo(rig.parts, cfs, Enum.BulkMoveMode.FireCFrameChanged)
            end
 
            -- Slime: squash & stretch
            if rig.Plan == "S" then
                local sy, sxz, lift = c.sy, c.sxz, c.lift
                for _, e in ipairs(rig.slimeParts) do
                    local rp = e.Rel.Position
                    e.Part.CFrame = poseCF * (CFnew(rp.X * sxz, rp.Y * sy + lift, rp.Z * sxz) * e.Rot)
                    if e.Resize then
                        e.Part.Size = V3(e.Size0.X * sxz, e.Size0.Y * sy, e.Size0.Z * sxz)
                    end
                end
            end
 
            -- Ular: lidah menjulur sebentar-sebentar
            if rig.tongue and c.tongueShow ~= rig.tongueShown then
                rig.tongueShown = c.tongueShow
                for _, e in ipairs(rig.tongue.parts) do
                    e.Part.Transparency = c.tongueShow and 0 or 1
                end
            end
 
            updateBlink(rig, now)
        end
 
        ----------------------------------------------------------------
        -- REGISTRY & LOOP
        ----------------------------------------------------------------
        local pets = {}
 
        local function setupGui(model)
            local gui = model:WaitForChild("PetGui", 10)
            if not gui then return end
 
            applyRarity(gui:FindFirstChild("Rarity"), model:GetAttribute("Rarity"))
 
            -- Pindah ke PlayerGui (Adornee tetap ke pet) biar LocalScript warna ikut jalan
            gui.Parent = playerGui
 
            model.AncestryChanged:Connect(function()
                if not model:IsDescendantOf(workspace) then
                    gui:Destroy()
                end
            end)
        end
 
        local function register(model)
            if pets[model] then return end
            if not model:WaitForChild("GuiAnchor", 10) then return end
            if pets[model] then return end
 
            local rig = buildRig(model)
            if not rig then return end
 
            pets[model] = rig
            task.spawn(setupGui, model)
        end
 
        CollectionService:GetInstanceAddedSignal(TAG):Connect(function(model)
            task.spawn(register, model)
        end)
        CollectionService:GetInstanceRemovedSignal(TAG):Connect(function(model)
            pets[model] = nil
        end)
        for _, model in ipairs(CollectionService:GetTagged(TAG)) do
            task.spawn(register, model)
        end
 
        local function getMotion(model, serverNow)
            local from = model:GetAttribute("MoveFrom")
            local to = model:GetAttribute("MoveTo")
            if not from or not to then return nil end
 
            local dur = model:GetAttribute("MoveDur") or 0
            local start = model:GetAttribute("MoveStart") or serverNow
 
            if dur > 0 then
                local a = math.clamp((serverNow - start) / dur, 0, 1)
                if model:GetAttribute("Fall") then
                    -- jatuh: makin lama makin cepat, bukan animasi jalan
                    a = a * a
                    return from:Lerp(to, a), false, 0
                end
                return from:Lerp(to, a), a < 1, (to - from).Magnitude / dur
            end
            return to, false, 0
        end
 
        -- Pet yang dibawa: titik di atas kepala pembawa + arah hadapnya
        local function carryTarget(carrierId, footOffset)
            local plr = Players:GetPlayerByUserId(carrierId)
            local char = plr and plr.Character
            local root = char and char:FindFirstChild("HumanoidRootPart")
            if not root then return nil end
 
            local look = root.CFrame.LookVector
            local yaw = math.atan2(-look.X, -look.Z)
            return root.Position + Vector3.new(0, CARRY_Y + footOffset, 0), yaw
        end
 
        ----------------------------------------------------------------
        -- GUARD (Model "Guard" di tiap Area, tag "AreaGuard")
        -- Server ngirim posisi/kecepatan/state lewat attribute (GuardPos, GuardVel, GuardT,
        -- GuardState, Yaw); client yang nganimasiin (Sleep / Run / Hit) & ngegoyangin GuardGui.
        ----------------------------------------------------------------
        local guardGuis = {} -- [model] = { Sleep = ImageLabel, Run = ImageLabel }
 
        local function guardMotion(model, rig, serverNow, dt)
            local p = model:GetAttribute("GuardPos")
            if not p then return nil end
 
            local v = model:GetAttribute("GuardVel") or Vector3.zero
            local t0 = model:GetAttribute("GuardT") or serverNow
            local target = p + v * math.clamp(serverNow - t0, 0, 0.3)
 
            if not rig.gpos then
                rig.gpos = target
            end
            rig.gpos = rig.gpos:Lerp(target, 1 - math.exp(-dt * 14))
 
            local sp = v.Magnitude
            return rig.gpos, sp > 0.5, sp
        end
 
        local function registerGuard(model)
            if pets[model] then return end
            if not model:WaitForChild("GuiAnchor", 10) then return end
            if pets[model] then return end
 
            local rig = buildRig(model)
            if not rig then return end
 
            rig.IsGuard = true
            pets[model] = rig
 
            task.spawn(function()
                local gui = model:WaitForChild("GuardGui", 10)
                if gui then
                    guardGuis[model] = { Sleep = gui:FindFirstChild("Sleep"), Run = gui:FindFirstChild("Run") }
                end
            end)
        end
 
        CollectionService:GetInstanceAddedSignal("AreaGuard"):Connect(function(model)
            task.spawn(registerGuard, model)
        end)
        for _, model in ipairs(CollectionService:GetTagged("AreaGuard")) do
            task.spawn(registerGuard, model)
        end
 
        -- "goyang goyang": Sleep pelan, Run cepat
        RunService.RenderStepped:Connect(function()
            local now = os.clock()
            for model, g in pairs(guardGuis) do
                if not model.Parent then
                    guardGuis[model] = nil
                else
                    if g.Sleep then g.Sleep.Rotation = math.sin(now * 3) * 8 end
                    if g.Run then g.Run.Rotation = math.sin(now * 16) * 14 end
                end
            end
        end)
 
        RunService.RenderStepped:Connect(function(dt)
            local cam = workspace.CurrentCamera
            if not cam then return end
 
            local camPos = cam.CFrame.Position
            local serverNow = workspace:GetServerTimeNow()
            local now = os.clock()
 
            for model, rig in pairs(pets) do
                if not model.Parent then
                    pets[model] = nil
                else
                    local pos, moving, speed
                    if rig.IsGuard then
                        pos, moving, speed = guardMotion(model, rig, serverNow, dt)
                    else
                        pos, moving, speed = getMotion(model, serverNow)
                    end
 
                    -- lagi dibawa player? -> nempel di atas kepala (idle)
                    local carryYaw = nil
                    local carrierId = model:GetAttribute("CarrierId")
                    if carrierId then
                        local target, cy = carryTarget(carrierId, model:GetAttribute("FootOffset") or 0)
                        if target then
                            if not rig.carryT then
                                rig.carryT = 0
                                rig.carryFrom = rig.lastPos or pos or target
                            end
                            rig.carryT = math.min(1, rig.carryT + dt / 0.35)
                            local x = rig.carryT - 1
                            local ease = 1 + 2.70158 * x ^ 3 + 1.70158 * x ^ 2 -- melayang naik ke kepala
                            pos = rig.carryFrom:Lerp(target, ease)
                            moving, speed, carryYaw = false, 0, cy
                        end
                    else
                        rig.carryT = nil
                    end
 
                    if pos then
                        rig.lastPos = pos
                        local dist = (pos - camPos).Magnitude
 
                        if dist <= ANIM_RANGE then
                            rig.acc += dt
                            rig.tick = (rig.tick + 1) % 3
 
                            if dist <= NEAR_RANGE or rig.tick == 0 then
                                local step = rig.acc
                                rig.acc = 0
 
                                -- arah hadap (halus)
                                local targetYaw = carryYaw or model:GetAttribute("Yaw") or rig.yaw
                                local diff = (targetYaw - rig.yaw + pi) % (2 * pi) - pi
                                rig.yaw += diff * (1 - math.exp(-step * 8))
 
                                -- Guard: tidur / lari / hit
                                local sleepTarget, intensityTarget = 0, 1
                                rig.hitU = nil
                                if rig.IsGuard then
                                    local state = model:GetAttribute("GuardState")
                                    if state == "Sleep" then
                                        sleepTarget = 1
                                    elseif state == "Chase" or state == "Return" then
                                        intensityTarget = 1.6
                                    elseif state == "Hit" then
                                        local start = model:GetAttribute("GuardHitStart") or serverNow
                                        local dur = model:GetAttribute("GuardHitDur") or 0.9
                                        rig.hitU = math.clamp((serverNow - start) / dur, 0, 1)
                                    end
                                end
                                rig.sleepBlend += (sleepTarget - rig.sleepBlend) * math.min(1, step * 3.5)
                                rig.intensity += (intensityTarget - rig.intensity) * math.min(1, step * 5)
 
                                -- campuran jalan <-> idle & fase langkah
                                rig.w += ((moving and 1 or 0) - rig.w) * math.min(1, step * 7)
                                if moving then
                                    rig.ph += step * (speed / (3.2 * rig.sc)) * 2 * pi * GAIT[rig.Plan]
                                end
 
                                local t = now + rig.seed
                                drive(rig, t, step)
 
                                local lungeZ = -(rig.ctx.lunge or 0) * 1.6 * rig.sc -- menerjang ke depan (Hit)
                                local poseCF = CFnew(pos) * Ang(0, rig.yaw, 0) * CFnew(0, 0, lungeZ)
                                applyPose(rig, poseCF, t, now)
                            end
                        end
                    end
                end
            end
        end)

]]></ProtectedString>
