<Item class="ModuleScript" referent="RBX6A5AB5395EC24443840DD03977C34F7E">
<Properties>
<BinaryString name="AttributesSerialize"></BinaryString>
<Content name="LinkedSource"><null></null></Content>
<string name="Name">IndexConfig</string>
<string name="ScriptGuid">{26CAB37F-80B5-4B07-BE72-6C2F597CDDB4}</string>
<ProtectedString name="Source"><![CDATA[-- ModuleScript: ReplicatedStorage > Configuration > Modules > Index > IndexConfig
--
-- Index = buku koleksi Pet. Satu entry per Area yang punya Pet di PetConfig.Areas
-- (Area yang belum punya Pet di PetConfig otomatis belum muncul di Index).
--
-- Icon  = Image id Area itu (muncul di Template > Icon)
-- Boost = pengali Sheckles kalau SEMUA Pet di Area itu sudah didapat (Complete)
--         Kalau beberapa Area Complete, yang dipakai Boost TERTINGGI (bukan dijumlah/dikali).
--         Contoh: Area 1 = x1.1 & Area 2 = x1.3 -> kalau dua-duanya Complete, jadinya x1.3
--
-- Nama Area (teks "Forest") diambil dari AreaDisplayConfig.

local Config = {}

Config.Settings = {
UnknownName = "???",                          -- nama Pet yang belum didapat
RewardText = "Complete = x{boost} Sheckles Boost", -- Bar > Reward   ({boost} = angka Boost)
CompleteText = "Complete {area} Area!",       -- Bar > Text kalau sudah lengkap ({area} = nama Area)
}

Config.Areas = {
[1] = { Icon = "rbxassetid://76374641135242", Boost = 1.1 }, -- ganti 0 dengan Image id Icon Area 1
[2] = { Icon = "rbxassetid://0", Boost = 1.3 }, -- ganti 0 dengan Image id Icon Area 2
}

return Config

]]></ProtectedString>
<UniqueId name="UniqueId">7bdf20b295fbe64d0689403978004383</UniqueId>
</Properties>
</Item>
</Item>
<Item class="ModuleScript" referent="RBX6A5AB5395EC24443840DD03979C34F7E">
<Properties>
<BinaryString name="AttributesSerialize"></BinaryString>
<Content name="LinkedSource"><null></null></Content>
<string name="Name">NumberFormat</string>
<string name="ScriptGuid">{26CAB37F-80B5-4B07-BE72-6C2F597CDDB4}</string>
<ProtectedString name="Source"><![CDATA[-- ModuleScript: ReplicatedStorage > Configuration > Modules > NumberFormat
-- (Kalau kamu sudah punya NumberFormat sendiri, pakai punyamu saja. Server & client
--  otomatis support module berbentuk function ATAU table dengan .Format)

local NumberFormat = {}

local suffixes = { "", "K", "M", "B", "T", "Qa", "Qi", "Sx", "Sp", "Oc", "No", "Dc" }

function NumberFormat.Format(n)
    n = tonumber(n) or 0
    
    if n < 1000 then
        return tostring(math.floor(n))
    end
    
    local index = math.floor(math.log10(n) / 3)
    index = math.min(index, #suffixes - 1)
    
    local value = math.floor(n / (10 ^ (index * 3)) * 100) / 100
    return tostring(value) .. suffixes[index + 1]
end

return NumberFormat

]]></ProtectedString>
<UniqueId name="UniqueId">7bdf20b295fbe64d0689403980004383</UniqueId>
</Properties>
</Item>
