<Item class="Script" referent="RBX66C1625455D04AC580D8101543513A7E">
<Properties>
<BinaryString name="AttributesSerialize"></BinaryString>
<bool name="Disabled">false</bool>
<Content name="LinkedSource"><null></null></Content>
<string name="Name">PetServer</string>
<token name="RunContext">0</token>
<string name="ScriptGuid">{FF361BB9-5B67-4864-AADE-7E5A85E36A3E}</string>
<ProtectedString name="Source"><![CDATA[-- Script: ServerScriptService > PetServer
--
-- Spawn Pet di tiap Area (sesuai MaxSpawn & Chance), pasang PetGui, dan atur
-- "otak" jalan-jalan / diam-nya. Animasi badan (jalan & idle) diurus client: PetClient.
-- Steal / Drop / SaveZone ada di script sendiri: PetStealServer.
--
-- Per Area (Workspace > Map > System > Area > <nomor>):
--   NumberValue MaxSpawn, Part Spawn
-- Pet muncul DI ATAS Part Spawn, di Folder "Pets" (dibuat otomatis) di dalam Area itu.
 
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerStorage = game:GetService("ServerStorage")
local ServerScriptService = game:GetService("ServerScriptService")
local CollectionService = game:GetService("CollectionService")
 
local Registry = require(ServerScriptService:WaitForChild("PetRegistry"))
 
local Modules = ReplicatedStorage:WaitForChild("Configuration"):WaitForChild("Modules")
local NumberFormatModule = require(Modules:WaitForChild("NumberFormat"))
local AreaModules = Modules:WaitForChild("Area")
local PetConfig = require(AreaModules:WaitForChild("Pet"):WaitForChild("PetConfig"))
local ChanceConfig = require(AreaModules:WaitForChild("Chance"):WaitForChild("ChanceConfig"))
 
local PetTemplates = ServerStorage:WaitForChild("Configuration"):WaitForChild("Area"):WaitForChild("Pet")
local PetGuiTemplate = ServerStorage:WaitForChild("BillboardGui"):WaitForChild("PetGui")
local AreaFolder = workspace:WaitForChild("Map"):WaitForChild("System"):WaitForChild("Area")
 
local Settings = PetConfig.Settings
local TAG = "AreaPet"
 
local function fmt(n)
    if type(NumberFormatModule) == "function" then
        return NumberFormatModule(n)
    elseif type(NumberFormatModule) == "table" and NumberFormatModule.Format then
        return NumberFormatModule.Format(n)
    end
    return tostring(n)
end
 
local function rand(range)
    return range[1] + math.random() * (range[2] - range[1])
end
 
----------------------------------------------------------------
-- UKURAN PET (efek partikel gak dihitung)
-- Radius = jangkauan horizontal, Height = tinggi dari pivot, MinY = titik terendah dari pivot.
-- MinY dipakai supaya KAKI Pet pas nempel di atas Part Spawn, apa pun posisi pivot modelnya.
----------------------------------------------------------------
local sizeCache = {}
 
local function measure(template)
    local cached = sizeCache[template.Name]
    if cached then return cached.Radius, cached.Height, cached.MinY end
 
    local pivot = template:GetPivot()
    local radius, height, minY = 1, 1, math.huge
 
    for _, d in ipairs(template:GetDescendants()) do
        if d:IsA("BasePart") and d.Name:sub(1, 7) ~= "Effect_" then
            local rel = pivot:ToObjectSpace(d.CFrame).Position
            radius = math.max(radius, math.abs(rel.X) + d.Size.X / 2, math.abs(rel.Z) + d.Size.Z / 2)
            height = math.max(height, rel.Y + d.Size.Y / 2)
            minY = math.min(minY, rel.Y - d.Size.Y / 2)
        end
    end
 
    if minY == math.huge then minY = 0 end
 
    sizeCache[template.Name] = { Radius = radius, Height = height, MinY = minY }
    return radius, height, minY
end
 
----------------------------------------------------------------
-- AREA
----------------------------------------------------------------
local areas = Registry.Areas
 
local function buildPool(index)
    local list = PetConfig.Areas[index]
    if not list then return nil end
 
    local pool, count = {}, 0
    for _, def in ipairs(list) do
        if not PetTemplates:FindFirstChild(def.Name) then
            warn("Area " .. index .. ": Model '" .. def.Name .. "' tidak ada di ServerStorage > Configuration > Area > Pet")
        elseif (ChanceConfig.Chances[def.Rarity] or 0) <= 0 then
            warn("Area " .. index .. ": Rarity '" .. tostring(def.Rarity) .. "' belum ada di ChanceConfig (" .. def.Name .. ")")
        else
            pool[def.Rarity] = pool[def.Rarity] or {}
            table.insert(pool[def.Rarity], def)
            count += 1
        end
    end
 
    return count > 0 and pool or nil
end
 
local function pickPet(pool)
    local total = 0
    for rarity in pairs(pool) do
        total += ChanceConfig.Chances[rarity]
    end
 
    local roll = math.random() * total
    for rarity, list in pairs(pool) do
        roll -= ChanceConfig.Chances[rarity]
        if roll <= 0 then
            return list[math.random(#list)]
        end
    end
 
    for _, list in pairs(pool) do
        return list[1]
    end
end
 
-- Bidang atas Part Spawn: ketemu sumbu yang paling "tegak", dua sumbu lainnya jadi lantai.
-- (jadi tetap bener walau Part Spawn diputar)
local function surfaceOf(part)
    local cf, size = part.CFrame, part.Size
    local axes = {
    { cf.RightVector, size.X },
    { cf.UpVector, size.Y },
    { cf.LookVector, size.Z },
    }
 
    local vertical = 1
    for i = 2, 3 do
        if math.abs(axes[i][1].Y) > math.abs(axes[vertical][1].Y) then
            vertical = i
        end
    end
 
    local topY = part.Position.Y
    + (math.abs(axes[1][1].Y) * size.X + math.abs(axes[2][1].Y) * size.Y + math.abs(axes[3][1].Y) * size.Z) / 2
 
    local flat = {}
    for i = 1, 3 do
        if i ~= vertical then
            table.insert(flat, axes[i])
        end
    end
 
    local a = Vector3.new(flat[1][1].X, 0, flat[1][1].Z)
    local b = Vector3.new(flat[2][1].X, 0, flat[2][1].Z)
    a = a.Magnitude > 0 and a.Unit or Vector3.xAxis
    b = b.Magnitude > 0 and b.Unit or Vector3.zAxis
 
    return topY, a, flat[1][2] / 2, b, flat[2][2] / 2
end
 
-- Titik acak DI ATAS Part Spawn (permukaan atas)
local function randomPoint(area, margin)
    local ha = math.max(area.HalfA - margin, 0)
    local hb = math.max(area.HalfB - margin, 0)
    local p = area.Spawn.Position
    + area.AxisA * ((math.random() * 2 - 1) * ha)
    + area.AxisB * ((math.random() * 2 - 1) * hb)
    return Vector3.new(p.X, area.TopY, p.Z)
end
 
-- Titik tujuan jalan-jalan (posisi pivot Pet)
local function randomTarget(area, info)
    if info.Home then
        -- Pet yang habis di-drop di luar Spawn: jalan-jalan di sekitar titik jatuh
        local angle = math.random() * math.pi * 2
        local r = math.sqrt(math.random()) * info.Home.Radius
        return info.Home.Center + Vector3.new(math.cos(angle) * r, 0, math.sin(angle) * r)
    end
    return randomPoint(area, info.Margin) + Vector3.new(0, info.FootY, 0)
end
 
----------------------------------------------------------------
-- GERAK (otak): Walk <-> Idle. Client yang nganimasiin dari attribute.
----------------------------------------------------------------
local function startIdle(info, now)
    local model = info.Model
    model:SetAttribute("Fall", nil)
    model:SetAttribute("MoveFrom", info.Pos)
    model:SetAttribute("MoveTo", info.Pos)
    model:SetAttribute("MoveDur", 0)
    model:SetAttribute("MoveStart", workspace:GetServerTimeNow())
 
    info.State = "Idle"
    info.NextAt = now + rand(Settings.IdleTime)
end
 
local function startWalk(area, info, now)
    local target
    for _ = 1, 8 do
        local p = randomTarget(area, info)
        if (p - info.Pos).Magnitude >= Settings.MinWalk then
            target = p
            break
        end
    end
 
    if not target then
        startIdle(info, now)
        return
    end
 
    local delta = target - info.Pos
    local dur = delta.Magnitude / info.Speed
    local model = info.Model
 
    model:SetAttribute("Fall", nil)
    model:SetAttribute("Yaw", math.atan2(-delta.X, -delta.Z))
    model:SetAttribute("MoveFrom", info.Pos)
    model:SetAttribute("MoveTo", target)
    model:SetAttribute("MoveDur", dur)
    model:SetAttribute("MoveStart", workspace:GetServerTimeNow())
 
    info.Pos = target
    info.State = "Walk"
    info.NextAt = now + dur
end
 
local function think(area, info, now)
    if info.State == "Walk" or info.State == "Fall" then
        startIdle(info, now) -- sampai tujuan / sudah mendarat -> istirahat sebentar
    elseif math.random() < Settings.WalkChance then
        startWalk(area, info, now)
    else
        startIdle(info, now)
    end
end
 
----------------------------------------------------------------
-- SPAWN
----------------------------------------------------------------
local function spawnPet(area)
    local def = pickPet(area.Pool)
    if not def then return false end
 
    local template = PetTemplates:FindFirstChild(def.Name)
    if not template then return false end
 
    local radius, height, minY = measure(template)
    local footY = -minY
    local margin = math.min(radius, math.min(area.HalfA, area.HalfB) * 0.85)
 
    local model = template:Clone()
    model.Name = def.Name
 
    -- Kaki Pet pas di permukaan atas Part Spawn
    local pos = randomPoint(area, margin) + Vector3.new(0, footY, 0)
    local yaw = math.random() * math.pi * 2
    model:PivotTo(CFrame.new(pos) * CFrame.Angles(0, yaw, 0))
 
    -- Titik tempel PetGui (gak ikut goyang kepala/badan)
    local anchor = Instance.new("Part")
    anchor.Name = "GuiAnchor"
    anchor.Anchored = true
    anchor.CanCollide = false
    anchor.CanQuery = false
    anchor.CanTouch = false
    anchor.Transparency = 1
    anchor.Size = Vector3.new(0.2, 0.2, 0.2)
    anchor.CFrame = CFrame.new(pos + Vector3.new(0, height + 1, 0))
    anchor.Parent = model
 
    -- PetGui langsung di Model Pet
    local gui = PetGuiTemplate:Clone()
    gui.Name = "PetGui"
    gui.Adornee = anchor
 
    local nameLabel = gui:FindFirstChild("Name")
    local rarityLabel = gui:FindFirstChild("Rarity")
    local incomeLabel = gui:FindFirstChild("Income")
    if nameLabel then nameLabel.Text = def.Name end
    if rarityLabel then rarityLabel.Text = def.Rarity end
    if incomeLabel then incomeLabel.Text = "C$" .. fmt(def.Income) .. "/s" end
    gui.Parent = model
 
    -- Data buat client (animasi) & sistem lain
    model:SetAttribute("PetName", def.Name)
    model:SetAttribute("Rarity", def.Rarity)
    model:SetAttribute("Income", def.Income)
    model:SetAttribute("AreaIndex", area.Index)
    model:SetAttribute("PetHeight", height)
    model:SetAttribute("FootOffset", footY)
    model:SetAttribute("Yaw", yaw)
    model:SetAttribute("MoveFrom", pos)
    model:SetAttribute("MoveTo", pos)
    model:SetAttribute("MoveDur", 0)
    model:SetAttribute("MoveStart", workspace:GetServerTimeNow())
 
    local info = {
    Model = model,
    Def = def,
    Area = area,
    Pos = pos,
    FootY = footY,
    Margin = margin,
    Speed = rand(Settings.WalkSpeed),
    State = "Idle",
    NextAt = os.clock() + math.random() * 2,
    }
 
    area.Active[model] = info
    area.Count += 1
    Registry.ByModel[model] = info
 
    model.AncestryChanged:Connect(function()
        if model.Parent ~= area.PetsFolder and area.Active[model] then
            area.Active[model] = nil
            area.Count -= 1
            Registry.ByModel[model] = nil
            area.NextSpawn = math.max(area.NextSpawn, os.clock() + Settings.RespawnDelay)
        end
    end)
 
    model.Parent = area.PetsFolder
    CollectionService:AddTag(model, TAG)
    return true
end
 
local function setupArea(folder)
    local index = tonumber(folder.Name)
    if not index then return end
 
    local spawnPart = folder:FindFirstChild("Spawn")
    local maxValue = folder:FindFirstChild("MaxSpawn")
 
    if not spawnPart or not spawnPart:IsA("BasePart") then
        warn("Area " .. folder.Name .. ": Part 'Spawn' tidak ada")
        return
    end
    if not maxValue or not maxValue:IsA("ValueBase") then
        warn("Area " .. folder.Name .. ": NumberValue 'MaxSpawn' tidak ada")
        return
    end
 
    local pool = buildPool(index)
    if not pool then
        warn("Area " .. folder.Name .. ": tidak ada pet yang valid di PetConfig")
        return
    end
 
    local petsFolder = folder:FindFirstChild("Pets")
    if not petsFolder then
        petsFolder = Instance.new("Folder")
        petsFolder.Name = "Pets"
        petsFolder.Parent = folder
    end
 
    local topY, axisA, halfA, axisB, halfB = surfaceOf(spawnPart)
 
    local area = {
    Index = index,
    Folder = folder,
    Spawn = spawnPart,
    Max = maxValue,
    Pool = pool,
    PetsFolder = petsFolder,
    TopY = topY,
    AxisA = axisA, HalfA = halfA,
    AxisB = axisB, HalfB = halfB,
    Active = {},
    Count = 0,
    NextSpawn = 0,
    }
 
    -- Dipakai Registry.Drop: apakah titik ini masih di atas Part Spawn?
    function area.IsInside(p)
        local d = p - spawnPart.Position
        return math.abs(d:Dot(axisA)) <= halfA and math.abs(d:Dot(axisB)) <= halfB
    end
 
    areas[index] = area
end
 
for _, folder in ipairs(AreaFolder:GetChildren()) do
    setupArea(folder)
end
 
task.spawn(function()
    while true do
        task.wait(0.25)
        local now = os.clock()
 
        for _, area in pairs(areas) do
            if not area.NoSpawn and area.Count < area.Max.Value and now >= area.NextSpawn then
                if spawnPet(area) then
                    area.NextSpawn = now + Settings.SpawnInterval
                else
                    area.NextSpawn = now + 2
                end
            end
 
            for _, info in pairs(area.Active) do
                -- Pet yang lagi diangkat player berhenti jalan-jalan
                if not info.Carrier and now >= info.NextAt then
                    think(area, info, now)
                end
            end
        end
    end
end)

]]></ProtectedString>
