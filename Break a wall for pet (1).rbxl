<Item class="Folder" referent="RBXC7F38F5F49694AFF826B4039712EF763">
<Properties>
<BinaryString name="AttributesSerialize"></BinaryString>
<string name="Name">Treadmill</string>
<UniqueId name="UniqueId">7bdf20b295fbe64d068940397200430e</UniqueId>
</Properties>
<Item class="ModuleScript" referent="RBX6A5AB5395EC24443840DD03973C34F7E">
<Properties>
<BinaryString name="AttributesSerialize"></BinaryString>
<Content name="LinkedSource"><null></null></Content>
<string name="Name">TreadmillConfig</string>
<string name="ScriptGuid">{26CAB37F-80B5-4B07-BE72-6C2F597CDDB4}</string>
<ProtectedString name="Source"><![CDATA[-- ModuleScript: ReplicatedStorage > Configuration > Modules > Treadmill > TreadmillConfig
--
-- Tiap nomor (1), (2), (3)... = level treadmill = Model "1", "2", "3" di
-- ServerStorage > Configuration > Base > Treadmill
--
-- PerSecond = Speed yang didapat tiap 1 detik di level itu
-- Cost      = harga untuk mendapatkan level itu
--             (1) = harga beli Treadmill (TreadmillPurchase)
--             (2) dst = harga Upgrade dari level sebelumnya
-- Level paling akhir otomatis jadi "Max"
 
local Config = {}
 
Config.Levels = {
[1] = { PerSecond = 10,  Cost = 50 },
[2] = { PerSecond = 25,  Cost = 1500 },
[3] = { PerSecond = 60,  Cost = 5000 },
[4] = { PerSecond = 150, Cost = 15000 },
}
 
-- Harga beli = Cost level (1)
Config.PurchaseCost = Config.Levels[1].Cost
 
-- WalkSpeed = Base + (leaderstats Speed * Multiplier), dibatasi Max
-- Contoh: Speed 50 -> 16 + 50*0.05 = 18.5 (pelan naiknya, bukan 50 langsung)
Config.WalkSpeed = {
Base = 16,
Multiplier = 0.05,
Max = 60,
}
 
-- Animasi lari di treadmill
Config.Animations = {
R15 = "rbxassetid://507767714",
R6 = "rbxassetid://180426354",
}
Config.AnimationSpeed = 1.2
 
-- Jeda (detik) sebelum bisa kena Hitbox lagi setelah Stop
Config.TouchCooldown = 1
 
return Config

]]></ProtectedString>
<UniqueId name="UniqueId">7bdf20b295fbe64d0689403974004383</UniqueId>
</Properties>
</Item>
</Item>
<Item class="Folder" referent="RBXC7F38F5F49694AFF826B4039752EF763">
