<Item class="Folder" referent="RBXC7F38F5F49694AFF826B4039952EF763">
<Properties>
<BinaryString name="AttributesSerialize"></BinaryString>
<string name="Name">Guard</string>
<UniqueId name="UniqueId">7bdf20b295fbe64d068940399600430e</UniqueId>
</Properties>
<Item class="ModuleScript" referent="RBX6A5AB5395EC24443840DD03997C34F7E">
<Properties>
<BinaryString name="AttributesSerialize"></BinaryString>
<Content name="LinkedSource"><null></null></Content>
<string name="Name">GuardConfig</string>
<string name="ScriptGuid">{26CAB37F-80B5-4B07-BE72-6C2F597CDDB4}</string>
<ProtectedString name="Source"><![CDATA[-- ModuleScript: ReplicatedStorage > Configuration > Modules > Area > Guard > GuardConfig
--
-- Guard = pet (dari script PETS 150) yang ditaruh sebagai Model bernama "Guard"
-- di Workspace > Map > System > Area > <nomor>.
-- Guard tidur di tempatnya. Kalau ada Pet yang di-Steal dari Area itu, Guard bangun
-- & ngejar pencurinya. Kalau kena Hit: Pet jatuh, pencuri terpental (ragdoll),
-- Guard pulang ke tempat tidurnya.
 
local Config = {}
 
Config.Settings = {
HitRange = 5,              -- jarak Guard bisa nge-Hit (studs)
LoseDistance = 160,        -- pencuri lebih jauh dari ini -> Guard menyerah & pulang
WakeDelay = 0.6,           -- jeda bangun sebelum mulai ngejar (detik)
HitDuration = 0.9,         -- lama animasi Hit (pukulan mendarat di ~0.4 dari durasi ini)
ReturnSpeedMultiplier = 1, -- kecepatan pulang (1 = sama kayak pas ngejar)
 
KnockbackForce = 70,       -- dorongan mendatar pas kena Hit
KnockbackUp = 45,          -- dorongan ke atas
RagdollTime = 2.5,         -- lama ragdoll (detik)

-- KECEPATAN NGEJAR (dihitung per pencuri: Recommended vs Speed pencuri)
-- Guard speed = WalkSpeed pencuri x multiplier, multiplier = (Recommended / SpeedPencuri) ^ SpeedPower,
-- lalu dibatasi Min..Max. Contoh: Recommended 10000, Speed pencuri 4200 -> 2.38x -> dipotong Max (1.6x).
-- Mau Guard lebih ganas -> naikin MaxSpeedMult. Mau lebih santai -> turunin.
SpeedPower = 1,
MinSpeedMult = 0.6,        -- Speed pencuri >= Recommended: Guard paling lambat segini x
MaxSpeedMult = 1.6,        -- Speed pencuri jauh di bawah Recommended: Guard paling cepat segini x

LungeSpeedMult = 1.4,      -- Guard menerjang lebih kencang pas mulai Hit
HitForgiveness = 2.2,      -- pukulan masih kena kalau jarak <= HitRange x ini (makin besar = makin susah kabur)
}
 
-- RecommendedSpeed = Speed (leaderstats) yang disarankan di Area itu.
-- Kecepatan lari Guard = WalkSpeed player dengan Speed segitu (rumus yang sama dengan
-- Treadmill: Base + Speed * Multiplier). Jadi player dengan Speed LEBIH TINGGI dari ini
-- lebih cepat dari Guard & gak bakal ke-Hit.
Config.Areas = {
[1] = { RecommendedSpeed = 10000 },
[2] = { RecommendedSpeed = 10000 },
}
 
return Config


]]></ProtectedString>
<UniqueId name="UniqueId">7bdf20b295fbe64d0689403998004383</UniqueId>
</Properties>
</Item>
</Item>
<Item class="Folder" referent="RBXC7F38F5F49694AFF826B4039992EF763">
