</Item>
<Item class="Script" referent="RBX66C1625455D04AC580D8101533513A7E">
<Properties>
<BinaryString name="AttributesSerialize"></BinaryString>
<bool name="Disabled">false</bool>
<Content name="LinkedSource"><null></null></Content>
<string name="Name">BaseSystemServer</string>
<token name="RunContext">0</token>
<string name="ScriptGuid">{FF361BB9-5B67-4864-AADE-7E5A85E36A3E}</string>
<ProtectedString name="Source"><![CDATA[
local Players = game:GetService("Players")

local Bases = workspace:WaitForChild("Bases")

local function getOwner(base)
    return base:FindFirstChild("Owner")
end

local function getSpawn(base)
    local spawnPart = base:FindFirstChild("Spawn")
    
    if spawnPart and spawnPart:IsA("BasePart") then
        return spawnPart
    end
    
    return nil
end

local function getBillboardObjects(base)
    local sign = base:FindFirstChild("BillboardSign")
    
    if not sign then
        return nil, nil
    end
    
    local nameGui = sign:FindFirstChild("NameGui")
    local profileGui = sign:FindFirstChild("ProfileGui")
    
    local text = nameGui and nameGui:FindFirstChild("Text")
    local image = profileGui and profileGui:FindFirstChild("Image")
    
    return text, image
end

local function updateBase(base)
    local owner = getOwner(base)
    if not owner then return end
    
    local text, image = getBillboardObjects(base)
    
    if not text or not image then
        return
    end
    
    -- Base kosong
    if owner.Value == 0 then
        text.Text = '["Empty Base"]'
        image.Image = ""
        return
    end
    
    local player = Players:GetPlayerByUserId(owner.Value)
    
    -- Owner sudah tidak ada
    if not player then
        owner.Value = 0
        text.Text = '["Empty Base"]'
        image.Image = ""
        return
    end
    
    -- Nama owner
    text.Text = '["' .. player.Name .. ' Base"]'
    
    -- Profile owner
    local success, thumbnail = pcall(function()
        return Players:GetUserThumbnailAsync(
        player.UserId,
        Enum.ThumbnailType.HeadShot,
        Enum.ThumbnailSize.Size150x150
        )
    end)
    
    if success then
        image.Image = thumbnail
    else
        image.Image = ""
    end
end

local function getPlayerBase(player)
    for _, base in ipairs(Bases:GetChildren()) do
        if base:IsA("Model") then
            local owner = getOwner(base)
            
            if owner and owner.Value == player.UserId then
                return base
            end
        end
    end
    
    return nil
end

local function getEmptyBase()
    for _, base in ipairs(Bases:GetChildren()) do
        if base:IsA("Model") then
            local owner = getOwner(base)
            
            if owner and owner.Value == 0 then
                return base
            end
        end
    end
    
    return nil
end

-- Teleport ke Spawn base
local function teleportToBase(player, character)
    local base = getPlayerBase(player)
    
    if not base then
        return
    end
    
    local spawnPart = getSpawn(base)
    
    if not spawnPart then
        warn("Spawn tidak ditemukan di " .. base.Name)
        return
    end
    
    local root = character:WaitForChild("HumanoidRootPart", 10)
    
    if not root then
        return
    end
    
    -- Sedikit di atas Spawn
    character:PivotTo(
    spawnPart.CFrame + Vector3.new(0, 3, 0)
    )
end

-- Setup base yang sudah ada
for _, base in ipairs(Bases:GetChildren()) do
    if base:IsA("Model") then
        
        local owner = getOwner(base)
        
        if owner then
            updateBase(base)
            
            -- Owner berubah
            owner.Changed:Connect(function()
                updateBase(base)
            end)
        else
            warn(base.Name .. " tidak memiliki NumberValue bernama Owner")
        end
    end
end

-- Player masuk
Players.PlayerAdded:Connect(function(player)
    
    -- Cari base dan kasih ownership
    local base = getPlayerBase(player)
    
    if not base then
        base = getEmptyBase()
        
        if base then
            local owner = getOwner(base)
            owner.Value = player.UserId
            
            updateBase(base)
        else
            warn("Tidak ada Base kosong untuk " .. player.Name)
        end
    end
    
    -- Spawn pertama + setiap respawn
    player.CharacterAdded:Connect(function(character)
        task.wait()
        teleportToBase(player, character)
    end)
end)

-- Player keluar
Players.PlayerRemoving:Connect(function(player)
    
    local base = getPlayerBase(player)
    
    if base then
        local owner = getOwner(base)
        
        if owner then
            -- Reset owner
            owner.Value = 0
            
            -- Reset billboard
            local text, image = getBillboardObjects(base)
            
            if text then
                text.Text = '["Empty Base"]'
            end
            
            if image then
                image.Image = ""
            end
        end
    end
end)

]]></ProtectedString>
<UniqueId name="UniqueId">706ce791354c7e1f067d8015340041fa</UniqueId>
