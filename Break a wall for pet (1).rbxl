<ProtectedString name="Source"><![CDATA[-- LocalScript: StarterPlayer > StarterPlayerScripts > PetStealClient
--
-- Semua tampilan sisi client untuk Pet:
--   1) Pas bawa Pet (Steal): sound, RedVignette, tombol Drop, tulisan RUN!, Backpack disembunyikan
--   2) ActiveFrame (Pet yang di-Place di Base): buka/tutup dari PetBTN, Unequip, EquipBest
--   3) Popup "+50 Sheckles" tiap detik (+ PopSound)
--   4) Prompt "Take" di Pet milik sendiri, & warna Rarity di PetGui milik Tool Pet
--   5) OfflineEarn (Sheckles selama offline: Claim / Close / RobuxClaim x2)
--
-- OfflineEarn: MainGui > GameHub > Frame > Frame > OfflineEarn
--   Sheckles > Text, Claim > Claim + RobuxClaim, Top > Close
--
-- GUI (di StarterGui):
-- MainGui > GameHub
--   Button > RightButton > PetBTN
--   Popup > Base > Pet > Template > Text
--   Frame > MechanicFrame > AreaMechanic > Pet > Drop, Run > Text
--   Frame > Frame > ActiveFrame > Main > Template (Name, Income, Pet[Viewport], Unequip)
--                               > EquipBest, Close, Top > Amount
 
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local RunService = game:GetService("RunService")
local SoundService = game:GetService("SoundService")
local StarterGui = game:GetService("StarterGui")
local CollectionService = game:GetService("CollectionService")
local Debris = game:GetService("Debris")
 
local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")
 
local Configuration = ReplicatedStorage:WaitForChild("Configuration")
local Modules = Configuration:WaitForChild("Modules")
local NumberFormatModule = require(Modules:WaitForChild("NumberFormat"))
local PetConfig = require(Modules:WaitForChild("Area"):WaitForChild("Pet"):WaitForChild("PetConfig"))
local Remotes = Configuration:WaitForChild("PetStealRemotes")
local UIEvent = Remotes:WaitForChild("PetCarryUI")
local ActionEvent = Remotes:WaitForChild("PetCarryAction")
local RarityFolder = Configuration:WaitForChild("Colors"):WaitForChild("Rarity")
local PetDisplay = ReplicatedStorage:WaitForChild("PetDisplay")
 
local MAX_ACTIVE = PetConfig.Settings.MaxActive
 
local START_SOUND_ID = "rbxassetid://84399172793678"
local LOOP_SOUND_ID = "rbxassetid://1847683499"
local VIGNETTE_IMAGE = "rbxassetid://91011156830852"
local POP_SOUND_ID = "rbxassetid://1289263994" -- sama kayak PopSound Speed
 
local RUN_TEXTS = { "RUN!", "RUN!!", "RUN!!!" }
 
local function fmt(n)
    if type(NumberFormatModule) == "function" then
        return NumberFormatModule(n)
    elseif type(NumberFormatModule) == "table" and NumberFormatModule.Format then
        return NumberFormatModule.Format(n)
    end
    return tostring(n)
end
 
-- FindFirstChild (aman untuk nama "Name" yang bentrok dengan property)
local function find(parent, name, recursive)
    return parent and parent:FindFirstChild(name, recursive)
end
 
local function setBackpack(enabled)
    -- inventory custom (InventoryClient) ikut disembunyikan / dimunculkan lewat attribute
    game:GetService("Players").LocalPlayer:SetAttribute("HideInv_Steal", not enabled)
end
 
local function hiddenTop(pos)
    -- satu tinggi layar ke atas + 400px, jadi pasti di luar layar
    return UDim2.new(pos.X.Scale, pos.X.Offset, pos.Y.Scale - 1, pos.Y.Offset - 400)
end
 
local function hiddenRight(pos)
    -- satu lebar layar ke kanan + 400px
    return UDim2.new(pos.X.Scale + 1, pos.X.Offset + 400, pos.Y.Scale, pos.Y.Offset)
end
 
-- Warna Rarity (UIGradient / folder isi UIGradient + script-nya) ke sebuah GUI
local function applyRarity(target, rarityName)
    if not target or not rarityName then return end
 
    local source = RarityFolder:FindFirstChild(rarityName)
    if not source then
        warn("Rarity '" .. tostring(rarityName) .. "' tidak ada di Colors > Rarity")
        return
    end
 
    if source:IsA("UIGradient") then
        source:Clone().Parent = target
    else
        for _, child in ipairs(source:GetChildren()) do
            if child:IsA("UIGradient") then
                child:Clone().Parent = target
            end
        end
    end
end
 
----------------------------------------------------------------
-- STATE
----------------------------------------------------------------
local carryUI = nil     -- GUI bawa Pet
local activeUI = nil    -- GUI ActiveFrame
local popupUI = nil     -- GUI popup Sheckles
local offlineUI = nil   -- GUI OfflineEarn
local offlineShown = false
 
local carrying = false
local animToken = 0
local loopSound = nil
local vignetteGui = nil
local vignetteToken = 0
local pulseConn = nil
local dropDebounce = false
 
local petState = { Placed = {}, Items = {} }
local activeOpen = false
local spinners = {}
 
----------------------------------------------------------------
-- 1) BAWA PET: SUARA
----------------------------------------------------------------
local function startSounds()
    local first = Instance.new("Sound")
    first.Name = "StealStartSound"
    first.SoundId = START_SOUND_ID
    first.Volume = 1
    first.Parent = SoundService
    first:Play()
    Debris:AddItem(first, 10)
 
    if loopSound then loopSound:Destroy() end
    loopSound = Instance.new("Sound")
    loopSound.Name = "StealLoopSound"
    loopSound.SoundId = LOOP_SOUND_ID
    loopSound.Volume = 0.8
    loopSound.Looped = true
    loopSound.Parent = SoundService
    loopSound:Play()
end
 
local function stopSounds()
    if loopSound then
        loopSound:Stop()
        loopSound:Destroy()
        loopSound = nil
    end
end
 
----------------------------------------------------------------
-- 1) BAWA PET: RED VIGNETTE (dari script kamu)
----------------------------------------------------------------
local function startVignette()
    vignetteToken += 1
    local token = vignetteToken
 
    if vignetteGui then vignetteGui:Destroy() end
 
    local gui = Instance.new("ScreenGui")
    gui.Name = "RedVignette"
    gui.IgnoreGuiInset = true
    gui.ResetOnSpawn = false
    gui.DisplayOrder = 100
    gui.Parent = playerGui
    vignetteGui = gui
 
    local image = Instance.new("ImageLabel")
    image.Name = "Vignette"
    image.Size = UDim2.fromScale(1, 1)
    image.Position = UDim2.fromScale(0, 0)
    image.BackgroundTransparency = 1
    image.Image = VIGNETTE_IMAGE
    image.ImageColor3 = Color3.fromRGB(255, 0, 20)
    image.ImageTransparency = 1
    image.ScaleType = Enum.ScaleType.Stretch
    image.Parent = gui
 
    local fadeIn = TweenService:Create(
    image,
    TweenInfo.new(2, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut),
    { ImageTransparency = 0.25 }
    )
    local fadeOut = TweenService:Create(
    image,
    TweenInfo.new(2.5, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut),
    { ImageTransparency = 1 }
    )
 
    task.spawn(function()
        while vignetteToken == token do
            fadeIn:Play()
            task.wait(2)
            if vignetteToken ~= token then break end
 
            fadeOut:Play()
            task.wait(2.5)
        end
    end)
end
 
local function stopVignette()
    vignetteToken += 1
    if vignetteGui then
        vignetteGui:Destroy()
        vignetteGui = nil
    end
end
 
----------------------------------------------------------------
-- 1) BAWA PET: GUI (Drop & Run)
----------------------------------------------------------------
local function stopRunAnim()
    animToken += 1
    if pulseConn then
        pulseConn:Disconnect()
        pulseConn = nil
    end
    if carryUI then
        carryUI.RunScale.Scale = 1
    end
end
 
local function startRunAnim()
    animToken += 1
    local token = animToken
 
    -- teks: RUN! -> RUN!! -> RUN!!! -> balik lagi ke RUN!
    task.spawn(function()
        local i = 0
        while carrying and token == animToken and carryUI do
            i = i % #RUN_TEXTS + 1
            carryUI.RunText.Text = RUN_TEXTS[i]
            task.wait(0.28)
        end
    end)
 
    -- ukuran: kadang membesar, kadang mengecil
    if pulseConn then pulseConn:Disconnect() end
    pulseConn = RunService.RenderStepped:Connect(function()
        if carryUI then
            carryUI.RunScale.Scale = 1 + math.sin(os.clock() * 5) * 0.12
        end
    end)
end
 
local function showCarryUI()
    local r = carryUI
    if not r then return end
 
    r.Area.Visible = true
    r.PetFrame.Visible = true
 
    r.Drop.Visible = true
    r.DropScale.Scale = 0
    TweenService:Create(
    r.DropScale,
    TweenInfo.new(0.4, Enum.EasingStyle.Back, Enum.EasingDirection.Out),
    { Scale = 1 }
    ):Play()
 
    r.Run.Position = hiddenTop(r.RunPosition)
    r.Run.Visible = true
    TweenService:Create(
    r.Run,
    TweenInfo.new(0.5, Enum.EasingStyle.Back, Enum.EasingDirection.Out),
    { Position = r.RunPosition }
    ):Play()
 
    startRunAnim()
end
 
local function hideCarryUI()
    local r = carryUI
    stopRunAnim()
    if not r then return end
 
    TweenService:Create(
    r.DropScale,
    TweenInfo.new(0.25, Enum.EasingStyle.Back, Enum.EasingDirection.In),
    { Scale = 0 }
    ):Play()
    TweenService:Create(
    r.Run,
    TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.In),
    { Position = hiddenTop(r.RunPosition) }
    ):Play()
 
    task.delay(0.32, function()
        if not carrying then
            r.Drop.Visible = false
            r.Run.Visible = false
            r.PetFrame.Visible = false
        end
    end)
end
 
local function bindCarryUI(mainGui)
    local area = mainGui:WaitForChild("GameHub"):WaitForChild("Frame")
    :WaitForChild("MechanicFrame"):WaitForChild("AreaMechanic")
    local petFrame = area:WaitForChild("Pet")
    local drop = petFrame:WaitForChild("Drop")
    local run = petFrame:WaitForChild("Run")
    local runText = run:WaitForChild("Text")
 
    local dropScale = drop:FindFirstChildOfClass("UIScale")
    if not dropScale then
        dropScale = Instance.new("UIScale")
        dropScale.Parent = drop
    end
 
    local runScale = run:FindFirstChildOfClass("UIScale")
    if not runScale then
        runScale = Instance.new("UIScale")
        runScale.Parent = run
    end
 
    drop.Visible = false
    run.Visible = false
    petFrame.Visible = false
 
    carryUI = {
    Area = area,
    PetFrame = petFrame,
    Drop = drop,
    DropScale = dropScale,
    Run = run,
    RunScale = runScale,
    RunText = runText,
    RunPosition = run.Position,
    }
 
    drop.Activated:Connect(function()
        if not carrying or dropDebounce then return end
        dropDebounce = true
        ActionEvent:FireServer("Drop")
        task.delay(0.5, function()
            dropDebounce = false
        end)
    end)
 
    if carrying then
        showCarryUI()
    end
end
 
local function startCarry()
    if carrying then return end
    carrying = true
 
    setBackpack(false)
    startSounds()
    startVignette()
    showCarryUI()
end
 
local function endCarry()
    if not carrying then return end
    carrying = false
 
    setBackpack(true)
    stopSounds()
    stopVignette()
    hideCarryUI()
end
 
----------------------------------------------------------------
-- 2) ACTIVE FRAME
----------------------------------------------------------------
local TILT = CFrame.Angles(math.rad(10), 0, 0)
 
local function setupViewport(viewport, petName)
    if not viewport or not viewport:IsA("ViewportFrame") then return end
 
    local source = PetDisplay:FindFirstChild(petName)
    if not source then return end
 
    local model = source:Clone()
    for _, d in ipairs(model:GetDescendants()) do
        if d:IsA("BasePart") then
            d.Anchored = true
        end
    end
    model.Parent = viewport
 
    local cf, size = model:GetBoundingBox()
    model.WorldPivot = cf
    model:PivotTo(CFrame.new())
 
    local camera = Instance.new("Camera")
    camera.FieldOfView = 40
    local radius = size.Magnitude / 2
    local distance = radius / math.sin(math.rad(camera.FieldOfView / 2))
    camera.CFrame = CFrame.lookAt(Vector3.new(0, 0, distance), Vector3.zero)
    camera.Parent = viewport
    viewport.CurrentCamera = camera
 
    viewport.Ambient = Color3.fromRGB(190, 190, 190)
    viewport.LightColor = Color3.fromRGB(255, 255, 255)
    viewport.LightDirection = Vector3.new(-1, -1, -1)
 
    table.insert(spinners, { Model = model, Viewport = viewport })
end
 
local angle = 0
RunService.RenderStepped:Connect(function(dt)
    if not activeUI or not activeUI.Frame.Visible then return end
 
    angle = (angle + dt * 1.5) % (math.pi * 2)
 
    for i = #spinners, 1, -1 do
        local s = spinners[i]
        if not s.Model.Parent or not s.Viewport:IsDescendantOf(playerGui) then
            table.remove(spinners, i)
        else
            s.Model:PivotTo(TILT * CFrame.Angles(0, angle, 0))
        end
    end
end)
 
-- Warna tombol EquipBest: Best (ada Pet di Backpack yang lebih baik) / Bad (gak ada)
local function hasBetterPet()
    local items, placed = petState.Items, petState.Placed
    if #items == 0 then return false end
    if #placed < MAX_ACTIVE then return true end
 
    local minPlaced = math.huge
    for _, p in ipairs(placed) do
        minPlaced = math.min(minPlaced, p.Income)
    end
 
    local maxItem = 0
    for _, i in ipairs(items) do
        maxItem = math.max(maxItem, i.Income)
    end
    return maxItem > minPlaced
end
 
local function updateEquipBest()
    local u = activeUI
    if not u or not u.Live then return end
 
    local target = hasBetterPet() and u.BestGradient or u.BadGradient
    if not target then return end
 
    u.Live.Color = target.Color
    u.Live.Rotation = target.Rotation
    u.Live.Transparency = target.Transparency
    u.Live.Offset = target.Offset
end
 
local function rebuildList()
    local u = activeUI
    if not u then return end
 
    for _, child in ipairs(u.Main:GetChildren()) do
        if child:GetAttribute("PetEntry") then
            child:Destroy()
        end
    end
    table.clear(spinners)
 
    u.Template.Visible = false
 
    for index, pet in ipairs(petState.Placed) do
        local entry = u.Template:Clone()
        entry.Name = pet.Id
        entry.Visible = true
        entry.LayoutOrder = index
        entry:SetAttribute("PetEntry", true)
 
        local nameLabel = find(entry, "Name", true)
        local incomeLabel = find(entry, "Income", true)
        local viewport = find(entry, "Pet", true)
        local unequip = find(entry, "Unequip", true)
 
        if nameLabel then nameLabel.Text = pet.Name end
        if incomeLabel then incomeLabel.Text = "C$" .. fmt(pet.Income) .. "/s" end
 
        -- Background & Name pakai warna Rarity
        applyRarity(entry, pet.Rarity)
        applyRarity(nameLabel, pet.Rarity)
 
        setupViewport(viewport, pet.Name)
 
        if unequip then
            unequip.Activated:Connect(function()
                ActionEvent:FireServer("Unequip", pet.Id)
            end)
        end
 
        entry.Parent = u.Main
    end
 
    u.Amount.Text = #petState.Placed .. "/" .. MAX_ACTIVE .. " Active"
    updateEquipBest()
end
 
local function openActive()
    local u = activeUI
    if not u or activeOpen then return end
    activeOpen = true
 
    u.Frame.Position = hiddenRight(u.FramePosition)
    u.Frame.Visible = true
    TweenService:Create(
    u.Frame,
    TweenInfo.new(0.45, Enum.EasingStyle.Quint, Enum.EasingDirection.Out),
    { Position = u.FramePosition }
    ):Play()
end
 
local function closeActive()
    local u = activeUI
    if not u or not activeOpen then return end
    activeOpen = false
 
    TweenService:Create(
    u.Frame,
    TweenInfo.new(0.35, Enum.EasingStyle.Quint, Enum.EasingDirection.In),
    { Position = hiddenRight(u.FramePosition) }
    ):Play()
 
    task.delay(0.37, function()
        if not activeOpen then
            u.Frame.Visible = false
        end
    end)
end
 
local function bindActiveUI(mainGui)
    local gameHub = mainGui:WaitForChild("GameHub")
    local frame = gameHub:WaitForChild("Frame"):WaitForChild("Frame"):WaitForChild("ActiveFrame")
    local main = frame:WaitForChild("Main")
    local template = main:WaitForChild("Template")
    local equipBest = frame:WaitForChild("EquipBest")
    local closeButton = frame:WaitForChild("Close")
    local amount = frame:WaitForChild("Top"):WaitForChild("Amount")
    local petBtn = gameHub:WaitForChild("Button"):WaitForChild("RightButton"):WaitForChild("PetBTN")
 
    if main:IsA("ScrollingFrame") then
        main.AutomaticCanvasSize = Enum.AutomaticSize.Y
        main.CanvasSize = UDim2.new(0, 0, 0, 0)
    end
 
    -- Colors > Pet > EquipBest > Best / Bad
    local colors = Configuration:WaitForChild("Colors"):WaitForChild("Pet", 10)
    colors = colors and colors:WaitForChild("EquipBest", 10)
    local best = colors and colors:FindFirstChild("Best")
    local bad = colors and colors:FindFirstChild("Bad")
 
    local live = nil
    if best or bad then
        live = (bad or best):Clone()
        live.Name = "EquipBestGradient"
        live.Parent = equipBest
    else
        warn("Colors > Pet > EquipBest > Best / Bad tidak ditemukan")
    end
 
    template.Visible = false
    frame.Visible = false
    activeOpen = false
 
    activeUI = {
    Frame = frame,
    FramePosition = frame.Position,
    Main = main,
    Template = template,
    Amount = amount,
    Live = live,
    BestGradient = best,
    BadGradient = bad,
    }
 
    petBtn.Activated:Connect(function()
        if activeOpen then
            closeActive()
        else
            openActive()
        end
    end)
    closeButton.Activated:Connect(closeActive)
    equipBest.Activated:Connect(function()
        ActionEvent:FireServer("EquipBest")
    end)
 
    rebuildList()
    ActionEvent:FireServer("Sync")
end
 
----------------------------------------------------------------
-- 3) POPUP "+50 Sheckles"
----------------------------------------------------------------
local popSound = Instance.new("Sound")
popSound.Name = "PopSound"
popSound.SoundId = POP_SOUND_ID
popSound.Volume = 0.5
popSound.Parent = SoundService
 
local function popupText(text, withSound)
    local p = popupUI
    if not p then return end
 
    if withSound then
        local s = popSound:Clone()
        s.Parent = SoundService
        s:Play()
        Debris:AddItem(s, 5)
    end
 
    local clone = p.Template:Clone()
    clone.Name = "Popup"
    clone.Visible = true
 
    local label = find(clone, "Text", true)
    if label and label:IsA("TextLabel") then
        label.Text = text
    end
 
    local scale = Instance.new("UIScale")
    scale.Scale = 0.5
    scale.Parent = clone
 
    clone.Parent = p.Folder
 
    TweenService:Create(
    scale,
    TweenInfo.new(0.25, Enum.EasingStyle.Back, Enum.EasingDirection.Out),
    { Scale = 1 }
    ):Play()
 
    task.delay(0.8, function()
        local t = TweenService:Create(
        scale,
        TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.In),
        { Scale = 0 }
        )
        t:Play()
        task.wait(0.27)
        clone:Destroy()
    end)
end
 
local function showIncomePopup(amount)
    popupText("+" .. fmt(amount) .. " Sheckles", true)
end
 
local function bindPopup(mainGui)
    local folder = mainGui:WaitForChild("GameHub"):WaitForChild("Popup")
    :WaitForChild("Base"):WaitForChild("Pet")
    local template = folder:WaitForChild("Template")
    template.Visible = false
 
    popupUI = { Folder = folder, Template = template }
end
 
----------------------------------------------------------------
-- 5) OFFLINE EARN
----------------------------------------------------------------
local function showOffline(amount, doubled)
    local u = offlineUI
    if not u then return end
 
    u.Text.Text = "C$" .. fmt(amount)
    u.RobuxClaim.Visible = true -- Claim = x1, RobuxClaim = x2
 
    if offlineShown then return end
    offlineShown = true
 
    u.Frame.Visible = true
    u.Scale.Scale = 0
    TweenService:Create(
    u.Scale,
    TweenInfo.new(0.45, Enum.EasingStyle.Back, Enum.EasingDirection.Out),
    { Scale = 1 }
    ):Play()
end
 
local function hideOffline()
    local u = offlineUI
    if not u or not offlineShown then return end
    offlineShown = false
 
    TweenService:Create(
    u.Scale,
    TweenInfo.new(0.25, Enum.EasingStyle.Back, Enum.EasingDirection.In),
    { Scale = 0 }
    ):Play()
 
    task.delay(0.27, function()
        if not offlineShown then
            u.Frame.Visible = false
        end
    end)
end
 
local function bindOfflineUI(mainGui)
    local frame = mainGui:WaitForChild("GameHub"):WaitForChild("Frame"):WaitForChild("Frame")
    :WaitForChild("OfflineEarn")
    local text = frame:WaitForChild("Sheckles"):WaitForChild("Text")
    local claimFrame = frame:WaitForChild("Claim")
    local claimButton = claimFrame:WaitForChild("Claim")
    local robuxButton = claimFrame:WaitForChild("RobuxClaim")
    local closeButton = frame:WaitForChild("Top"):WaitForChild("Close")
 
    local scale = frame:FindFirstChildOfClass("UIScale")
    if not scale then
        scale = Instance.new("UIScale")
        scale.Parent = frame
    end
 
    frame.Visible = false
    offlineShown = false
 
    offlineUI = {
    Frame = frame,
    Scale = scale,
    Text = text,
    RobuxClaim = robuxButton,
    }
 
    -- Claim & Close sama-sama dapat Sheckles-nya
    local claiming = false
    local function claim()
        if claiming or not offlineShown then return end
        claiming = true
        ActionEvent:FireServer("OfflineClaim")
        hideOffline()
        task.delay(1, function()
            claiming = false
        end)
    end
 
    claimButton.Activated:Connect(claim)
    closeButton.Activated:Connect(claim)
    robuxButton.Activated:Connect(function()
        ActionEvent:FireServer("OfflineRobux")
    end)
 
    ActionEvent:FireServer("OfflineSync")
end
 
----------------------------------------------------------------
-- BIND SEMUA GUI (masing-masing terpisah biar satu yang belum dibuat gak ngeblok yang lain)
----------------------------------------------------------------
local function bindAll(mainGui)
    task.spawn(bindCarryUI, mainGui)
    task.spawn(bindActiveUI, mainGui)
    task.spawn(bindPopup, mainGui)
    task.spawn(bindOfflineUI, mainGui)
end
 
local existing = playerGui:FindFirstChild("MainGui")
if existing then
    bindAll(existing)
end
playerGui.ChildAdded:Connect(function(child)
    if child.Name == "MainGui" then
        bindAll(child)
    end
end)
 
----------------------------------------------------------------
-- EVENT DARI SERVER
----------------------------------------------------------------
UIEvent.OnClientEvent:Connect(function(action, a, b)
    if action == "Start" then
        startCarry()
    elseif action == "End" then
    endCarry()
    elseif action == "Pets" then
        petState.Placed = a or {}
        petState.Items = b or {}
        rebuildList()
    elseif action == "Income" then
        showIncomePopup(a)
    elseif action == "Notice" then
        popupText(a, false)
    elseif action == "Knockback" then
        local char = player.Character
        local root = char and char:FindFirstChild("HumanoidRootPart")
        if root then
            root.AssemblyLinearVelocity = a -- client yang pegang fisika karakter
        end
    elseif action == "Offline" then
        showOffline(a, b)
    elseif action == "OfflineClaimed" then
        hideOffline()
        showIncomePopup(a)
    end
end)
 
----------------------------------------------------------------
-- 4) PROMPT "Take" di Pet milik sendiri (dibuat lokal, jadi cuma pemilik yang lihat)
----------------------------------------------------------------
local function setupTake(model)
    if model:GetAttribute("OwnerId") ~= player.UserId then return end
 
    local anchor = model:WaitForChild("PromptAnchor", 10)
    if not anchor or anchor:FindFirstChild("TakePrompt") then return end
 
    local prompt = Instance.new("ProximityPrompt")
    prompt.Name = "TakePrompt"
    prompt.ActionText = "Take"
    prompt.ObjectText = model:GetAttribute("PetName") or model.Name
    prompt.HoldDuration = 0
    prompt.MaxActivationDistance = 10
    prompt.RequiresLineOfSight = false
    prompt.Parent = anchor
 
    prompt.Triggered:Connect(function()
        ActionEvent:FireServer("Take", model)
    end)
end
 
CollectionService:GetInstanceAddedSignal("AreaPet"):Connect(function(model)
    task.spawn(setupTake, model)
end)
for _, model in ipairs(CollectionService:GetTagged("AreaPet")) do
    task.spawn(setupTake, model)
end
 
----------------------------------------------------------------
-- WARNA RARITY di PetGui milik Tool Pet (di Backpack / dipegang)
----------------------------------------------------------------
local colored = setmetatable({}, { __mode = "k" })
 
local function processTool(tool)
    if not tool:IsA("Tool") or not tool:GetAttribute("PetTool") or colored[tool] then return end
    colored[tool] = true
 
    local gui = tool:FindFirstChild("PetGui", true)
    applyRarity(gui and gui:FindFirstChild("Rarity"), tool:GetAttribute("Rarity"))
 
    -- Pegang Pet + ketuk Part "Place" = Place Pet (jalan juga di HP, gak bergantung ClickDetector)
    tool.Activated:Connect(function()
        local target = player:GetMouse().Target
        if target and target.Name == "Place" then
            ActionEvent:FireServer("Place", target)
        end
    end)
end
 
local function watch(container)
    for _, child in ipairs(container:GetChildren()) do
        processTool(child)
    end
    container.ChildAdded:Connect(processTool)
end
 
task.spawn(function()
    watch(player:WaitForChild("Backpack"))
end)
 
if player.Character then
    watch(player.Character)
end
player.CharacterAdded:Connect(function(char)
    watch(char)
    task.spawn(function()
        watch(player:WaitForChild("Backpack"))
    end)
end)

]]></ProtectedString>
