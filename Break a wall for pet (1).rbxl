<Item class="LocalScript" referent="RBXCE0869D075DF4A55B454104037AE4BA1">
<Properties>
<BinaryString name="AttributesSerialize"></BinaryString>
<bool name="Disabled">false</bool>
<Content name="LinkedSource"><null></null></Content>
<string name="Name">Script</string>
<token name="RunContext">0</token>
<string name="ScriptGuid">{A7A2C6D1-8936-4D8F-A45D-9A2AE9525164}</string>
<ProtectedString name="Source"><![CDATA[local RunService = game:GetService("RunService")
local label = script.Parent
 
local speed = 0.18
 
local colors = {
Color3.fromRGB(100, 200, 255), -- Sky Blue
Color3.fromRGB(120, 240, 255), -- Cyan
Color3.fromRGB(220, 250, 255), -- Ice White
Color3.fromRGB(170, 150, 255), -- Celestial Purple
Color3.fromRGB(255, 180, 230), -- Starlight Pink
Color3.fromRGB(100, 200, 255), -- Sky Blue
}
 
local function getCelestialColor(t)
    local position = (t % 1) * (#colors - 1)
    local index = math.floor(position) + 1
    local alpha = position % 1
    
    return colors[index]:Lerp(colors[index + 1], alpha)
end
 
RunService.RenderStepped:Connect(function()
    local t = os.clock() * speed
    label.TextColor3 = getCelestialColor(t)
end)

]]></ProtectedString>
<UniqueId name="UniqueId">7bdf20b295fbe64d068940403800437f</UniqueId>
