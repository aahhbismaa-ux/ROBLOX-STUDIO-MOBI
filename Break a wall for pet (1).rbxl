},
 
-- SECRET
{
Name = "Shadow Pickaxe",
Rarity = "Secret",
Power = 16000,
Cost = 40000000,
RobuxPrice = 1999,
RobuxProductId = 0,
},
{
Name = "Venom Pickaxe",
Rarity = "Secret",
