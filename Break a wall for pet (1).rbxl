<Content name="LinkedSource"><null></null></Content>
<string name="Name">IndexService</string>
<string name="ScriptGuid">{26CAB37F-80B5-4B07-BE72-6C2F597CDDB4}</string>
<ProtectedString name="Source"><![CDATA[-- ModuleScript: ServerScriptService > IndexService
--
-- Semua urusan server untuk Index (dipakai IndexServer & PetStealServer):
--   * Data  : Section "Index" di DataService = { Discovered = { ["White Bunny"] = true, ... } }
--             (ikut ke-save otomatis: autosave, keluar game, server mati)
--   * Boost : Boost tertinggi dari semua Area yang Complete (lihat IndexConfig)
--   * Remote: ReplicatedStorage > Configuration > IndexRemotes > IndexUI / IndexAction
--
-- API:
--   IndexService.Discover(plr, petName)  -> tandai Pet sudah didapat
--   IndexService.GetBoost(plr)           -> pengali Sheckles (1 kalau belum ada Area Complete)

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerScriptService = game:GetService("ServerScriptService")

local DataService = require(ServerScriptService:WaitForChild("DataService"))

local ConfigFolder = ReplicatedStorage:WaitForChild("Configuration")
local Modules = ConfigFolder:WaitForChild("Modules")
local IndexConfig = require(Modules:WaitForChild("Index"):WaitForChild("IndexConfig"))
local PetConfig = require(Modules:WaitForChild("Area"):WaitForChild("Pet"):WaitForChild("PetConfig"))

local IndexService = {}

----------------------------------------------------------------
-- REMOTES
----------------------------------------------------------------
local Remotes = Instance.new("Folder")
Remotes.Name = "IndexRemotes"
Remotes.Parent = ConfigFolder

local UIEvent = Instance.new("RemoteEvent")
UIEvent.Name = "IndexUI" -- server -> client ("Sync", discovered, boost, newPetName)
UIEvent.Parent = Remotes

local ActionEvent = Instance.new("RemoteEvent")
ActionEvent.Name = "IndexAction" -- client -> server ("Sync")
ActionEvent.Parent = Remotes

----------------------------------------------------------------
-- DATA
----------------------------------------------------------------
local function getSec(plr)
    local sec = DataService.Section(plr, "Index")
    if not sec then return nil end
    
    if type(sec.Discovered) ~= "table" then
        sec.Discovered = {}
    end
    return sec
end

-- Hitung Boost dari Area yang Complete (semua Pet di Area itu sudah didapat)
local function computeBoost(sec)
    local best = 1
    
    for areaIndex, pets in pairs(PetConfig.Areas) do
        if type(pets) == "table" and #pets > 0 then
            local complete = true
            for _, def in ipairs(pets) do
                if not sec.Discovered[def.Name] then
                    complete = false
                    break
                end
            end
            
            if complete then
                local cfg = IndexConfig.Areas[areaIndex]
                local boost = cfg and tonumber(cfg.Boost) or 1
                if boost > best then
                    best = boost
                end
            end
        end
    end
    
    return best
end

function IndexService.GetBoost(plr)
    local sec = getSec(plr)
    if not sec then return 1 end
    return computeBoost(sec)
end

local function push(plr, newPet)
    local sec = getSec(plr)
    if not sec or not plr.Parent then return end
    
    local boost = computeBoost(sec)
    plr:SetAttribute("IndexBoost", boost)
    
    local copy = {}
    for name, v in pairs(sec.Discovered) do
        if v then
            copy[name] = true
        end
    end
    
    UIEvent:FireClient(plr, "Sync", copy, boost, newPet)
end

function IndexService.Discover(plr, petName)
    if type(petName) ~= "string" then return end
    
    local sec = getSec(plr)
    if not sec then return end
    if sec.Discovered[petName] then return end
    
    sec.Discovered[petName] = true
    push(plr, petName)
end

----------------------------------------------------------------
-- PLAYER
----------------------------------------------------------------
-- Pet yang sudah dimiliki sebelum ada Index (Backpack & Base) langsung dihitung
DataService.OnLoaded(function(plr)
    local sec = getSec(plr)
    if not sec then return end
    
    local pets = DataService.Section(plr, "Pets")
    if pets then
        for _, listName in ipairs({ "Items", "Placed" }) do
            local list = pets[listName]
            if type(list) == "table" then
                for _, e in ipairs(list) do
                    if type(e) == "table" and type(e.Name) == "string" then
                        sec.Discovered[e.Name] = true
                    end
                end
            end
        end
    end
    
    push(plr)
end)

local syncDebounce = {}

ActionEvent.OnServerEvent:Connect(function(plr, action)
    if action == "Sync" then
        local last = syncDebounce[plr]
        if last and os.clock() - last < 0.5 then return end
        syncDebounce[plr] = os.clock()
        push(plr)
    end
end)

Players.PlayerRemoving:Connect(function(plr)
    syncDebounce[plr] = nil
end)

return IndexService

]]></ProtectedString>
<UniqueId name="UniqueId">7bdf20b295fbe64d0689401538004383</UniqueId>
</Properties>
