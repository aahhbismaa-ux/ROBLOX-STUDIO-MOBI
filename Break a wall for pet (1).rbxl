<Item class="Script" referent="RBX66C1625455D04AC580D8101531513A7E">
<Properties>
<BinaryString name="AttributesSerialize"></BinaryString>
<bool name="Disabled">false</bool>
<Content name="LinkedSource"><null></null></Content>
<string name="Name">AreaServer</string>
<token name="RunContext">0</token>
<string name="ScriptGuid">{FF361BB9-5B67-4864-AADE-7E5A85E36A3E}</string>
<ProtectedString name="Source"><![CDATA[-- Script: ServerScriptService > AreaServer
-- Cuma masang WallGui ke semua Wall di semua Area.
-- (HP, pukulan, hancur & muncul lagi diurus client: AreaClient, jadi sendiri-sendiri)
 
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerStorage = game:GetService("ServerStorage")
 
local Modules = ReplicatedStorage:WaitForChild("Configuration"):WaitForChild("Modules")
local NumberFormatModule = require(Modules:WaitForChild("NumberFormat"))
local AreaDisplay = require(Modules:WaitForChild("Area"):WaitForChild("AreaDisplay"):WaitForChild("AreaDisplayConfig"))
local WallConfig = require(Modules:WaitForChild("Area"):WaitForChild("Wall"):WaitForChild("WallConfig"))
 
local AreaFolder = workspace:WaitForChild("Map"):WaitForChild("System"):WaitForChild("Area")
 
-- ServerStorage > Configuration(BillboardGui) > BillboardGui(WallGui)
local guiHolder = ServerStorage:WaitForChild("BillboardGui")
local WallGuiTemplate = guiHolder:FindFirstChild("WallGui") or guiHolder:WaitForChild("WallGui", 10)
 
local function fmt(n)
    if type(NumberFormatModule) == "function" then
        return NumberFormatModule(n)
    elseif type(NumberFormatModule) == "table" and NumberFormatModule.Format then
        return NumberFormatModule.Format(n)
    end
    return tostring(n)
end
 
local function pickAdornee(model)
    if model.PrimaryPart then
        return model.PrimaryPart
    end
 
    local best, bestVolume = nil, -1
    for _, d in ipairs(model:GetDescendants()) do
        if d:IsA("BasePart") then
            local v = d.Size.X * d.Size.Y * d.Size.Z
            if v > bestVolume then
                best, bestVolume = d, v
            end
        end
    end
    return best
end
 
local function setupWall(model, areaIndex)
    local display = AreaDisplay[areaIndex]
    local settings = WallConfig.Walls[areaIndex]
    if not display or not settings then
        warn("Area " .. tostring(areaIndex) .. " belum ada di AreaDisplayConfig / WallConfig")
        return
    end
 
    local adornee = pickAdornee(model)
    if not adornee then return end
 
    local old = model:FindFirstChild("WallGui")
    if old then old:Destroy() end
 
    local gui = WallGuiTemplate:Clone()
    gui.Name = "WallGui"
    gui.Adornee = adornee
 
    -- WallGui > Background > Text (nama Area). Fallback ke WallGui > Text kalau susunan lama.
    local background = gui:FindFirstChild("Background")
    local nameLabel = (background and background:FindFirstChild("Text")) or gui:FindFirstChild("Text")
    if nameLabel then
        nameLabel.Text = '["' .. display.Name .. ' Wall"]'
    end
 
    local hpFrame = gui:FindFirstChild("Hp")
    if hpFrame then
        local hpText = hpFrame:FindFirstChild("Text")
        if hpText then
            hpText.Text = fmt(settings.HP) .. "/" .. fmt(settings.HP) .. " Hp"
        end
        local fill = hpFrame:FindFirstChild("Fill")
        if fill then
            fill.Size = UDim2.new(1, 0, 1, 0)
        end
    end
 
    gui.Parent = model
end
 
if not WallGuiTemplate then
    warn("ServerStorage > BillboardGui > WallGui tidak ditemukan!")
else
    for _, area in ipairs(AreaFolder:GetChildren()) do
        local index = tonumber(area.Name)
        if index then
            for _, wall in ipairs(area:GetChildren()) do
                if wall:IsA("Model") and wall.Name ~= "Guard" then
                    setupWall(wall, index)
                end
            end
        end
    end
end

]]></ProtectedString>
<UniqueId name="UniqueId">706ce791354c7e1f067d8015320041fa</UniqueId>
