<Item class="Script" referent="RBX66C1625455D04AC580D8102961513A7E">
<Properties>
<BinaryString name="AttributesSerialize"></BinaryString>
<bool name="Disabled">false</bool>
<Content name="LinkedSource"><null></null></Content>
<string name="Name">AutoWeldScript</string>
<token name="RunContext">0</token>
<string name="ScriptGuid">{FF361BB9-5B67-4864-AADE-7E5A85E36A3E}</string>
<ProtectedString name="Source"><![CDATA[local tool = script.Parent
local handle = tool:WaitForChild("Handle")
 
for _, obj in ipairs(tool:GetDescendants()) do
    if obj:IsA("BasePart") and obj ~= handle then
        obj.Anchored = false
        
        local weld = Instance.new("WeldConstraint")
        weld.Part0 = handle
        weld.Part1 = obj
        weld.Parent = handle
    end
end
 
handle.Anchored = false
 
print("Auto Weld berhasil!")

]]></ProtectedString>
<UniqueId name="UniqueId">706ce791354c7e1f067d8029620041fa</UniqueId>
