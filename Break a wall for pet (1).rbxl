<string name="Name">Script</string>
<token name="RunContext">0</token>
<string name="ScriptGuid">{A7A2C6D1-8936-4D8F-A45D-9A2AE9525164}</string>
<ProtectedString name="Source"><![CDATA[local RunService = game:GetService("RunService")
local label = script.Parent
 
local waktu = 0
 
RunService.RenderStepped:Connect(function(dt)
    waktu += dt
    
    -- Animasi hitam putih Secret
    local brightness = (math.sin(waktu * 2) + 1) / 2
    
    label.TextColor3 = Color3.fromRGB(
    math.floor(20 + brightness * 235),
    math.floor(20 + brightness * 235),
    math.floor(20 + brightness * 235)
    )
end)

]]></ProtectedString>
<UniqueId name="UniqueId">7bdf20b295fbe64d068940404400437f</UniqueId>
