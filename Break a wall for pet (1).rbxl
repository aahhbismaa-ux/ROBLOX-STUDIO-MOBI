<Item class="Script" referent="RBX66C1625455D04AC580D8101551513A7E">
<Properties>
<BinaryString name="AttributesSerialize"></BinaryString>
<bool name="Disabled">false</bool>
<Content name="LinkedSource"><null></null></Content>
<string name="Name">PickaxeServer</string>
<token name="RunContext">0</token>
<string name="ScriptGuid">{FF361BB9-5B67-4864-AADE-7E5A85E36A3E}</string>
<ProtectedString name="Source"><![CDATA[-- Script: ServerScriptService > PickaxeServer
-- Khusus Pickaxe Shop (Treadmill ada di script sendiri: TreadmillServer)
 
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerStorage = game:GetService("ServerStorage")
local ServerScriptService = game:GetService("ServerScriptService")
local MarketplaceService = game:GetService("MarketplaceService")
 
local DataService = require(ServerScriptService:WaitForChild("DataService"))
 
local ConfigFolder = ReplicatedStorage:WaitForChild("Configuration")
local Modules = ConfigFolder:WaitForChild("Modules")
local PickaxeConfig = require(Modules:WaitForChild("Pickaxe"):WaitForChild("PickaxeConfig"))
 
local saveZone = ServerStorage:WaitForChild("Configuration"):WaitForChild("SaveZone", 10)
local PickaxeTools = saveZone and saveZone:WaitForChild("Pickaxe", 10)
if not PickaxeTools then
    warn("ServerStorage.Configuration.SaveZone.Pickaxe tidak ditemukan!")
end
 
----------------------------------------------------------------
-- REMOTES
----------------------------------------------------------------
local Remotes = Instance.new("Folder")
Remotes.Name = "PickaxeRemotes"
Remotes.Parent = ConfigFolder
 
local PickaxeEvent = Instance.new("RemoteEvent")
PickaxeEvent.Name = "PickaxeEvent" -- server -> client
PickaxeEvent.Parent = Remotes
 
local PickaxeAction = Instance.new("RemoteEvent")
PickaxeAction.Name = "PickaxeAction" -- client -> server
PickaxeAction.Parent = Remotes
 
-- Salinan Tool (tanpa script) biar client bisa nampilin di ViewportFrame
local DisplayFolder = Instance.new("Folder")
DisplayFolder.Name = "PickaxeDisplay"
DisplayFolder.Parent = ReplicatedStorage
 
local productToPickaxe = {}
 
for _, def in ipairs(PickaxeConfig.Pickaxes) do
    local tool = PickaxeTools and PickaxeTools:FindFirstChild(def.Name)
    if tool then
        local copy = tool:Clone()
        for _, d in ipairs(copy:GetDescendants()) do
            if d:IsA("LuaSourceContainer") then
                d:Destroy()
            end
        end
        copy.Parent = DisplayFolder
    else
        warn("Tool '" .. def.Name .. "' tidak ada di SaveZone.Pickaxe")
    end
 
    if def.RobuxProductId and def.RobuxProductId ~= 0 then
        productToPickaxe[def.RobuxProductId] = def
    end
end
 
----------------------------------------------------------------
-- SWING (satu untuk SEMUA pickaxe: Tool-nya gak perlu Script / LocalScript lagi)
-- Diambil dari Script Swing kamu, tinggal dibikin umum.
----------------------------------------------------------------
local RunService = game:GetService("RunService")
local Debris = game:GetService("Debris")
 
local SwingRemote = Instance.new("RemoteEvent")
SwingRemote.Name = "PickaxeSwing" -- client -> server "Swing" | server -> client "CameraShake"
SwingRemote.Parent = Remotes
 
local COOLDOWN = 0.85
local HIT_RANGE = 6
 
local HIT_SOUND_ID = "rbxassetid://7578813634"
local SWING_SOUND_ID = "rbxassetid://121272356429838"
 
local V = Vector3.new
 
local POSE_WINDUP = {
shoulder = V(110, 0, 0),
elbow = V(30, 0, 0),
waist = V(14, 20, 0),
neck = V(12, -8, 0),
}
 
local POSE_STRIKE = {
shoulder = V(-35, 0, 0),
elbow = V(5, 0, 0),
waist = V(-26, -24, 0),
neck = V(-14, 8, 0),
}
 
local POSE_IMPACT = {
shoulder = V(-46, 0, 0),
elbow = V(0, 0, 0),
waist = V(-30, -26, 0),
neck = V(-18, 10, 0),
}
 
local POSE_ZERO = {}
 
local Ease = {}
 
function Ease.outCubic(t) return 1 - (1 - t) ^ 3 end
function Ease.inCubic(t) return t ^ 3 end
function Ease.outQuad(t) return 1 - (1 - t) ^ 2 end
function Ease.inOutSine(t) return -(math.cos(math.pi * t) - 1) / 2 end
function Ease.outBack(t)
    local c1 = 1.70158
    local c3 = c1 + 1
    return 1 + c3 * (t - 1) ^ 3 + c1 * (t - 1) ^ 2
end
 
local SEGMENTS = {
{ name = "windup", time = 0.26, pose = POSE_WINDUP, ease = Ease.outCubic },
{ name = "hold", time = 0.06, pose = POSE_WINDUP, ease = Ease.inOutSine },
{ name = "strike", time = 0.10, pose = POSE_STRIKE, ease = Ease.inCubic },
{ name = "impact", time = 0.07, pose = POSE_IMPACT, ease = Ease.outQuad },
{ name = "recover", time = 0.40, pose = POSE_ZERO, ease = Ease.outBack },
}
 
-- RIG R6 / R15
local function findMotor(character, name)
    local obj = character:FindFirstChild(name, true)
    if obj and obj:IsA("Motor6D") then
        return obj
    end
    return nil
end
 
local function makeJoint(motor, scale)
    if not motor then return nil end
    return { motor = motor, base = motor.C0, scale = scale or 1 }
end
 
local function buildRig(character)
    local rig = {}
 
    local isR15 = character:FindFirstChild("RightUpperArm")
 
    if isR15 then
        rig.shoulder = makeJoint(findMotor(character, "RightShoulder"))
        rig.elbow = makeJoint(findMotor(character, "RightElbow"))
        rig.waist = makeJoint(findMotor(character, "Waist"))
        rig.neck = makeJoint(findMotor(character, "Neck"))
    else
        rig.shoulder = makeJoint(findMotor(character, "Right Shoulder"))
        rig.neck = makeJoint(findMotor(character, "Neck"))
        rig.waist = makeJoint(findMotor(character, "RootJoint"), 0.5)
    end
 
    if not rig.shoulder then
        return nil
    end
 
    return rig
end
 
local function applyPose(rig, pose)
    for name, joint in pairs(rig) do
        local v = pose[name] or Vector3.zero
        local s = joint.scale
 
        joint.motor.C0 = CFrame.new(joint.base.Position)
        * CFrame.Angles(math.rad(v.X * s), math.rad(v.Y * s), math.rad(v.Z * s))
        * joint.base.Rotation
    end
end
 
local function resetRig(rig)
    for _, joint in pairs(rig) do
        if joint.motor.Parent then
            joint.motor.C0 = joint.base
        end
    end
end
 
local function lerpPose(a, b, alpha)
    local result = {}
    local keys = {}
 
    for k in pairs(a) do keys[k] = true end
    for k in pairs(b) do keys[k] = true end
 
    for k in pairs(keys) do
        result[k] = (a[k] or Vector3.zero):Lerp(b[k] or Vector3.zero, alpha)
    end
 
    return result
end
 
local function playSound(handle, id)
    if id == "" or not handle then return end
 
    local sound = Instance.new("Sound")
    sound.SoundId = id
    sound.Volume = 1
    sound.PlaybackSpeed = 0.95 + math.random() * 0.1
    sound.Parent = handle
    sound:Play()
 
    Debris:AddItem(sound, 3)
end
 
-- Trail ayunan (dibuat sekali per Tool)
local function ensureTrail(handle)
    local existing = handle:FindFirstChild("SwingTrail")
    if existing then return existing end
 
    local s = handle.Size
    local axis, len
 
    if s.X >= s.Y and s.X >= s.Z then
        axis, len = Vector3.xAxis, s.X
    elseif s.Y >= s.Z then
        axis, len = Vector3.yAxis, s.Y
    else
        axis, len = Vector3.zAxis, s.Z
    end
 
    local a0 = Instance.new("Attachment")
    a0.Name = "SwingTrailA"
    a0.Position = axis * (len / 2)
    a0.Parent = handle
 
    local a1 = Instance.new("Attachment")
    a1.Name = "SwingTrailB"
    a1.Position = axis * (len / 2 - 0.9)
    a1.Parent = handle
 
    local trail = Instance.new("Trail")
    trail.Name = "SwingTrail"
    trail.Attachment0 = a0
    trail.Attachment1 = a1
    trail.Lifetime = 0.18
    trail.MinLength = 0
    trail.LightEmission = 0.6
    trail.Color = ColorSequence.new(Color3.new(1, 1, 1))
    trail.Transparency = NumberSequence.new({
    NumberSequenceKeypoint.new(0, 0.2),
    NumberSequenceKeypoint.new(1, 1),
    })
    trail.Enabled = false
    trail.Parent = handle
 
    return trail
end
 
-- Debu & percikan di titik pukulan
local function impactBurst(character)
    local root = character:FindFirstChild("HumanoidRootPart")
    if not root then return end
 
    local params = RaycastParams.new()
    params.FilterDescendantsInstances = { character }
    params.FilterType = Enum.RaycastFilterType.Exclude
 
    local dir = root.CFrame.LookVector * HIT_RANGE + Vector3.new(0, -3, 0)
    local result = workspace:Raycast(root.Position, dir, params)
 
    local pos = result and result.Position
    or root.Position + root.CFrame.LookVector * 4 + Vector3.new(0, -2.5, 0)
 
    local color = Color3.fromRGB(150, 150, 150)
    if result and result.Instance:IsA("BasePart") then
        color = result.Instance.Color
    end
 
    local anchor = Instance.new("Part")
    anchor.Name = "PickaxeImpact"
    anchor.Anchored = true
    anchor.CanCollide = false
    anchor.CanQuery = false
    anchor.CanTouch = false
    anchor.Transparency = 1
    anchor.Size = Vector3.new(0.2, 0.2, 0.2)
    anchor.Position = pos
    anchor.Parent = workspace
 
    local debrisParticles = Instance.new("ParticleEmitter")
    debrisParticles.Rate = 0
    debrisParticles.Lifetime = NumberRange.new(0.35, 0.7)
    debrisParticles.Speed = NumberRange.new(12, 24)
    debrisParticles.SpreadAngle = Vector2.new(55, 55)
    debrisParticles.Acceleration = Vector3.new(0, -60, 0)
    debrisParticles.Size = NumberSequence.new({
    NumberSequenceKeypoint.new(0, 0.35),
    NumberSequenceKeypoint.new(1, 0),
    })
    debrisParticles.Color = ColorSequence.new(color)
    debrisParticles.RotSpeed = NumberRange.new(-300, 300)
    debrisParticles.Parent = anchor
    debrisParticles:Emit(14)
 
    local spark = Instance.new("ParticleEmitter")
    spark.Rate = 0
    spark.Lifetime = NumberRange.new(0.12, 0.25)
    spark.Speed = NumberRange.new(18, 32)
    spark.SpreadAngle = Vector2.new(70, 70)
    spark.LightEmission = 1
    spark.Size = NumberSequence.new({
    NumberSequenceKeypoint.new(0, 0.25),
    NumberSequenceKeypoint.new(1, 0),
    })
    spark.Color = ColorSequence.new(Color3.fromRGB(255, 220, 120))
    spark.Parent = anchor
    spark:Emit(8)
 
    Debris:AddItem(anchor, 1.5)
end
 
local swinging = {}
local lastSwing = {}
local activeRig = {}
local activeTrail = {}
 
local function getHeldPickaxe(character)
    for _, child in ipairs(character:GetChildren()) do
        if child:IsA("Tool") and child:GetAttribute("ShopPickaxe") then
            return child
        end
    end
    return nil
end
 
-- Swing dihentikan (Tool dilepas / mati / keluar): tangan dikembalikan ke posisi asli
local function cancelSwing(player)
    swinging[player] = nil
 
    local rig = activeRig[player]
    if rig then
        resetRig(rig)
        activeRig[player] = nil
    end
 
    local trail = activeTrail[player]
    if trail then
        trail.Enabled = false
        activeTrail[player] = nil
    end
end
 
local function swing(player)
    local character = player.Character
    if not character then return end
 
    local tool = getHeldPickaxe(character)
    local handle = tool and tool:FindFirstChild("Handle")
    if not tool or not handle then return end
 
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    if not humanoid or humanoid.Health <= 0 then return end
 
    if swinging[player] then return end
 
    local now = os.clock()
    if lastSwing[player] and now - lastSwing[player] < COOLDOWN then return end
 
    local rig = buildRig(character)
    if not rig then return end
 
    lastSwing[player] = now
 
    local token = {}
    swinging[player] = token
    activeRig[player] = rig
 
    local trail = ensureTrail(handle)
    activeTrail[player] = trail
 
    playSound(handle, SWING_SOUND_ID)
 
    local current = {}
 
    for _, seg in ipairs(SEGMENTS) do
        local from = current
        local segStart = os.clock()
 
        if seg.name == "strike" then
            trail.Enabled = true
        end
 
        while true do
            if swinging[player] ~= token or humanoid.Health <= 0 or tool.Parent ~= character then
                resetRig(rig)
                trail.Enabled = false
                if swinging[player] == token then
                    swinging[player] = nil
                end
                return
            end
 
            local t = math.clamp((os.clock() - segStart) / seg.time, 0, 1)
            local pose = lerpPose(from, seg.pose, seg.ease(t))
 
            applyPose(rig, pose)
            current = pose
 
            if t >= 1 then break end
 
            RunService.Heartbeat:Wait()
        end
 
        if seg.name == "strike" then
            playSound(handle, HIT_SOUND_ID)
            impactBurst(character)
 
            -- Camera shake + sinyal "pukulan mendarat" cuma ke pemilik Pickaxe
            SwingRemote:FireClient(player, "CameraShake")
        end
 
        if seg.name == "impact" then
            trail.Enabled = false
        end
    end
 
    resetRig(rig)
    trail.Enabled = false
 
    if swinging[player] == token then
        swinging[player] = nil
        activeRig[player] = nil
        activeTrail[player] = nil
    end
end
 
SwingRemote.OnServerEvent:Connect(function(player, action)
    if action == "Swing" then
        swing(player)
    end
end)
 
Players.PlayerRemoving:Connect(function(player)
    cancelSwing(player)
    lastSwing[player] = nil
end)
 
----------------------------------------------------------------
-- STATE
----------------------------------------------------------------
local state = {} -- [player] = section "Pickaxe" {Owned = {[nama]=true}, Equipped = nama/nil}
 
local function getSheckles(plr)
    local ls = plr:FindFirstChild("leaderstats")
    return ls and ls:FindFirstChild("Sheckles")
end
 
local function pushState(plr)
    local st = state[plr]
    if not st then return end
    PickaxeEvent:FireClient(plr, "State", st.Owned, st.Equipped)
end
 
local function clearShopTools(container)
    if not container then return end
    for _, item in ipairs(container:GetChildren()) do
        if item:IsA("Tool") and item:GetAttribute("ShopPickaxe") then
            item:Destroy()
        end
    end
end
 
-- Hapus Tool pickaxe lama, kasih yang sedang di-Equip ke Backpack
local function givePickaxe(plr)
    local st = state[plr]
    if not st then return end
 
    clearShopTools(plr:FindFirstChild("Backpack"))
    clearShopTools(plr.Character)
 
    if not st.Equipped or not PickaxeTools then return end
 
    local template = PickaxeTools:FindFirstChild(st.Equipped)
    local backpack = plr:FindFirstChild("Backpack")
    if template and backpack then
        local tool = template:Clone()
 
        -- Script / LocalScript lama di dalam Tool dibuang: Swing diurus PickaxeServer (satu untuk semua)
        for _, d in ipairs(tool:GetDescendants()) do
            if d:IsA("LuaSourceContainer") then
                d:Destroy()
            end
        end
 
        tool:SetAttribute("ShopPickaxe", true)
        tool.Unequipped:Connect(function()
            cancelSwing(plr)
        end)
        tool.Parent = backpack
    end
end
 
----------------------------------------------------------------
-- ACTIONS
----------------------------------------------------------------
PickaxeAction.OnServerEvent:Connect(function(plr, action, name)
    local st = state[plr]
    if not st then return end
 
    if action == "Sync" then
        pushState(plr)
        return
    end
 
    if type(name) ~= "string" then return end
    local def = PickaxeConfig.ByName[name]
    if not def then return end
 
    if action == "Purchase" then
        -- Tool-nya belum ada di ServerStorage > SaveZone > Pickaxe? jangan dijual dulu
        if not (PickaxeTools and PickaxeTools:FindFirstChild(name)) then return end
 
        if not st.Owned[name] then
            -- Beli pakai Sheckles
            local sheckles = getSheckles(plr)
            if not sheckles or sheckles.Value < def.Cost then return end
            sheckles.Value -= def.Cost
            st.Owned[name] = true
        elseif st.Equipped == name then
            -- Unequip
            st.Equipped = nil
            givePickaxe(plr)
        else
            -- Equip (otomatis ganti pickaxe sebelumnya)
            st.Equipped = name
            givePickaxe(plr)
        end
        pushState(plr)
 
    elseif action == "Robux" then
        if st.Owned[name] then return end
        if not def.RobuxProductId or def.RobuxProductId == 0 then return end
        MarketplaceService:PromptProductPurchase(plr, def.RobuxProductId)
    end
end)
 
MarketplaceService.ProcessReceipt = function(receipt)
    local plr = Players:GetPlayerByUserId(receipt.PlayerId)
    local def = productToPickaxe[receipt.ProductId]
    local st = plr and state[plr]
 
    if not plr or not st or not def then
        return Enum.ProductPurchaseDecision.NotProcessedYet
    end
 
    st.Owned[def.Name] = true
    pushState(plr)
 
    if DataService.Save(plr) then
        return Enum.ProductPurchaseDecision.PurchaseGranted
    end
    return Enum.ProductPurchaseDecision.NotProcessedYet
end
 
----------------------------------------------------------------
-- PLAYER
----------------------------------------------------------------
local function onPlayerAdded(plr)
    -- Backpack di-reset tiap respawn, jadi kasih lagi
    plr.CharacterAdded:Connect(function()
        task.wait(0.1)
        givePickaxe(plr)
    end)
end
 
Players.PlayerAdded:Connect(onPlayerAdded)
for _, plr in ipairs(Players:GetPlayers()) do
    task.spawn(onPlayerAdded, plr)
end
 
-- Data sudah ke-load (dari DataService)
DataService.OnLoaded(function(plr)
    local st = DataService.Section(plr, "Pickaxe")
    if not st then return end
 
    local owned = {}
    if type(st.Owned) == "table" then
        for name, v in pairs(st.Owned) do
            if v == true and PickaxeConfig.ByName[name] then
                owned[name] = true
            end
        end
    end
    st.Owned = owned
 
    if type(st.Equipped) ~= "string" or not owned[st.Equipped] then
        st.Equipped = nil
    end
 
    state[plr] = st
    givePickaxe(plr)
    pushState(plr)
end)
 
Players.PlayerRemoving:Connect(function(plr)
    state[plr] = nil
end)

]]></ProtectedString>
