<Item class="LocalScript" referent="RBXCE0869D075DF4A55B454100607AE4BA1">
<Properties>
<BinaryString name="AttributesSerialize"></BinaryString>
<bool name="Disabled">false</bool>
<Content name="LinkedSource"><null></null></Content>
<string name="Name">PickaxeClient</string>
<token name="RunContext">0</token>
<string name="ScriptGuid">{A7A2C6D1-8936-4D8F-A45D-9A2AE9525164}</string>
<ProtectedString name="Source"><![CDATA[-- LocalScript: StarterPlayer > StarterPlayerScripts > PickaxeClient
-- Khusus Pickaxe Shop (Treadmill ada di script sendiri: TreadmillClient)
--
-- Struktur GUI (di StarterGui):
-- MainGui > GameHub > Frame > Frame > PickaxeFrame
--   Top > Close
--   Main (ScrollingFrame) > UIListLayout, Template (ImageLabel)
--     Template > Pickaxe (ViewportFrame) > Name / Rarity / Power
--     Template > Purchase (Frame) > RobuxPurchase, Purchase
--
-- Satu-satunya "kontak" dengan Treadmill: attribute player "OnTreadmill"
-- (toko nutup & gak bisa dibuka pas lagi di treadmill).

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local RunService = game:GetService("RunService")

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

local Configuration = ReplicatedStorage:WaitForChild("Configuration")
local Modules = Configuration:WaitForChild("Modules")
local NumberFormatModule = require(Modules:WaitForChild("NumberFormat"))
local PickaxeConfig = require(Modules:WaitForChild("Pickaxe"):WaitForChild("PickaxeConfig"))
local RarityFolder = Configuration:WaitForChild("Colors"):WaitForChild("Rarity")

local Remotes = Configuration:WaitForChild("PickaxeRemotes")
local PickaxeEvent = Remotes:WaitForChild("PickaxeEvent")
local PickaxeAction = Remotes:WaitForChild("PickaxeAction")
local PickaxeDisplay = ReplicatedStorage:WaitForChild("PickaxeDisplay")

local function fmt(n)
    if type(NumberFormatModule) == "function" then
        return NumberFormatModule(n)
    elseif type(NumberFormatModule) == "table" and NumberFormatModule.Format then
        return NumberFormatModule.Format(n)
    end
    return tostring(n)
end

-- FindFirstChild (aman untuk nama "Name" / "Text" yang bentrok dengan property)
local function find(parent, name, recursive)
    return parent and parent:FindFirstChild(name, recursive)
end

----------------------------------------------------------------
-- STATE
----------------------------------------------------------------
local refs = nil
local shopOpen = false
local shopCooldown = 0

local shopState = { Owned = {}, Equipped = nil }
local shopEntries = {} -- [pickaxeName] = {...}
local spinners = {}    -- ViewportFrame yang muter

----------------------------------------------------------------
-- RARITY (Colors > Rarity > <NamaRarity>)
----------------------------------------------------------------
local function applyRarity(target, rarityName)
    if not target then return end
    
    local source = RarityFolder:FindFirstChild(rarityName)
    if not source then
        warn("Rarity '" .. tostring(rarityName) .. "' tidak ada di Colors > Rarity")
        return
    end
    
    if source:IsA("UIGradient") then
        source:Clone().Parent = target
    else
        for _, child in ipairs(source:GetChildren()) do
            if child:IsA("UIGradient") then
                child:Clone().Parent = target
            end
        end
    end
end

----------------------------------------------------------------
-- VIEWPORT (Pickaxe muter terus)
----------------------------------------------------------------
local TILT = CFrame.Angles(math.rad(10), 0, math.rad(35))

local function setupViewport(viewport, toolName)
    if not viewport or not viewport:IsA("ViewportFrame") then return end
    
    local tool = PickaxeDisplay:FindFirstChild(toolName)
    if not tool then return end
    
    local copy = tool:Clone()
    local model = Instance.new("Model")
    model.Name = "PickaxeModel"
    for _, child in ipairs(copy:GetChildren()) do
        child.Parent = model
    end
    copy:Destroy()
    
    for _, d in ipairs(model:GetDescendants()) do
        if d:IsA("BasePart") then
            d.Anchored = true
        end
    end
    model.Parent = viewport
    
    local cf, size = model:GetBoundingBox()
    model.WorldPivot = cf
    model:PivotTo(CFrame.new())
    
    local camera = Instance.new("Camera")
    camera.FieldOfView = 40
    local radius = size.Magnitude / 2
    local distance = radius / math.sin(math.rad(camera.FieldOfView / 2))
    camera.CFrame = CFrame.lookAt(Vector3.new(0, 0, distance), Vector3.zero)
    camera.Parent = viewport
    viewport.CurrentCamera = camera
    
    viewport.Ambient = Color3.fromRGB(190, 190, 190)
    viewport.LightColor = Color3.fromRGB(255, 255, 255)
    viewport.LightDirection = Vector3.new(-1, -1, -1)
    
    table.insert(spinners, { Model = model, Viewport = viewport })
end

local angle = 0
RunService.RenderStepped:Connect(function(dt)
    if not refs or not refs.PickaxeFrame.Visible then return end
    
    angle = (angle + dt * 1.5) % (math.pi * 2)
    
    for i = #spinners, 1, -1 do
        local s = spinners[i]
        if not s.Model.Parent or not s.Viewport:IsDescendantOf(playerGui) then
            table.remove(spinners, i)
        else
            s.Model:PivotTo(CFrame.Angles(0, angle, 0) * TILT)
        end
    end
end)

----------------------------------------------------------------
-- SHOP UI
----------------------------------------------------------------
local function updateShop()
    for name, e in pairs(shopEntries) do
        local def = PickaxeConfig.ByName[name]
        local owned = shopState.Owned[name] == true
        
        if e.RobuxButton then
            e.RobuxButton.Visible = not owned
        end
        
        if e.PurchaseText then
            if owned then
                e.PurchaseText.Text = (shopState.Equipped == name) and "Unequip" or "Equip"
            else
                e.PurchaseText.Text = "C$" .. fmt(def.Cost)
            end
        end
    end
end

local function buildShop()
    local r = refs
    table.clear(shopEntries)
    table.clear(spinners)
    
    for _, child in ipairs(r.Main:GetChildren()) do
        if child:GetAttribute("PickaxeEntry") then
            child:Destroy()
        end
    end
    
    r.ShopTemplate.Visible = false
    
    -- Biar semua pickaxe (puluhan) bisa di-scroll
    if r.Main:IsA("ScrollingFrame") then
        r.Main.AutomaticCanvasSize = Enum.AutomaticSize.Y
        r.Main.CanvasSize = UDim2.new(0, 0, 0, 0)
    end
    
    for index, def in ipairs(PickaxeConfig.Pickaxes) do
        -- Pickaxe yang Tool-nya belum ada di ServerStorage > SaveZone > Pickaxe: disembunyikan
        if not PickaxeDisplay:FindFirstChild(def.Name) then
            continue
        end
        
        local entry = r.ShopTemplate:Clone()
        entry.Name = def.Name
        entry.Visible = true
        entry.LayoutOrder = index
        entry:SetAttribute("PickaxeEntry", true)
        
        local viewport = find(entry, "Pickaxe", true)
        local nameLabel = find(entry, "Name", true)
        local rarityLabel = find(entry, "Rarity", true)
        local powerLabel = find(entry, "Power", true)
        
        if nameLabel then nameLabel.Text = def.Name end
        if rarityLabel then rarityLabel.Text = def.Rarity end
        if powerLabel then powerLabel.Text = fmt(def.Power) .. " Power" end
        
        -- Warna rarity: ke Template & teks Rarity
        applyRarity(entry, def.Rarity)
        applyRarity(rarityLabel, def.Rarity)
        
        setupViewport(viewport, def.Name)
        
        local purchaseFrame = find(entry, "Purchase")
        local purchaseButton = find(purchaseFrame, "Purchase")
        local robuxButton = find(purchaseFrame, "RobuxPurchase")
        local purchaseText = find(purchaseButton, "Text") or find(purchaseFrame, "Text")
        local robuxText = find(robuxButton, "Text")
        
        if robuxText then
            robuxText.Text = fmt(def.RobuxPrice or 0)
        end
        
        if purchaseButton then
            purchaseButton.Activated:Connect(function()
                PickaxeAction:FireServer("Purchase", def.Name)
            end)
        end
        
        if robuxButton then
            local flashToken = 0
            robuxButton.Activated:Connect(function()
                if not def.RobuxProductId or def.RobuxProductId == 0 then
                    if robuxText then
                        flashToken += 1
                        local token = flashToken
                        robuxText.Text = "No robux detected!"
                        task.delay(1.5, function()
                            if flashToken == token then
                                robuxText.Text = fmt(def.RobuxPrice or 0)
                            end
                        end)
                    end
                    return
                end
                PickaxeAction:FireServer("Robux", def.Name)
            end)
        end
        
        shopEntries[def.Name] = {
        RobuxButton = robuxButton,
        PurchaseText = purchaseText,
        }
        
        entry.Parent = r.Main
    end
    
    updateShop()
end

local function openShop()
    if shopOpen or not refs then return end
    if player:GetAttribute("OnTreadmill") then return end
    if os.clock() < shopCooldown then return end
    
    shopOpen = true
    refs.PickaxeScale.Scale = 0
    refs.PickaxeFrame.Visible = true
    
    TweenService:Create(
    refs.PickaxeScale,
    TweenInfo.new(0.35, Enum.EasingStyle.Back, Enum.EasingDirection.Out),
    { Scale = 1 }
    ):Play()
end

local function closeShop()
    if not shopOpen or not refs then return end
    
    shopOpen = false
    shopCooldown = os.clock() + 1
    
    local r = refs
    TweenService:Create(
    r.PickaxeScale,
    TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.In),
    { Scale = 0 }
    ):Play()
    
    task.delay(0.22, function()
        if not shopOpen then
            r.PickaxeFrame.Visible = false
        end
    end)
end

-- Toko nutup otomatis pas masuk treadmill
player:GetAttributeChangedSignal("OnTreadmill"):Connect(function()
    if player:GetAttribute("OnTreadmill") then
        closeShop()
    end
end)

PickaxeEvent.OnClientEvent:Connect(function(action, owned, equipped)
    if action == "State" then
        shopState.Owned = owned or {}
        shopState.Equipped = equipped
        updateShop()
    end
end)

-- Hitbox toko: Workspace > Map > Shops > PickaxeShop > Hitbox
task.spawn(function()
    local hitbox = workspace:WaitForChild("Map"):WaitForChild("Shops")
    :WaitForChild("PickaxeShop"):WaitForChild("Hitbox")
    
    hitbox.Touched:Connect(function(hit)
        local char = player.Character
        if char and hit:IsDescendantOf(char) then
            openShop()
        end
    end)
end)

----------------------------------------------------------------
-- GUI (otomatis nyambung lagi kalau MainGui ke-reset pas respawn)
----------------------------------------------------------------
local function bindGui(mainGui)
    local gameHub = mainGui:WaitForChild("GameHub")
    local pickaxeFrame = gameHub:WaitForChild("Frame"):WaitForChild("Frame"):WaitForChild("PickaxeFrame")
    local closeButton = pickaxeFrame:WaitForChild("Top"):WaitForChild("Close")
    local main = pickaxeFrame:WaitForChild("Main")
    local shopTemplate = main:WaitForChild("Template")
    
    local pickaxeScale = pickaxeFrame:FindFirstChildOfClass("UIScale")
    if not pickaxeScale then
        pickaxeScale = Instance.new("UIScale")
        pickaxeScale.Parent = pickaxeFrame
    end
    
    pickaxeFrame.Visible = false
    
    refs = {
    PickaxeFrame = pickaxeFrame,
    PickaxeScale = pickaxeScale,
    Main = main,
    ShopTemplate = shopTemplate,
    }
    shopOpen = false
    
    closeButton.Activated:Connect(closeShop)
    
    buildShop()
    PickaxeAction:FireServer("Sync")
end

local existing = playerGui:FindFirstChild("MainGui")
if existing then
    task.spawn(bindGui, existing)
end
playerGui.ChildAdded:Connect(function(child)
    if child.Name == "MainGui" then
        task.spawn(bindGui, child)
    end
end)

]]></ProtectedString>
