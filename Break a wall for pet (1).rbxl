<Item class="LocalScript" referent="RBXCE0869D075DF4A55B454100615AE4BA1">
<Properties>
<BinaryString name="AttributesSerialize"></BinaryString>
<bool name="Disabled">false</bool>
<Content name="LinkedSource"><null></null></Content>
<string name="Name">TreadmillClient</string>
<token name="RunContext">0</token>
<string name="ScriptGuid">{A7A2C6D1-8936-4D8F-A45D-9A2AE9525164}</string>
<ProtectedString name="Source"><![CDATA[-- LocalScript: StarterPlayer > StarterPlayerScripts > TreadmillClient
-- Khusus sistem Treadmill (Pickaxe Shop ada di script sendiri: PickaxeClient)
--
-- Struktur GUI (di StarterGui):
-- MainGui
--  GameHub
--   Frame > MechanicFrame > BaseMechanic > Treadmill > Stop
--   Popup > Base > Treadmill > Template > Text
 
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local SoundService = game:GetService("SoundService")
local StarterGui = game:GetService("StarterGui")
local Debris = game:GetService("Debris")
 
local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")
 
local Configuration = ReplicatedStorage:WaitForChild("Configuration")
local NumberFormatModule = require(Configuration:WaitForChild("Modules"):WaitForChild("NumberFormat"))
 
local Remotes = Configuration:WaitForChild("TreadmillRemotes")
local UIEvent = Remotes:WaitForChild("TreadmillUI")
local ActionEvent = Remotes:WaitForChild("TreadmillAction")
local StopEvent = Remotes:WaitForChild("TreadmillStop")
 
local function fmt(n)
    if type(NumberFormatModule) == "function" then
        return NumberFormatModule(n)
    elseif type(NumberFormatModule) == "table" and NumberFormatModule.Format then
        return NumberFormatModule.Format(n)
    end
    return tostring(n)
end
 
-- Inventory (Backpack) disembunyikan pas di treadmill
local function setBackpack(enabled)
    -- inventory custom (InventoryClient) ikut disembunyikan / dimunculkan lewat attribute
    game:GetService("Players").LocalPlayer:SetAttribute("HideInv_Treadmill", not enabled)
end
 
----------------------------------------------------------------
-- GUI (otomatis nyambung lagi kalau MainGui ke-reset pas respawn)
----------------------------------------------------------------
local refs = nil
local running = false
local stopDebounce = false
 
local function bindGui(mainGui)
    local gameHub = mainGui:WaitForChild("GameHub")
    
    local mechanic = gameHub:WaitForChild("Frame"):WaitForChild("MechanicFrame"):WaitForChild("BaseMechanic")
    local treadmillFrame = mechanic:WaitForChild("Treadmill")
    local stopButton = treadmillFrame:WaitForChild("Stop")
    
    local popupFolder = gameHub:WaitForChild("Popup"):WaitForChild("Base"):WaitForChild("Treadmill")
    local template = popupFolder:WaitForChild("Template")
    
    template.Visible = false
    treadmillFrame.Visible = false
    
    refs = {
    Mechanic = mechanic,
    TreadmillFrame = treadmillFrame,
    StopButton = stopButton,
    StopSize = stopButton.Size,
    PopupFolder = popupFolder,
    Template = template,
    }
    running = false
    
    stopButton.Activated:Connect(function()
        if not running or stopDebounce then return end
        stopDebounce = true
        StopEvent:FireServer()
        task.delay(0.5, function()
            stopDebounce = false
        end)
    end)
end
 
local existing = playerGui:FindFirstChild("MainGui")
if existing then
    task.spawn(bindGui, existing)
end
playerGui.ChildAdded:Connect(function(child)
    if child.Name == "MainGui" then
        task.spawn(bindGui, child)
    end
end)
 
----------------------------------------------------------------
-- STOP BUTTON (dengan animasi)
----------------------------------------------------------------
local function showStop()
    setBackpack(false) -- inventory hilang
    if not refs then return end
    running = true
    
    refs.Mechanic.Visible = true
    refs.TreadmillFrame.Visible = true
    refs.StopButton.Visible = true
    refs.StopButton.Size = UDim2.fromScale(0, 0)
    
    TweenService:Create(
    refs.StopButton,
    TweenInfo.new(0.35, Enum.EasingStyle.Back, Enum.EasingDirection.Out),
    { Size = refs.StopSize }
    ):Play()
end
 
local function hideStop()
    running = false
    setBackpack(true) -- inventory balik
    
    local r = refs
    if not r then return end
    
    TweenService:Create(
    r.StopButton,
    TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.In),
    { Size = UDim2.fromScale(0, 0) }
    ):Play()
    
    task.delay(0.22, function()
        if not running then
            r.TreadmillFrame.Visible = false
            r.StopButton.Size = r.StopSize
        end
    end)
end
 
----------------------------------------------------------------
-- POPUP "+10 Speed"
----------------------------------------------------------------
-- PopSound: dibuat di client & parent ke SoundService (bukan di Workspace),
-- jadi cuma player ini yang dengar.
local popSound = Instance.new("Sound")
popSound.Name = "PopSound"
popSound.SoundId = "rbxassetid://1289263994"
popSound.Volume = 0.5
popSound.Parent = SoundService
 
local function playPopSound()
    local s = popSound:Clone()
    s.Parent = SoundService
    s:Play()
    Debris:AddItem(s, 5)
end
 
local function showPopup(amount)
    if not refs then return end
    playPopSound()
    
    local clone = refs.Template:Clone()
    clone.Name = "Popup"
    clone.Visible = true
    
    local label = clone:FindFirstChild("Text", true)
    if label and label:IsA("TextLabel") then
        label.Text = "+" .. fmt(amount) .. " Speed"
    end
    
    local scale = Instance.new("UIScale")
    scale.Scale = 0.5
    scale.Parent = clone
    
    clone.Parent = refs.PopupFolder
    
    TweenService:Create(
    scale,
    TweenInfo.new(0.25, Enum.EasingStyle.Back, Enum.EasingDirection.Out),
    { Scale = 1 }
    ):Play()
    
    task.delay(0.9, function()
        local t = TweenService:Create(
        scale,
        TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.In),
        { Scale = 0 }
        )
        t:Play()
        t.Completed:Wait()
        clone:Destroy()
    end)
end
 
UIEvent.OnClientEvent:Connect(function(action, value)
    if action == "Start" then
        showStop()
    elseif action == "Stop" then
        hideStop()
    elseif action == "Gain" then
        showPopup(value)
    end
end)
 
----------------------------------------------------------------
-- KLIK BUTTON SURFACEGUI (Purchase & Upgrade) di Workspace.Bases
----------------------------------------------------------------
local Bases = workspace:WaitForChild("Bases")
local hooked = {}
 
local function hookButton(inst)
    if hooked[inst] or not inst:IsA("ImageButton") then return end
    
    local gui = inst.Parent
    if not gui or not gui:IsA("SurfaceGui") then return end
    
    local kind
    if gui.Name == "PurchaseGui" and inst.Name == "Purchase" then
        kind = "Purchase"
    elseif gui.Name == "UpgradeGui" and inst.Name == "Upgrade" then
        kind = "Upgrade"
    else
        return
    end
    
    hooked[inst] = true
    
    inst.Activated:Connect(function()
        local base = inst
        while base and base.Parent ~= Bases do
            base = base.Parent
        end
        if base then
            ActionEvent:FireServer(base, kind)
        end
    end)
end
 
for _, d in ipairs(Bases:GetDescendants()) do
    hookButton(d)
end
Bases.DescendantAdded:Connect(hookButton)
 

]]></ProtectedString>
