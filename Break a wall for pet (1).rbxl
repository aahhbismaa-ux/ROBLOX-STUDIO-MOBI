<Item class="Script" referent="RBX66C1625455D04AC580D8101539513A7E">
<Properties>
<BinaryString name="AttributesSerialize"></BinaryString>
<bool name="Disabled">false</bool>
<Content name="LinkedSource"><null></null></Content>
<string name="Name">PetStealServer</string>
<token name="RunContext">0</token>
<string name="ScriptGuid">{FF361BB9-5B67-4864-AADE-7E5A85E36A3E}</string>
<ProtectedString name="Source"><![CDATA[-- Script: ServerScriptService > PetStealServer
--
-- Satu script untuk semua urusan "Pet milik player":
--   1) Steal (ProximityPrompt) -> bawa di atas kepala -> Drop / SaveZone -> jadi Tool Pet
--   2) Place Tool Pet ke Part "Place" di Base -> Pet jalan-jalan & ngasih Sheckles tiap detik
--   3) Active Pets: Unequip, Take (prompt), EquipBest, datastore
-- Spawn & jalan-jalan Pet di Area ada di PetServer.
 
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerStorage = game:GetService("ServerStorage")
local ServerScriptService = game:GetService("ServerScriptService")
local CollectionService = game:GetService("CollectionService")
local TweenService = game:GetService("TweenService")
local MarketplaceService = game:GetService("MarketplaceService")
 
local DataService = require(ServerScriptService:WaitForChild("DataService"))
local Registry = require(ServerScriptService:WaitForChild("PetRegistry"))
local IndexService = require(ServerScriptService:WaitForChild("IndexService")) -- Index: Pet baru + Boost Sheckles
local incomeRemainder = {} -- [player] = sisa pecahan income (biar Boost x1.1 gak ada yang hilang dibulatkan)
 
local ConfigFolder = ReplicatedStorage:WaitForChild("Configuration")
local Modules = ConfigFolder:WaitForChild("Modules")
local NumberFormatModule = require(Modules:WaitForChild("NumberFormat"))
local PetConfig = require(Modules:WaitForChild("Area"):WaitForChild("Pet"):WaitForChild("PetConfig"))
local Settings = PetConfig.Settings
 
local PetTemplates = ServerStorage:WaitForChild("Configuration"):WaitForChild("Area"):WaitForChild("Pet")
local PetGuiTemplate = ServerStorage:WaitForChild("BillboardGui"):WaitForChild("PetGui")
local SaveHitbox = workspace:WaitForChild("Map"):WaitForChild("System"):WaitForChild("SaveZone"):WaitForChild("Hitbox")
local Bases = workspace:WaitForChild("Bases")
 
local TAG = "AreaPet"
 
local function fmt(n)
    if type(NumberFormatModule) == "function" then
        return NumberFormatModule(n)
    elseif type(NumberFormatModule) == "table" and NumberFormatModule.Format then
        return NumberFormatModule.Format(n)
    end
    return tostring(n)
end
 
local function rand(range)
    return range[1] + math.random() * (range[2] - range[1])
end
 
----------------------------------------------------------------
-- REMOTES
----------------------------------------------------------------
local Remotes = Instance.new("Folder")
Remotes.Name = "PetStealRemotes"
Remotes.Parent = ConfigFolder
 
local UIEvent = Instance.new("RemoteEvent")
UIEvent.Name = "PetCarryUI" -- server -> client ("Start" / "End" / "Pets" / "Income")
UIEvent.Parent = Remotes
 
local ActionEvent = Instance.new("RemoteEvent")
ActionEvent.Name = "PetCarryAction" -- client -> server ("Drop" / "Sync" / "Unequip" / "Take" / "EquipBest")
ActionEvent.Parent = Remotes
 
-- Salinan model Pet (tanpa script & efek) buat ViewportFrame di ActiveFrame
local DisplayFolder = Instance.new("Folder")
DisplayFolder.Name = "PetDisplay"
DisplayFolder.Parent = ReplicatedStorage
 
for _, template in ipairs(PetTemplates:GetChildren()) do
    if template:IsA("Model") then
        local copy = template:Clone()
        for _, d in ipairs(copy:GetDescendants()) do
            if d:IsA("LuaSourceContainer") or (d:IsA("BasePart") and d.Name:sub(1, 7) == "Effect_") then
                d:Destroy()
            end
        end
        copy.Parent = DisplayFolder
    end
end
 
----------------------------------------------------------------
-- STATE
----------------------------------------------------------------
local carrying = {}  -- [player] = info Pet yang lagi dibawa
local armState = {}  -- [player] = daftar {Motor, Base}
local carryConn = {} -- [player] = koneksi Humanoid.Died
local bases = {}     -- [base] = {Owner, Place, Zone, Folder, Models, SpawnedFor}
 
----------------------------------------------------------------
-- DATA: section "Pets" = { Items = {...pet di Backpack}, Placed = {...pet di Base} }
-- Isi tiap pet: {Id, Name, Rarity, Income}
----------------------------------------------------------------
local idCounter = 0
local function newId()
    idCounter += 1
    return os.time() .. "-" .. idCounter .. "-" .. math.random(1000, 9999)
end
 
local function sanitize(list)
    local clean = {}
    if type(list) == "table" then
        for _, e in ipairs(list) do
            if type(e) == "table" and type(e.Name) == "string" then
                table.insert(clean, {
                Id = type(e.Id) == "string" and e.Id or newId(),
                Name = e.Name,
                Rarity = tostring(e.Rarity or "Common"),
                Income = tonumber(e.Income) or 0,
                })
            end
        end
    end
    return clean
end
 
local ready = setmetatable({}, { __mode = "k" })
 
local function getSec(plr)
    local sec = DataService.Section(plr, "Pets")
    if not sec then return nil end
    if not ready[sec] then
        sec.Items = sanitize(sec.Items)
        sec.Placed = sanitize(sec.Placed)
        ready[sec] = true
    end
    return sec
end
 
local function findById(list, id)
    for i, e in ipairs(list) do
        if e.Id == id then
            return i, e
        end
    end
    return nil
end
 
local function listFor(list)
    local out = {}
    for _, e in ipairs(list) do
        table.insert(out, { Id = e.Id, Name = e.Name, Rarity = e.Rarity, Income = e.Income })
    end
    return out
end
 
local function pushPets(plr)
    local sec = getSec(plr)
    if sec and plr.Parent then
        UIEvent:FireClient(plr, "Pets", listFor(sec.Placed), listFor(sec.Items))
    end
end
 
local function getSheckles(plr)
    local ls = plr:FindFirstChild("leaderstats")
    return ls and ls:FindFirstChild("Sheckles")
end
 
----------------------------------------------------------------
-- TANGAN KE ATAS (R15 & R6): putar C0 bahu, sama caranya kayak Script Swing Pickaxe
----------------------------------------------------------------
local function getShoulders(char)
    local list = {}
    local function add(name)
        local m = char:FindFirstChild(name, true)
        if m and m:IsA("Motor6D") then
            table.insert(list, m)
        end
    end
    
    if char:FindFirstChild("RightUpperArm") then
        add("RightShoulder")
        add("LeftShoulder")
    else
        add("Right Shoulder")
        add("Left Shoulder")
    end
    return list
end
 
local function setArms(plr, up)
    local st = armState[plr]
    
    if up then
        local char = plr.Character
        if not char or st then return end
        
        st = {}
        local angle = math.rad(Settings.ArmsUpAngle)
        for _, motor in ipairs(getShoulders(char)) do
            local base = motor.C0
            table.insert(st, { Motor = motor, Base = base })
            
            local target = CFrame.new(base.Position) * CFrame.Angles(angle, 0, 0) * base.Rotation
            TweenService:Create(
            motor,
            TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
            { C0 = target }
            ):Play()
        end
        armState[plr] = st
    else
        if not st then return end
        armState[plr] = nil
        
        for _, s in ipairs(st) do
            if s.Motor.Parent then
                TweenService:Create(
                s.Motor,
                TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
                { C0 = s.Base }
                ):Play()
            end
        end
    end
end
 
----------------------------------------------------------------
-- TITIK PROMPT di tiap Pet (Steal untuk Pet liar; Pet milik player cuma dikasih titiknya,
-- prompt "Take"-nya dibuat di client pemiliknya)
----------------------------------------------------------------
local steal, wakeGuard -- forward declaration
 
local function setupPrompt(model)
    local info = Registry.ByModel[model]
    if not info or info.PromptAnchor then return end
    
    local height = model:GetAttribute("PetHeight") or 4
    
    local anchor = Instance.new("Part")
    anchor.Name = "PromptAnchor"
    anchor.Anchored = true
    anchor.CanCollide = false
    anchor.CanQuery = false
    anchor.CanTouch = false
    anchor.Transparency = 1
    anchor.Size = Vector3.new(0.2, 0.2, 0.2)
    anchor.CFrame = CFrame.new(Registry.CurrentPos(info) + Vector3.new(0, height / 2, 0))
    anchor.Parent = model
    info.PromptAnchor = anchor
    
    if model:GetAttribute("OwnerId") then
        return -- Pet di Base: gak bisa di-Steal
    end
    
    local prompt = Instance.new("ProximityPrompt")
    prompt.Name = "StealPrompt"
    prompt.ActionText = "Steal"
    prompt.ObjectText = model:GetAttribute("PetName") or model.Name
    prompt.HoldDuration = 0
    prompt.MaxActivationDistance = Settings.StealDistance
    prompt.RequiresLineOfSight = false
    prompt.Parent = anchor
    info.Prompt = prompt
    
    local function refresh()
        prompt.Enabled = model:GetAttribute("CarrierId") == nil and not model:GetAttribute("Fall")
    end
    model:GetAttributeChangedSignal("CarrierId"):Connect(refresh)
    model:GetAttributeChangedSignal("Fall"):Connect(refresh)
    refresh()
    
    prompt.Triggered:Connect(function(plr)
        steal(plr, info)
    end)
end
 
CollectionService:GetInstanceAddedSignal(TAG):Connect(setupPrompt)
for _, model in ipairs(CollectionService:GetTagged(TAG)) do
    setupPrompt(model)
end
 
-- Server ikut menggeser titik prompt (5x/detik) karena Pet jalan-jalan
task.spawn(function()
    while true do
        task.wait(0.2)
        for model, info in pairs(Registry.ByModel) do
            local anchor = info.PromptAnchor
            if anchor and anchor.Parent and not info.Carrier then
                local p = Registry.CurrentPos(info) + Vector3.new(0, (model:GetAttribute("PetHeight") or 4) / 2, 0)
                if (anchor.Position - p).Magnitude > 0.3 then
                    anchor.CFrame = CFrame.new(p)
                end
            end
        end
    end
end)
 
----------------------------------------------------------------
-- TOOL PET (AutoWeld)
----------------------------------------------------------------
local function pickHandle(model)
    for _, name in ipairs({ "Body", "BodyLower", "Core", "Abdomen", "Thorax", "Body1" }) do
        local p = model:FindFirstChild(name)
        if p and p:IsA("BasePart") then
            return p
        end
    end
    
    local best, bestVolume = nil, -1
    for _, child in ipairs(model:GetChildren()) do
        if child:IsA("BasePart") and child.Name:sub(1, 7) ~= "Effect_" then
            local v = child.Size.X * child.Size.Y * child.Size.Z
            if v > bestVolume then
                best, bestVolume = child, v
            end
        end
    end
    return best
end
 
-- PetGui (dipakai Pet di dunia & Pet di Tool)
local function addPetGui(model, anchor, name, rarity, income)
    local gui = PetGuiTemplate:Clone()
    gui.Name = "PetGui"
    gui.Adornee = anchor
    
    local nameLabel = gui:FindFirstChild("Name")
    local rarityLabel = gui:FindFirstChild("Rarity")
    local incomeLabel = gui:FindFirstChild("Income")
    if nameLabel then nameLabel.Text = name end
    if rarityLabel then rarityLabel.Text = rarity end
    if incomeLabel then incomeLabel.Text = "C$" .. fmt(income) .. "/s" end
    gui.Parent = model
    return gui
end
 
local function makePetTool(item)
    local template = PetTemplates:FindFirstChild(item.Name)
    if not template then
        warn("Model Pet '" .. tostring(item.Name) .. "' tidak ada di ServerStorage, Tool dilewati")
        return nil
    end
    
    local model = template:Clone()
    model.Name = "PetModel"
    
    local handle = pickHandle(model)
    if not handle then
        model:Destroy()
        return nil
    end
    
    local pivot = model:GetPivot()
    local height = 1
    for _, d in ipairs(model:GetDescendants()) do
        if d:IsA("BasePart") and d.Name:sub(1, 7) ~= "Effect_" then
            height = math.max(height, pivot:ToObjectSpace(d.CFrame).Position.Y + d.Size.Y / 2)
        end
    end
    
    local anchor = Instance.new("Part")
    anchor.Name = "GuiAnchor"
    anchor.CanCollide = false
    anchor.Transparency = 1
    anchor.Size = Vector3.new(0.2, 0.2, 0.2)
    anchor.CFrame = CFrame.new(pivot.Position + Vector3.new(0, height + 1, 0))
    anchor.Parent = model
    
    addPetGui(model, anchor, item.Name, item.Rarity, item.Income)
    
    local tool = Instance.new("Tool")
    tool.Name = item.Name
    tool.RequiresHandle = true
    tool.CanBeDropped = false
    tool.ToolTip = item.Rarity .. " | C$" .. fmt(item.Income) .. "/s"
    tool:SetAttribute("PetTool", true)
    tool:SetAttribute("PetId", item.Id)
    tool:SetAttribute("PetName", item.Name)
    tool:SetAttribute("Rarity", item.Rarity)
    tool:SetAttribute("Income", item.Income)
    
    handle.Name = "Handle"
    handle.Parent = tool
    model.Parent = tool
    
    for _, d in ipairs(tool:GetDescendants()) do
        if d:IsA("BasePart") then
            d.Anchored = false
            d.CanCollide = false
            d.CanTouch = false
            d.CanQuery = false
            d.Massless = (d ~= handle)
        end
    end
    
    -- AutoWeld: semua Part di-weld ke Handle (posisi relatif sama persis kayak modelnya)
    for _, d in ipairs(tool:GetDescendants()) do
        if d:IsA("BasePart") and d ~= handle then
            local weld = Instance.new("Weld")
            weld.Name = "AutoWeld"
            weld.Part0 = handle
            weld.Part1 = d
            weld.C0 = handle.CFrame:ToObjectSpace(d.CFrame)
            weld.C1 = CFrame.new()
            weld.Parent = d
        end
    end
    
    return tool
end
 
local function clearPetTools(container)
    if not container then return end
    for _, child in ipairs(container:GetChildren()) do
        if child:IsA("Tool") and child:GetAttribute("PetTool") then
            child:Destroy()
        end
    end
end
 
local function removeToolById(plr, id)
    for _, container in ipairs({ plr:FindFirstChild("Backpack"), plr.Character }) do
        if container then
            for _, child in ipairs(container:GetChildren()) do
                if child:IsA("Tool") and child:GetAttribute("PetId") == id then
                    child:Destroy()
                end
            end
        end
    end
end
 
-- equip = true -> langsung dipegang
local function giveTool(plr, item, equip)
    local backpack = plr:FindFirstChild("Backpack")
    if not backpack then return end
    
    local tool = makePetTool(item)
    if not tool then return end
    
    tool.Parent = backpack
    
    if equip and not plr:GetAttribute("CarryingPet") then
        local hum = plr.Character and plr.Character:FindFirstChildOfClass("Humanoid")
        if hum then
            hum:EquipTool(tool)
        end
    end
end
 
local function giveAllTools(plr)
    local sec = getSec(plr)
    if not sec then return end
    
    clearPetTools(plr:FindFirstChild("Backpack"))
    clearPetTools(plr.Character)
    
    for _, item in ipairs(sec.Items) do
        giveTool(plr, item, false)
    end
end
 
----------------------------------------------------------------
-- BASE: Part "Place" -> Pet jalan-jalan di situ
----------------------------------------------------------------
local function removeWorldPet(model)
    local info = Registry.ByModel[model]
    Registry.ByModel[model] = nil
    if info then
        info.Removed = true
        if info.Area and info.Area.Active then
            info.Area.Active[model] = nil
        end
    end
    model:Destroy()
end
 
local function baseOf(plr)
    for _, st in pairs(bases) do
        if st.Owner.Value == plr.UserId then
            return st
        end
    end
    return nil
end
 
local function spawnPlaced(plr, st, entry)
    local template = PetTemplates:FindFirstChild(entry.Name)
    if not template then
        warn("Model Pet '" .. entry.Name .. "' tidak ada di ServerStorage, Pet di Base dilewati")
        return
    end
    
    local zone = st.Zone
    local radius, height, minY = Registry.Measure(template)
    local footY = -minY
    local margin = math.min(radius, math.min(zone.HalfA, zone.HalfB) * 0.85)
    
    local model = template:Clone()
    model.Name = entry.Name
    
    local pos = Registry.RandomPoint(zone, margin) + Vector3.new(0, footY, 0)
    local yaw = math.random() * math.pi * 2
    model:PivotTo(CFrame.new(pos) * CFrame.Angles(0, yaw, 0))
    
    local anchor = Instance.new("Part")
    anchor.Name = "GuiAnchor"
    anchor.Anchored = true
    anchor.CanCollide = false
    anchor.CanQuery = false
    anchor.CanTouch = false
    anchor.Transparency = 1
    anchor.Size = Vector3.new(0.2, 0.2, 0.2)
    anchor.CFrame = CFrame.new(pos + Vector3.new(0, height + 1, 0))
    anchor.Parent = model
    
    addPetGui(model, anchor, entry.Name, entry.Rarity, entry.Income) -- PetGui tetap ada
    
    model:SetAttribute("PetName", entry.Name)
    model:SetAttribute("Rarity", entry.Rarity)
    model:SetAttribute("Income", entry.Income)
    model:SetAttribute("OwnerId", plr.UserId)
    model:SetAttribute("PlacedId", entry.Id)
    model:SetAttribute("PetHeight", height)
    model:SetAttribute("FootOffset", footY)
    model:SetAttribute("Yaw", yaw)
    model:SetAttribute("MoveFrom", pos)
    model:SetAttribute("MoveTo", pos)
    model:SetAttribute("MoveDur", 0)
    model:SetAttribute("MoveStart", workspace:GetServerTimeNow())
    
    local info = {
    Model = model,
    Def = { Name = entry.Name, Rarity = entry.Rarity, Income = entry.Income },
    Area = zone,
    Pos = pos,
    FootY = footY,
    Margin = margin,
    Speed = rand(Settings.WalkSpeed),
    State = "Idle",
    NextAt = os.clock() + math.random() * 2,
    }
    
    zone.Active[model] = info
    Registry.ByModel[model] = info
    st.Models[entry.Id] = model
    
    model.Parent = st.Folder
    CollectionService:AddTag(model, TAG)
end
 
local function despawnBase(st)
    for _, model in pairs(st.Models) do
        removeWorldPet(model)
    end
    st.Models = {}
    st.SpawnedFor = nil
end
 
local function refreshBase(st)
    local ownerId = st.Owner.Value
    
    if st.SpawnedFor and st.SpawnedFor ~= ownerId then
        despawnBase(st)
    end
    
    if ownerId ~= 0 and not st.SpawnedFor then
        local plr = Players:GetPlayerByUserId(ownerId)
        if plr and DataService.IsLoaded(plr) then
            local sec = getSec(plr)
            if sec then
                st.SpawnedFor = ownerId
                for _, entry in ipairs(sec.Placed) do
                    spawnPlaced(plr, st, entry)
                end
                pushPets(plr)
            end
        end
    end
end
 
-- Pesan singkat ke player (muncul di Popup Pet)
local function notice(plr, text)
    if plr.Parent then
        UIEvent:FireClient(plr, "Notice", text)
    end
end
 
local placeDebounce = {}
 
-- Tool Pet dipegang + klik Part Place di Base sendiri -> Pet pindah ke Base
local function placeHeldPet(plr, st)
    if plr:GetAttribute("CarryingPet") then return end
    
    -- ClickDetector & tap Tool bisa kepanggil barengan, yang kedua diabaikan
    if placeDebounce[plr] and os.clock() - placeDebounce[plr] < 0.4 then return end
    placeDebounce[plr] = os.clock()
    
    if st.Owner.Value ~= plr.UserId then
        notice(plr, "This is not your base!")
        return
    end
    
    local char = plr.Character
    local tool = char and char:FindFirstChildOfClass("Tool")
    if not tool or not tool:GetAttribute("PetTool") then
        notice(plr, "Hold a Pet to place it!")
        return
    end
    
    local sec = getSec(plr)
    if not sec then return end
    
    if #sec.Placed >= Settings.MaxActive then
        notice(plr, "Active Pets full (" .. #sec.Placed .. "/" .. Settings.MaxActive .. ")!")
        return
    end
    
    local idx, entry = findById(sec.Items, tool:GetAttribute("PetId"))
    if not idx then
        -- Tool lama tanpa Id yang cocok: cari Pet dengan nama sama
        for i, e in ipairs(sec.Items) do
            if e.Name == tool:GetAttribute("PetName") then
                idx, entry = i, e
                break
            end
        end
    end
    if not idx then
        notice(plr, "Pet not found!")
        return
    end
    
    table.remove(sec.Items, idx)
    table.insert(sec.Placed, entry)
    
    tool:Destroy()
    spawnPlaced(plr, st, entry)
    pushPets(plr)
end
 
-- Unequip (lewat ActiveFrame) / Take (lewat prompt): Pet jadi Tool lagi di tangan
local function unequipPlaced(plr, id, equip)
    local sec = getSec(plr)
    if not sec then return end
    
    local idx, entry = findById(sec.Placed, id)
    if not idx then return end
    
    table.remove(sec.Placed, idx)
    table.insert(sec.Items, entry)
    
    local st = baseOf(plr)
    if st and st.Models[id] then
        removeWorldPet(st.Models[id])
        st.Models[id] = nil
    end
    
    giveTool(plr, entry, equip)
    pushPets(plr)
end
 
-- EquipBest: ambil Pet dengan Income tertinggi (Backpack + Base) sebanyak MaxActive
local function equipBest(plr)
    local st = baseOf(plr)
    local sec = getSec(plr)
    if not st or not sec or plr:GetAttribute("CarryingPet") then return end
    
    local pool = {}
    for _, e in ipairs(sec.Placed) do table.insert(pool, e) end
    for _, e in ipairs(sec.Items) do table.insert(pool, e) end
    
    table.sort(pool, function(a, b)
        if a.Income ~= b.Income then
            return a.Income > b.Income
        end
        return a.Id < b.Id
    end)
    
    local keep = {}
    for i = 1, math.min(Settings.MaxActive, #pool) do
        keep[pool[i].Id] = true
    end
    
    -- yang di Base tapi gak masuk 8 terbaik -> balik jadi Tool
    for i = #sec.Placed, 1, -1 do
        local e = sec.Placed[i]
        if not keep[e.Id] then
            table.remove(sec.Placed, i)
            table.insert(sec.Items, e)
            if st.Models[e.Id] then
                removeWorldPet(st.Models[e.Id])
                st.Models[e.Id] = nil
            end
            giveTool(plr, e, false)
        end
    end
    
    -- yang di Backpack tapi masuk 8 terbaik -> pindah ke Base
    for i = #sec.Items, 1, -1 do
        local e = sec.Items[i]
        if keep[e.Id] then
            table.remove(sec.Items, i)
            table.insert(sec.Placed, e)
            removeToolById(plr, e.Id)
            spawnPlaced(plr, st, e)
        end
    end
    
    pushPets(plr)
end
 
local function setupBase(base)
    if not base:IsA("Model") or bases[base] then return end
    
    local owner = base:WaitForChild("Owner", 10)
    local place = base:WaitForChild("Place", 10)
    if not owner or not place or not place:IsA("BasePart") then
        warn(base.Name .. ": Owner / Part 'Place' tidak ditemukan")
        return
    end
    
    local folder = Instance.new("Folder")
    folder.Name = "PlacedPets"
    folder.Parent = base
    
    local zone = Registry.MakeZone(place)
    Registry.Areas["Base:" .. base.Name] = zone
    
    local st = {
    Base = base,
    Owner = owner,
    Place = place,
    Zone = zone,
    Folder = folder,
    Models = {},
    SpawnedFor = nil,
    }
    bases[base] = st
    
    local click = Instance.new("ClickDetector")
    click.MaxActivationDistance = 60
    click.Parent = place
    click.MouseClick:Connect(function(plr)
        placeHeldPet(plr, st)
    end)
    
    owner.Changed:Connect(function()
        refreshBase(st)
    end)
    refreshBase(st)
end
 
for _, base in ipairs(Bases:GetChildren()) do
    task.spawn(setupBase, base)
end
Bases.ChildAdded:Connect(function(base)
    task.spawn(setupBase, base)
end)
 
----------------------------------------------------------------
-- STEAL / DROP / DELIVER
----------------------------------------------------------------
local function carryOrigin(root, footOffset)
    return root.Position + Vector3.new(0, Settings.CarryHeight + footOffset, 0)
end
 
local function endCarry(plr)
    carrying[plr] = nil
    
    if carryConn[plr] then
        carryConn[plr]:Disconnect()
        carryConn[plr] = nil
    end
    
    setArms(plr, false)
    
    if plr.Parent then
        plr:SetAttribute("CarryingPet", false)
        UIEvent:FireClient(plr, "End")
    end
end
 
local function dropPet(plr)
    local info = carrying[plr]
    if not info then return end
    
    local model = info.Model
    local footOffset = model:GetAttribute("FootOffset") or 0
    local char = plr.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    
endCarry(plr)
 
if not model.Parent or info.Removed then return end
 
local fromPos = Registry.CurrentPos(info)
local dropPos = fromPos
 
if root then
    fromPos = carryOrigin(root, footOffset)
    
    -- titik jatuh: sedikit di depan player, di atas tanah
    local forward = root.CFrame.LookVector * Vector3.new(1, 0, 1)
    if forward.Magnitude > 0 then
        forward = forward.Unit
        end
            local origin = root.Position + forward * 3
            
            local ignore = { char }
            for _, pet in ipairs(CollectionService:GetTagged(TAG)) do
                table.insert(ignore, pet)
            end
            
            local params = RaycastParams.new()
            params.FilterType = Enum.RaycastFilterType.Exclude
            params.FilterDescendantsInstances = ignore
            
            local hit = workspace:Raycast(origin, Vector3.new(0, -60, 0), params)
            local groundY = hit and hit.Position.Y or (root.Position.Y - 3)
            dropPos = Vector3.new(origin.X, groundY + footOffset, origin.Z)
        end
        
        Registry.Drop(info, fromPos, dropPos, Settings.DropRoamRadius)
    end
    
    steal = function(plr, info)
        if carrying[plr] or info.Carrier or info.Removed then return end
        if plr:GetAttribute("Ragdolled") then return end
        if info.State == "Fall" then return end
        if not DataService.IsLoaded(plr) then return end
        if plr:GetAttribute("OnTreadmill") then return end
        
        local char = plr.Character
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        local root = char and char:FindFirstChild("HumanoidRootPart")
        if not hum or not root or hum.Health <= 0 then return end
        
        local model = info.Model
        local petCenter = Registry.CurrentPos(info) + Vector3.new(0, (model:GetAttribute("PetHeight") or 4) / 2, 0)
        if (root.Position - petCenter).Magnitude > Settings.StealDistance + 10 then return end
        
        Registry.SetCarried(info, plr)
        carrying[plr] = info
        plr:SetAttribute("CarryingPet", true)
        
        hum:UnequipTools() -- lagi bawa Pet, gak bisa pegang Tool
        setArms(plr, true)
        
        carryConn[plr] = hum.Died:Connect(function()
            dropPet(plr)
        end)
        
        UIEvent:FireClient(plr, "Start", model:GetAttribute("PetName"))
        
        -- Guard di Area ini bangun & ngejar si pencuri
        if wakeGuard and info.Area and info.Area.Index then
            wakeGuard(info.Area.Index, plr, info)
        end
    end
    
    -- Sampai di SaveZone: Pet jadi Tool, semua efek hilang
    local function deliver(plr)
        local info = carrying[plr]
        if not info then return end
        if not DataService.IsLoaded(plr) then return end
        
        local sec = getSec(plr)
        if not sec then return end
        
        local def = info.Def
        local item = { Id = newId(), Name = def.Name, Rarity = def.Rarity, Income = def.Income }
        table.insert(sec.Items, item)
        IndexService.Discover(plr, def.Name) -- masuk Index
        
    endCarry(plr)
    Registry.Remove(info) -- Pet di dunia hilang (PetServer munculin pengganti)
    giveTool(plr, item, false)
    pushPets(plr)
end
 
local saveDebounce = {}
SaveHitbox.Touched:Connect(function(hit)
    local char = hit:FindFirstAncestorOfClass("Model")
    local plr = char and Players:GetPlayerFromCharacter(char)
    if not plr or not carrying[plr] or saveDebounce[plr] then return end
    
    saveDebounce[plr] = true
    deliver(plr)
    task.delay(1, function()
        saveDebounce[plr] = nil
    end)
end)
 
----------------------------------------------------------------
-- RAGDOLL (R15 & R6): sendi Motor6D diganti BallSocket, lalu player terpental
----------------------------------------------------------------
local GuardConfig = require(Modules:WaitForChild("Area"):WaitForChild("Guard"):WaitForChild("GuardConfig"))
local TreadmillConfig = require(Modules:WaitForChild("Treadmill"):WaitForChild("TreadmillConfig"))
local GCfg = GuardConfig.Settings
 
local ragdolled = {}
 
local function ragdollPlayer(plr, fromPos, baseC0)
    local char = plr.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not hum or not root or hum.Health <= 0 or ragdolled[plr] then return end
    
    local token = {}
    ragdolled[plr] = token
    plr:SetAttribute("Ragdolled", true)
    hum:UnequipTools()
    
    -- PENTING: Humanoid otomatis MATI kalau sendi Neck dilepas (RequiresNeck = true).
    -- Pas ragdoll, Neck kita matiin -> makanya dulu player "Died". Matiin dulu selama ragdoll.
    local oldRequiresNeck = hum.RequiresNeck
    hum.RequiresNeck = false
    
    local joints, restore = {}, {}
    
    for _, m in ipairs(char:GetDescendants()) do
        if m:IsA("Motor6D") and m.Part0 and m.Part1 and m.Part0 ~= root and m.Part1 ~= root then
            local a0 = Instance.new("Attachment")
            a0.Name = "RagdollA0"
            a0.CFrame = baseC0[m] or m.C0
            a0.Parent = m.Part0
            
            local a1 = Instance.new("Attachment")
            a1.Name = "RagdollA1"
            a1.CFrame = m.C1
            a1.Parent = m.Part1
            
            local socket = Instance.new("BallSocketConstraint")
            socket.Name = "RagdollSocket"
            socket.Attachment0 = a0
            socket.Attachment1 = a1
            socket.LimitsEnabled = true
            socket.UpperAngle = (m.Name == "Neck") and 45 or 70
            socket.TwistLimitsEnabled = true
            socket.TwistLowerAngle = -40
            socket.TwistUpperAngle = 40
            socket.Parent = m.Part0
            
            local nc = Instance.new("NoCollisionConstraint")
            nc.Name = "RagdollNoCollide"
            nc.Part0 = m.Part0
            nc.Part1 = m.Part1
            nc.Parent = m.Part0
            
            m.Enabled = false
            table.insert(joints, { Motor = m, A0 = a0, A1 = a1, Socket = socket, NC = nc })
        end
    end
    
    for _, part in ipairs(char:GetDescendants()) do
        if part:IsA("BasePart") and part ~= root then
            restore[part] = part.CanCollide
            part.CanCollide = true
        end
    end
    
    hum.PlatformStand = true
    hum.AutoRotate = false
    
    -- terpental menjauhi Guard
    local away = Vector3.new(root.Position.X - fromPos.X, 0, root.Position.Z - fromPos.Z)
    away = away.Magnitude > 0.1 and away.Unit or -root.CFrame.LookVector
    local vel = away * GCfg.KnockbackForce + Vector3.new(0, GCfg.KnockbackUp, 0)
    root.AssemblyLinearVelocity = vel
    root.AssemblyAngularVelocity = Vector3.new(math.random(-8, 8), math.random(-4, 4), math.random(-8, 8))
    UIEvent:FireClient(plr, "Knockback", vel) -- pemilik karakter yang pegang fisikanya
    
    task.delay(GCfg.RagdollTime, function()
        if ragdolled[plr] ~= token then return end
        ragdolled[plr] = nil
        if plr.Parent then
            plr:SetAttribute("Ragdolled", false)
        end
        if not char.Parent or hum.Health <= 0 then return end
        
        for _, j in ipairs(joints) do
            j.Socket:Destroy()
            j.NC:Destroy()
            j.A0:Destroy()
            j.A1:Destroy()
            if j.Motor.Parent then
                j.Motor.Enabled = true
            end
        end
        for part, canCollide in pairs(restore) do
            if part.Parent then
                part.CanCollide = canCollide
            end
        end
        
        -- berdiri lagi (sendi sudah nyala lagi, baru RequiresNeck dikembalikan)
        hum.RequiresNeck = oldRequiresNeck
        local _, yaw = root.CFrame:ToEulerAnglesYXZ()
        root.AssemblyLinearVelocity = Vector3.zero
        root.AssemblyAngularVelocity = Vector3.zero
        root.CFrame = CFrame.new(root.Position + Vector3.new(0, 2.5, 0)) * CFrame.Angles(0, yaw, 0)
        hum.PlatformStand = false
        hum.AutoRotate = true
        hum:ChangeState(Enum.HumanoidStateType.GettingUp)
    end)
end
 
----------------------------------------------------------------
-- GUARD: tidur di tempatnya -> bangun pas ada Pet di-Steal dari Area-nya -> ngejar pencuri
-- -> kalau kena Hit: Pet jatuh + pencuri ragdoll -> Guard pulang & tidur lagi.
-- Server cuma ngatur posisi/state (attribute), animasi Sleep/Run/Hit dikerjakan PetClient.
----------------------------------------------------------------
local GuardGuiTemplate = ServerStorage:WaitForChild("BillboardGui"):WaitForChild("GuardGui", 10)
local AreaFolder = workspace:WaitForChild("Map"):WaitForChild("System"):WaitForChild("Area")
 
local guards = {} -- [nomor area] = g
 
local function planar(v)
    return Vector3.new(v.X, 0, v.Z)
end
 
-- Kecepatan dasar Guard (dipakai pas pulang) = WalkSpeed player dengan Speed sebesar RecommendedSpeed
local function guardSpeed(cfg)
    local ws = TreadmillConfig.WalkSpeed
    return math.min(ws.Base + cfg.RecommendedSpeed * ws.Multiplier, ws.Max)
end

-- Kecepatan NGEJAR = dihitung dari Speed si pencuri vs RecommendedSpeed.
-- Dulu WalkSpeed dibatasi Max (60), jadi Speed 4.2k & 10k sama-sama 60 -> Guard gak pernah kekejar.
-- Sekarang: makin jauh Speed pencuri di bawah Recommended, makin cepat Guard (sampai MaxSpeedMult).
-- Speed pencuri >= Recommended -> Guard sama / lebih lambat dari player.
local function chaseSpeed(g, plr)
    local ws = TreadmillConfig.WalkSpeed
    local ls = plr:FindFirstChild("leaderstats")
    local sv = ls and ls:FindFirstChild("Speed")
    local stat = math.max(sv and sv.Value or 0, 1)
    local playerWS = math.min(ws.Base + stat * ws.Multiplier, ws.Max)
    local ratio = (g.Recommended / stat) ^ (GCfg.SpeedPower or 1)
    local mult = math.clamp(ratio, GCfg.MinSpeedMult or 0.6, GCfg.MaxSpeedMult or 1.6)
    return playerWS * mult
end
 
local function heightOf(model)
    local pivot = model:GetPivot()
    local height = 1
    for _, d in ipairs(model:GetDescendants()) do
        if d:IsA("BasePart") and d.Name:sub(1, 7) ~= "Effect_" then
            height = math.max(height, pivot:ToObjectSpace(d.CFrame).Position.Y + d.Size.Y / 2)
        end
    end
    return height
end
 
local function publish(g, vel)
    local m = g.Model
    m:SetAttribute("GuardPos", g.Pos)
    m:SetAttribute("GuardVel", vel)
    m:SetAttribute("GuardT", workspace:GetServerTimeNow())
    m:SetAttribute("Yaw", g.Yaw)
end
 
-- Sleep visible = tidur, Run visible = bangun (ngejar / pulang / hit)
local function setGuardState(g, state)
    g.State = state
    g.Model:SetAttribute("GuardState", state)
    if g.SleepLabel then g.SleepLabel.Visible = (state == "Sleep") end
    if g.RunLabel then g.RunLabel.Visible = (state ~= "Sleep") end
end
 
local function startReturn(g)
    g.Target, g.PetInfo, g.HitToken = nil, nil, nil
    setGuardState(g, "Return")
    publish(g, Vector3.zero)
end
 
local function moveGuard(g, target, speed, dt)
    local delta = planar(target - g.Pos)
    local dist = delta.Magnitude
    if dist < 0.05 then return Vector3.zero end
    
    local dir = delta / dist
    g.Pos += dir * math.min(speed * dt, dist)
    g.Yaw = math.atan2(-dir.X, -dir.Z)
    return dir * speed
end
 
-- Pukulan mendarat (di ~40% durasi animasi Hit): Pet jatuh, pencuri ragdoll & terpental
local function applyGuardHit(g, plr, token)
    if g.HitToken ~= token or g.State ~= "Hit" then return end
    
    local char = plr.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not root or not g.PetInfo or carrying[plr] ~= g.PetInfo then return end
    
    -- sudah lari jauh? pukulan meleset (Guard ikut menerjang, jadi toleransinya lebih longgar)
    if planar(root.Position - g.Pos).Magnitude > GCfg.HitRange * (GCfg.HitForgiveness or 2.2) then return end
    
    local baseC0 = {}
    for _, st in ipairs(armState[plr] or {}) do
        baseC0[st.Motor] = st.Base
    end
    
    dropPet(plr)
    ragdollPlayer(plr, g.Pos, baseC0)
end
 
local function guardHit(g, plr, root)
    local token = {}
    g.HitToken = token
    g.HitEnd = os.clock() + GCfg.HitDuration
    g.HitLandAt = os.clock() + GCfg.HitDuration * 0.4
    
    local d = planar(root.Position - g.Pos)
    if d.Magnitude > 0.1 then
        g.Yaw = math.atan2(-d.X, -d.Z)
    end
    
    g.Model:SetAttribute("GuardHitDur", GCfg.HitDuration)
    g.Model:SetAttribute("GuardHitStart", workspace:GetServerTimeNow())
    setGuardState(g, "Hit")
    publish(g, Vector3.zero)
    
    task.delay(GCfg.HitDuration * 0.4, function()
        applyGuardHit(g, plr, token)
    end)
end
 
local function updateGuard(g, dt, now)
    if g.State == "Chase" then
        local plr = g.Target
        local char = plr and plr.Parent and plr.Character
        local root = char and char:FindFirstChild("HumanoidRootPart")
        
        -- pencuri sudah gak bawa Pet itu (di-drop / sampai SaveZone / keluar) -> pulang
        if not root or not g.PetInfo or carrying[plr] ~= g.PetInfo then
            startReturn(g)
            return
        end
        
        if now < g.WakeUntil then
            publish(g, Vector3.zero) -- baru bangun
            return
        end
        
        local dist = planar(root.Position - g.Pos).Magnitude
        if dist > GCfg.LoseDistance then
            startReturn(g)
            return
        end
        
        if dist <= GCfg.HitRange and math.abs(root.Position.Y - g.Pos.Y) < 14 then
            guardHit(g, plr, root)
            return
        end
        
        publish(g, moveGuard(g, root.Position, chaseSpeed(g, plr), dt))
        
    elseif g.State == "Return" then
        publish(g, moveGuard(g, g.Home, g.Speed * GCfg.ReturnSpeedMultiplier, dt))
        
        if planar(g.Home - g.Pos).Magnitude < 0.3 then
            g.Pos = g.Home
            g.Yaw = g.HomeYaw
            setGuardState(g, "Sleep")
            publish(g, Vector3.zero)
        end
        
    elseif g.State == "Hit" then
        local plr = g.Target
        local char = plr and plr.Parent and plr.Character
        local root = char and char:FindFirstChild("HumanoidRootPart")
        local stillCarrying = root and g.PetInfo and carrying[plr] == g.PetInfo
        
        -- Guard menerjang ke arah pencuri selama pukulan belum mendarat
        if stillCarrying and now < g.HitLandAt then
            local gap = planar(root.Position - g.Pos).Magnitude
            if gap > 2.5 then
                publish(g, moveGuard(g, root.Position, chaseSpeed(g, plr) * (GCfg.LungeSpeedMult or 1.4), dt))
            else
                publish(g, Vector3.zero)
            end
        end
        
        if now >= g.HitEnd then
            -- Pukulan kena -> Pet sudah jatuh (carrying kosong) -> pulang.
            -- Pukulan meleset / pencuri menghindar & masih bawa Pet -> LANJUT NGEJAR, bukan pulang.
            if stillCarrying and planar(root.Position - g.Pos).Magnitude <= GCfg.LoseDistance then
                g.WakeUntil = 0
                setGuardState(g, "Chase")
                publish(g, Vector3.zero)
            else
                startReturn(g)
            end
        end
    end
end
 
wakeGuard = function(areaIndex, plr, info)
    local g = guards[areaIndex]
    if not g or g.State == "Chase" or g.State == "Hit" then return end
    
    g.Target = plr
    g.PetInfo = info
    g.WakeUntil = os.clock() + GCfg.WakeDelay
    setGuardState(g, "Chase")
    publish(g, Vector3.zero)
end
 
local function setupGuard(folder)
    local index = tonumber(folder.Name)
    local cfg = index and GuardConfig.Areas[index]
    if not cfg then return end
    
    -- Part "Recommended": "Recommended Speed: 100"
    local rec = folder:FindFirstChild("Recommended")
    local recGui = rec and rec:FindFirstChild("RecommendedGui")
    local recLabel = recGui and recGui:FindFirstChild("Text")
    if recLabel then
        recLabel.Text = "Recommended Speed: " .. fmt(cfg.RecommendedSpeed)
    end
    
    local model = folder:FindFirstChild("Guard")
    if not model or not model:IsA("Model") then
        warn("Area " .. folder.Name .. ": Model 'Guard' tidak ditemukan")
        return
    end
    
    local pivot = model:GetPivot()
    local look = pivot.LookVector
    local yaw = math.atan2(-look.X, -look.Z)
    
    -- titik tempel GuardGui (gak ikut goyang badan)
    local anchor = Instance.new("Part")
    anchor.Name = "GuiAnchor"
    anchor.Anchored = true
    anchor.CanCollide = false
    anchor.CanQuery = false
    anchor.CanTouch = false
    anchor.Transparency = 1
    anchor.Size = Vector3.new(0.2, 0.2, 0.2)
    anchor.CFrame = CFrame.new(pivot.Position + Vector3.new(0, heightOf(model) + 1, 0))
    anchor.Parent = model
    
    local sleepLabel, runLabel
    if GuardGuiTemplate then
        local gui = GuardGuiTemplate:Clone()
        gui.Name = "GuardGui"
        gui.Adornee = anchor
        sleepLabel = gui:FindFirstChild("Sleep")
        runLabel = gui:FindFirstChild("Run")
        gui.Parent = model
    else
        warn("ServerStorage > BillboardGui > GuardGui tidak ditemukan")
    end
    
    local g = {
    Index = index,
    Model = model,
    Home = pivot.Position,
    HomeYaw = yaw,
    Pos = pivot.Position,
    Yaw = yaw,
    Speed = guardSpeed(cfg),
    Recommended = cfg.RecommendedSpeed,
    SleepLabel = sleepLabel,
    RunLabel = runLabel,
    }
    guards[index] = g
    
    model:SetAttribute("AreaIndex", index)
    setGuardState(g, "Sleep")
    publish(g, Vector3.zero)
    CollectionService:AddTag(model, "AreaGuard")
end
 
for _, folder in ipairs(AreaFolder:GetChildren()) do
    setupGuard(folder)
end
 
task.spawn(function()
    local last = os.clock()
    while true do
        task.wait(0.1)
        local now = os.clock()
        local dt = now - last
        last = now
        
        for _, g in pairs(guards) do
            updateGuard(g, dt, now)
        end
    end
end)
 
----------------------------------------------------------------
-- OFFLINE EARN
-- Section "Offline" = { LastSeen = waktu terakhir online, Pending = Sheckles yang belum di-Claim }
----------------------------------------------------------------
local OFFLINE_PASS_ID = Settings.OfflinePassId
local ownsPass = {} -- [player] = true kalau sudah punya Game Pass x2
 
local function offlineSec(plr)
    local sec = DataService.Section(plr, "Offline")
    if sec and type(sec.Pending) ~= "number" then
        sec.Pending = 0
    end
    return sec
end
 
local function pendingAmount(plr)
    local sec = offlineSec(plr)
    local base = sec and sec.Pending or 0
    return math.floor(base), false
end
 
local function sendOffline(plr)
    local amount, doubled = pendingAmount(plr)
    if amount > 0 and plr.Parent then
        UIEvent:FireClient(plr, "Offline", amount, doubled)
    end
end
 
-- Claim (x1, atau x2 kalau punya Game Pass). Dipakai tombol Claim, Close, & setelah beli Pass.
local function claimOffline(plr, mult)
    local sec = offlineSec(plr)
    if not sec or sec.Pending <= 0 then return end
    
    local amount = math.floor(sec.Pending * (mult or 1))
    sec.Pending = 0
    
    local sheckles = getSheckles(plr)
    if sheckles then
        sheckles.Value += amount
    end
    
    if plr.Parent then
        UIEvent:FireClient(plr, "OfflineClaimed", amount)
    end
end
 
-- Dipanggil pas data ke-load: hitung Sheckles selama offline (maksimal OfflineMaxDays)
local function prepareOffline(plr)
    local sec = offlineSec(plr)
    local pets = getSec(plr)
    if not sec or not pets then return end
    
    local ok, owns = pcall(function()
        return MarketplaceService:UserOwnsGamePassAsync(plr.UserId, OFFLINE_PASS_ID)
    end)
    ownsPass[plr] = ok and owns == true
    
    local now = os.time()
    local last = tonumber(sec.LastSeen)
    sec.LastSeen = now
    
    if last then
        local away = math.min(math.max(now - last, 0), Settings.OfflineMaxDays * 86400)
        if away >= Settings.OfflineMinSeconds then
            local rate = 0
            for _, e in ipairs(pets.Placed) do
                rate += e.Income
            end
            
            local earn = math.floor(rate * IndexService.GetBoost(plr) * Settings.OfflineRate * away)
            if earn > 0 then
                sec.Pending += earn
            end
        end
    end
    
    sendOffline(plr)
end
 
-- Berhasil bayar Game Pass -> Claim langsung dengan x2
MarketplaceService.PromptGamePassPurchaseFinished:Connect(function(plr, passId, purchased)
    if passId ~= OFFLINE_PASS_ID or not purchased then return end
    
    ownsPass[plr] = true
    claimOffline(plr, 2)
end)
 
-- Tandai "terakhir online" tiap 30 detik (biar waktu main gak dihitung offline)
task.spawn(function()
    while true do
        task.wait(30)
        for _, plr in ipairs(Players:GetPlayers()) do
            if DataService.IsLoaded(plr) then
                local sec = offlineSec(plr)
                if sec then
                    sec.LastSeen = os.time()
                end
            end
        end
    end
end)
 
----------------------------------------------------------------
-- ACTIONS DARI CLIENT
----------------------------------------------------------------
ActionEvent.OnServerEvent:Connect(function(plr, action, arg)
    if action == "Drop" then
        dropPet(plr)
    elseif action == "Sync" then
        pushPets(plr)
    elseif action == "Unequip" then
        if type(arg) == "string" then
            unequipPlaced(plr, arg, true)
        end
    elseif action == "Take" then
        if typeof(arg) == "Instance" and arg:GetAttribute("OwnerId") == plr.UserId then
            local id = arg:GetAttribute("PlacedId")
            if type(id) == "string" then
                unequipPlaced(plr, id, true)
            end
        end
    elseif action == "EquipBest" then
        equipBest(plr)
    elseif action == "Place" then
        -- Tap layar pas pegang Pet, mengarah ke Part "Place" (dikirim dari client)
        if typeof(arg) == "Instance" then
            for _, st in pairs(bases) do
                if st.Place == arg then
                    local root = plr.Character and plr.Character:FindFirstChild("HumanoidRootPart")
                    if root and (root.Position - st.Place.Position).Magnitude <= 120 then
                        placeHeldPet(plr, st)
                    end
                    break
                end
            end
        end
    elseif action == "OfflineSync" then
        sendOffline(plr)
    elseif action == "OfflineClaim" then
        claimOffline(plr) -- tombol Claim & Close sama-sama dapat
    elseif action == "OfflineRobux" then
        if ownsPass[plr] then
            claimOffline(plr, 2) -- sudah punya Pass (creator otomatis punya): langsung x2
        else
            MarketplaceService:PromptGamePassPurchase(plr, OFFLINE_PASS_ID)
        end
    end
end)
 
----------------------------------------------------------------
-- PLAYER
----------------------------------------------------------------
local function onPlayerAdded(plr)
    plr:SetAttribute("CarryingPet", false)
    
    plr.CharacterAdded:Connect(function()
        task.wait(0.1)
        giveAllTools(plr)
    end)
    
    plr.CharacterRemoving:Connect(function()
        dropPet(plr)
        armState[plr] = nil
    end)
end
 
Players.PlayerAdded:Connect(onPlayerAdded)
for _, plr in ipairs(Players:GetPlayers()) do
    task.spawn(onPlayerAdded, plr)
end
 
DataService.OnLoaded(function(plr)
    getSec(plr)
    giveAllTools(plr)
    prepareOffline(plr)
    
    for _, st in pairs(bases) do
        if st.Owner.Value == plr.UserId then
            refreshBase(st)
        end
    end
    
    pushPets(plr)
end)
 
Players.PlayerRemoving:Connect(function(plr)
    local off = DataService.Section(plr, "Offline")
    if off then
        off.LastSeen = os.time()
    end
    
    dropPet(plr)
    armState[plr] = nil
    saveDebounce[plr] = nil
    placeDebounce[plr] = nil
    ownsPass[plr] = nil
    ragdolled[plr] = nil
    incomeRemainder[plr] = nil
end)
 
----------------------------------------------------------------
-- INCOME: tiap 1 detik, semua Pet di Base ngasih Sheckles (digabung)
----------------------------------------------------------------
task.spawn(function()
    while true do
        task.wait(1)
        
        for _, plr in ipairs(Players:GetPlayers()) do
            if DataService.IsLoaded(plr) then
                local sec = getSec(plr)
                local sheckles = getSheckles(plr)
                
                if sec and sheckles then
                    local total = 0
                    for _, e in ipairs(sec.Placed) do
                        total += e.Income
                    end
                    
                    -- Boost dari Index (Area yang Complete, diambil yang tertinggi)
                    local exact = total * IndexService.GetBoost(plr) + (incomeRemainder[plr] or 0)
                    local give = math.floor(exact)
                    incomeRemainder[plr] = exact - give
                    
                    if give > 0 then
                        sheckles.Value += give
                        UIEvent:FireClient(plr, "Income", give)
                    end
                end
            end
        end
    end
end)


