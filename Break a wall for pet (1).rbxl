<Item class="LocalScript" referent="RBXCE0869D075DF4A55B454101137AE4BA1">
<Properties>
<BinaryString name="AttributesSerialize"></BinaryString>
<bool name="Disabled">false</bool>
<Content name="LinkedSource"><null></null></Content>
<string name="Name">AutoResponsive</string>
<token name="RunContext">0</token>
<string name="ScriptGuid">{A7A2C6D1-8936-4D8F-A45D-9A2AE9525164}</string>
<ProtectedString name="Source"><![CDATA[
--// AUTO RESPONSIVE GUI
--// Put this LocalScript inside your Frame

local frame = script.Parent
local camera = workspace.CurrentCamera

local BASE_SIZE = camera.ViewportSize

local uiScale = frame:FindFirstChildOfClass("UIScale")

if not uiScale then
    uiScale = Instance.new("UIScale")
    uiScale.Parent = frame
end

local function updateResponsive()
    local viewport = camera.ViewportSize
    
    local scaleX = viewport.X / BASE_SIZE.X
    local scaleY = viewport.Y / BASE_SIZE.Y
    
    local scale = math.min(scaleX, scaleY)
    
    uiScale.Scale = math.clamp(scale, 0.65, 1.2)
end

camera:GetPropertyChangedSignal("ViewportSize"):Connect(updateResponsive)

updateResponsive()

]]></ProtectedString>
<UniqueId name="UniqueId">7bdf20b295fbe64d068940113800437f</UniqueId>
</Properties>
</Item>
