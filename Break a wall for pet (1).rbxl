<ProtectedString name="Source"><![CDATA[-- ModuleScript: ReplicatedStorage > Configuration > Modules > Area > Wall > WallConfig

local Config = {}

-- Nomor = nomor Area (sama kayak di AreaDisplayConfig)
-- HP    = HP tiap Wall di Area itu
Config.Walls = {
[1] = { HP = 50 },
[2] = { HP = 200 },
}

-- Jarak maksimal Wall dari player supaya kena pukulan (studs)
Config.HitRange = 7

-- Lama animasi Wall hilang / muncul lagi (detik)
Config.DestroyTime = 0.35
Config.RespawnTime = 0.5

return Config

]]></ProtectedString>
